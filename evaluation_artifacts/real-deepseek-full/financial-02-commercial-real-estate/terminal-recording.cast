[68.98907, "i", "cat > /workspace/patch2.py <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nout='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(p)\nws=wb['Model']\n\ndef setf(coord, formula):\n    c=ws[coord]\n    if c.value is None and c.data_type != 'f':\n        c.value = formula\n    else:\n        print('skip', coord, repr(c.value))\n\n# Economic values\nsetf('C24', '=C4/C17')\nsetf('C28', '=C24-C27')\n\n# Decision analysis factors\nsetf('H34', '=H67')\nsetf('J35', '=J34/((1+$C$14)^J33)')\nsetf('M35', '=M34/((1+$C$14)^M33)')\n\n# Income statement\nsetf('E42', '=C4')\nsetf('K42', '=J42*(1+$C$7)')\nsetf('H43', '=-(H42*$C$5)')\nsetf('J43', '=-(J42*$C$5)')\nsetf('L43', '=-(L42*$C$5)')\nsetf('G45', '=F45*(1+$C$8)')\nsetf('J45', '=I45*(1+$C$8)')\nsetf('M45', '=L45*(1+$C$8)')\nsetf('G46', '=SUM(G44:G45)')\nsetf('K46', '=SUM(K44:K45)')\nsetf('O46', '=SUM(O44:O45)')\nsetf('G47', '=G74')\nsetf('J47', '=J74')\nsetf('G48', '=F48')  # depreciation constant formula =G48? existing convention: E=(C24*C12)/-C20; F=E; H=G; etc. G=D? Actually need chain from F.\nsetf('"]

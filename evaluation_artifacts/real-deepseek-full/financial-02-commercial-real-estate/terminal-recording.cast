[45.526672, "i", "cat > /workspace/patch.py <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nout='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(p)\nws=wb['Model']\n\ndef setf(coord, formula):\n    c=ws[coord]\n    # We'll only patch blank to preserve values; but allow C25 etc blank.\n    if c.value is None:\n        c.value=formula\n    else:\n        print('skip existing', coord, repr(c.value))\n\n# Economic values\nsetf('C24', '=(C4/C17)')\nsetf('C25', '=C24/1.5')\nsetf('C28', '=C24-C27')\n\n# Decision analysis: row 34 missing H34 (year4 real CF)\nsetf('H34', '=H67')\nsetf('J35', '=J34/((1+$C$14)^J33)')\nsetf('M35', '=M34/((1+$C$14)^M33)')\n\n# Income statement\nsetf('E42', '=C4')\nsetf('K42', '=J42*(1+$C$7)')\nsetf('H43', '=-(H42*$C$5)')\nsetf('J43', '=-(J42*$C$5)')\nsetf('L43', '=-(L42*$C$5)')\n# E45 is existing value, leave. G45/J45/M45 blank expenses links by formula if following pattern\nsetf('G45', '=F45*(1+$C$8)')\nsetf('J45', '=I45*(1+$C$8)')\nsetf('M45', '=L45*(1+$C$8)')\nsetf('G46', '=SUM(G44:G45)')\nsetf('K46', '=SUM(K44:K45)')\nsetf('O46', '"]
[45.527225, "o", "cat > /workspace/patch.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> p='/workspace/input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.527257, "i", "=SUM(O44:O45)')\n# Taxable Income/liability/net income missing H? G? check row49-51\nsetf('G49', '=G46+G47+G48')\nsetf('H49', '=H46+H47+H48')\nsetf('M49', '=M46+M47+M48')\nsetf('K50', '=($C$21*-K49)')\nsetf('N50', '=($C$21*-N49)')\n# Net income missing G,F? M? H/J/A? actually E/F not, G? H? I? J? K? L? M?\nsetf('G51', '=G49+G50')\nsetf('H51', '=H49+H50')\nsetf('K51', '=K49+K50')\nsetf('L51', '=L49+L50')\nsetf('M51', '=M49+M50')\n# Cash flow statements missing links\nsetf('F56', '=F42')\nsetf('G56', '=G42')\nsetf('H56', '=H42')\nsetf('I56', '=I42')\nsetf('K56', '=K42')\nsetf('L57', '=L43')\nsetf('O57', '=O43')\nsetf('G58', '=G44')\nsetf('K58', '=K44')\nsetf('O58', '=O44')\nsetf('H59', '=G59*(1+$C$8)')\nsetf('N59', '=M59*(1+$C$8)')\nsetf('E60', '=SUM(E58:E59)')\nsetf('F60r', '_')\n# Row 60 F60 is existing value; skip. Missing G? already. E60 missing (should formula? no value)\n# Debt service row 61 missing I61/L61 links + preserves F61 constant? maybe F61 should formula but leave constant if not blank.\nsetf('I61', '=H61')\nsetf('L61', '=K61"]
[45.527263, "o", "out='/workspace/output.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.527268, "i", "')\n# Total cash flow missing I65/J65\nsetf('I65', '=SUM(I63:I64)')\nsetf('J65', '=SUM(J63:J64)')\n# Purchasing power adjustment missing E66,G66\nsetf('E66', '=(1+$C$13)^E55')\nsetf('G66', '=(1+$C$13)^G55')\n# Real cash flow missing M67\nsetf('M67', '=M65/M66')\n# Mortgage schedule\nsetf('D72', '=C27')\nsetf('E72', '=D76')\nsetf('N72', '=M76')\nsetf('O72', '=N76')\nsetf('I74', '=$C$10*-I72')\nsetf('K74', '=$C$10*-K72')\nsetf('L74', '=$C$10*-L72')\nsetf('H75', '=H73+H74')\nsetf('K75', '=K73+K74')\nsetf('L75', '=L73+L74')\n# Reversion on sale\nsetf('E82', '=E80/E81')\nsetf('E85', '=C24-((C24*C12)/C20)*10')\nsetf('E87', '=-C22*E86')\n\nwb.save(out)\nprint('saved', out)\nPY\npython3 /workspace/patch.py\n"]
[45.529575, "o", "wb=openpyxl.load_workbook(p)\r\n\u001b[?2004l\r')\r\n# Total cash flow missing I65/J65\r\nsetf('I65', '=SUM(I63:I64)')\r\nsetf('J65', '=SUM(J63:J64)')\r\n# Purchasing power adjustment missing E66,G66\r\nsetf('E66', '=(1+$C$13)^E55')\r\nsetf('G66', '=(1+$C$13)^G55')\r\n# Real cash flow missing M67\r\nsetf('M67', '=M65/M66')\r\n# Mortgage schedule\r\nsetf('D72', '=C27')\r\nsetf('E72', '=D76')\r\nsetf('N72', '=M76')\r\nsetf('O72', '=N76')\r\nsetf('I74', '=$C$10*-I72')\r\nsetf('K74', '=$C$10*-K72')\r\nsetf('L74', '=$C$10*-L72')\r\nsetf('H75', '=H73+H74')\r\nsetf('K75', '=K73+K74')\r\nsetf('L75', '=L73+L74')\r\n# Reversion on sale\r\nsetf('E82', '=E80/E81')\r\nsetf('E85', '=C24-((C24*C12)/C20)*10')\r\nsetf('E87', '=-C22*E86')\r\n\r\nwb.save(out)\r\nprint('saved', out)\r\nPY\r\npython3 /workspace/patch.py\r\n\u001b[?2004h> ws=wb['Model']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def setf(coord, formula):\r\n\u001b[?2004l\r\u001b[?2004h>     c=ws[coord]\r\n\u001b[?2004l\r\u001b[?2004h>     # We'll only patch blank to preserve values; but allow C25 etc blank."]
[45.530085, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     if c.value is None:\r\n\u001b[?2004l\r\u001b[?2004h>         c.value=formula\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         print('skip existing', coord, repr(c.value))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Economic values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.530115, "o", "setf('C24', '=(C4/C17)')\r\n\u001b[?2004l\r\u001b[?2004h> setf('C25', '=C24/1.5')\r\n\u001b[?2004l\r\u001b[?2004h> setf('C28', '=C24-C27')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]

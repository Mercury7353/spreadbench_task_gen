[57.273575, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx')\nws=wb['Model']\nsections=[(40,41,67),(70,71,76),(79,82,89)]\nfor r0,r1,r2 in sections:\n    print('\\nRows',r0,'-',r2)\n    for r in range(r1,r2+1):\n        cells=[]\n        for col in ['D','E','F','G','H','I','J','K','L','M','N','O']:\n            c=ws[col+str(r)]\n            if c.value is None:\n                cells.append(col+':BLANK')\n            else:\n                cells.append(f\"{col}:{('F' if c.data_type=='f' else 'V')}\")\n        print(f'{r:3}', ' '.join(cells))\nprint('\\nEconomic blanks')\nfor coord in ['C24','C25','C27','C28','C29']:\n    c=ws[coord]\n    print(coord, c.value, c.data_type)\nPY\n"]

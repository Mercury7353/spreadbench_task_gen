[75.437026, "i", "libreoffice --headless --convert-to xlsx --outdir /workspace/recalc /workspace/output.xlsx >/tmp/recalc.log 2>&1 || true\ncat /tmp/recalc.log\npython3 - <<'PY'\nimport openpyxl, os, glob\np='/workspace/recalc/output.xlsx'\nif not os.path.exists(p):\n    print('No recalc file')\nelse:\n    wbf=openpyxl.load_workbook(p, data_only=True)\n    ws=wbf['Model']\n    errs=[]\n    for row in ws.iter_rows(min_row=1, max_row=101):\n        for c in row:\n            if isinstance(c.value, str) and c.value.startswith('#'):\n                errs.append(c.coordinate+':'+c.value)\n    print('errors:', errs[:50])\n    for coord in ['C24','C27','C28','C29','C37','C38','E42','K42','H43','J43','L43','G45','J45','M45','G46','K46','O46','G47','J47','G48','H49','M49','K50','N50','F51','G51','M51','F56','G56','H56','I56','K56','L57','G58','K58','O58','H59','N59','E60','I61','L61','H34','J35','M35','I65','J65','E66','G66','M67','D72','E72','N72','O72','N73','O73','I74','K74','L74','G75','H75','K75','L75','E82','E85','E86','E87','E89','E88','E84']:\n"]

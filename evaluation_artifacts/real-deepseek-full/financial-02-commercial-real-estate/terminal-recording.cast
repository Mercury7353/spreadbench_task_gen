[159.468551, "i", "cat > /workspace/patch3.py <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nout='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(p)\nws=wb['Model']\n\ndef setf(coord, formula):\n    c=ws[coord]\n    if c.value is None:\n        c.value = formula\n    else:\n        print('skip existing', coord, repr(c.value))\n\n# Economic values\n# Purchase cap rate should capitalize first-year NOI: gross rent less vacancy/expenses divided by cap rate.\nsetf('C24', '=(C4*(1-C5)-C6)/C17')\nsetf('C28', '=C24-C27')\n\n# Decision analysis factors\nsetf('H34', '=H67')\nsetf('J35', '=J34/((1+$C$14)^J33)')\nsetf('M35', '=M34/((1+$C$14)^M33)')\n\n# Income statement\nsetf('E42', '=C4')\nsetf('K42', '=J42*(1+$C$7)')\nsetf('H43', '=-(H42*$C$5)')\nsetf('J43', '=-(J42*$C$5)')\nsetf('L43', '=-(L42*$C$5)')\nsetf('G45', '=F45*(1+$C$8)')\nsetf('J45', '=I45*(1+$C$8)')\nsetf('M45', '=L45*(1+$C$8)')\nsetf('G46', '=SUM(G44:G45)')\nsetf('K46', '=SUM(K44:K45)')\nsetf('O46', '=SUM(O44:O45)')\nsetf('G47', '=G74')\nsetf('J47', '=J74')\nsetf('G48', '=F48')\nsetf('H49', '=H46+H47+H48'"]
[159.469288, "o", "cat > /workspace/patch3.py <<'PY'\r\n\u001b[?2004l\r"]
[159.469307, "i", ")\nsetf('M49', '=M46+M47+M48')\nsetf('K50', '=($C$21*-K49)')\nsetf('N50', '=($C$21*-N49)')\nsetf('F51', '=F49+F50')\nsetf('G51', '=G49+G50')\nsetf('M51', '=M49+M50')\n\n# Cash flow statement\nsetf('F56', '=F42')\nsetf('G56', '=G42')\nsetf('H56', '=H42')\nsetf('I56', '=I42')\nsetf('K56', '=K42')\nsetf('L57', '=L43')\nsetf('G58', '=G44')\nsetf('K58', '=K44')\nsetf('O58', '=O44')\nsetf('H59', '=G59*(1+$C$8)')\nsetf('N59', '=M59*(1+$C$8)')\nsetf('E60', '=SUM(E58:E59)')\nsetf('I61', '=H61')\nsetf('L61', '=K61')\nsetf('I65', '=SUM(I63:I64)')\nsetf('J65', '=SUM(J63:J64)')\nsetf('E66', '=(1+$C$13)^E55')\nsetf('G66', '=(1+$C$13)^G55')\nsetf('M67', '=M65/M66')\n\n# Mortgage schedule\nsetf('D72', '=C27')\nsetf('E72', '=D72')\nsetf('N72', '=M76')\nsetf('O72', '=N76')\nsetf('N73', '=M73')\nsetf('O73', '=N73')\nsetf('I74', '=$C$10*-I72')\nsetf('K74', '=$C$10*-K72')\nsetf('L74', '=$C$10*-L72')\nsetf('G75', '=G73+G74')\nsetf('H75', '=H73+H74')\nsetf('K75', '=K73+K74')\nsetf('L75', '=L73+L74')\n\n# Reversion on sale\nsetf('E82', '=E80/E81')\nsetf('E85', '=C24-((C24*C12)/"]
[159.470114, "o", "\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> p='/workspace/input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> out='/workspace/output.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(p)\r\n\u001b[?2004l\r\u001b[?2004h> ws=wb['Model']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def setf(coord, formula):\r\n\u001b[?2004l\r\u001b[?2004h>     c=ws[coord]\r\n\u001b[?2004l\r\u001b[?2004h>     if c.value is None:\r\n\u001b[?2004l\r\u001b[?2004h>         c.value = formula\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         print('skip existing', coord, repr(c.value))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Economic values\r\n\u001b[?2004l\r\u001b[?2004h> # Purchase cap rate should capitalize first-year NOI: gross rent less vacancy/expenses divided by cap rate.\r\n\u001b[?2004l\r\u001b[?2004h> setf('C24', '=(C4*(1-C5)-C6)/C17')\r\n\u001b[?2004l\r\u001b[?2004h> setf('C28', '=C24-C27')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Decision analysis factors\r\n\u001b[?2004l\r\u001b[?2004h> setf('H34', '=H67')\r\n\u001b[?2004l\r\u001b[?2004h> "]

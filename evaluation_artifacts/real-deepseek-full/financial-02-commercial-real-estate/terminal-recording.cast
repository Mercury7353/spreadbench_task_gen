[170.623487, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(p)\nws=wb['Model']\nprint('sheets', wb.sheetnames)\nprint('dims', ws.dimensions)\nprint('\\nKey formulas patched:')\nfor coord in ['C24','C28','H34','J35','M35','E42','K42','H43','J43','L43','G45','J45','M45','G46','K46','O46','G47','J47','G48','H49','M49','K50','F51','G51','M51','F56','G56','H56','I56','K56','L57','G58','K58','O58','H59','N59','E60','I61','L61','I65','J65','E66','G66','M67','D72','E72','N72','O72','N73','O73','I74','K74','L74','G75','H75','K75','L75','E82','E85','E87']:\n    c=ws[coord]\n    print(coord, c.value)\nprint('\\nBlank formula cells remaining in main blocks:')\nblanks=[]\nfor r in list(range(24,30))+list(range(34,39))+list(range(42,68))+list(range(72,77))+list(range(82,90)):\n    for c in ws[r]:\n        if c.value is None and c.column_letter in 'CDEFGHIJKLMNO':\n            blanks.append(c.coordinate)\nprint(blanks[:200])\nPY\n"]

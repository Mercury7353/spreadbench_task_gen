[30.006034, "i", "which libreoffice soffice localc python3\npython3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nws=wb['Model']\nprint('selected cells format/value/style:')\nfor c in ['C4','E42','E45','F45','E46','F60','E61','D64','E82','E83','E84','E85','E86','E87','E88','E89','D175','D266']:\n    x=ws[c]\n    print(c, repr(x.value), x.number_format, x.data_type, x.alignment.horizontal, x.border.left.style, x.fill.fgColor.rgb if x.fill and x.fill.patternType else None)\nprint('row heights/col widths first few')\nfor r in [1,20,33,80,82,174]: print('row',r, ws.row_dimensions[r].height, 'hidden', ws.row_dimensions[r].hidden)\nfor col in ['B','C','D','E','N','O']: print('col',col, ws.column_dimensions[col].width, 'hidden', ws.column_dimensions[col].hidden)\nPY\n"]

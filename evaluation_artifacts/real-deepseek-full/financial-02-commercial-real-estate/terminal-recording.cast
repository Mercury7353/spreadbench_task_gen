[22.411894, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p, data_only=False)\nws=wb['Model']\nwith open('/workspace/dump.txt','w') as f:\n    for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\n        vals=[]\n        for c in row:\n            if c.value is not None:\n                vals.append(f'{c.coordinate}:{c.data_type}:{c.value}')\n        if vals:\n            f.write(f'{row[0].row}: {\" | \".join(vals)}\\n')\nPY\nsed -n '20,90p' /workspace/dump.txt\n"]
[22.413281, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> p='/workspace/input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(p, data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> ws=wb['Model']\r\n\u001b[?2004l\r\u001b[?2004h> with open('/workspace/dump.txt','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\r\n\u001b[?2004l\r\u001b[?2004h>         vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for c in row:\r\n\u001b[?2004l\r\u001b[?2004h>             if c.value is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 vals.append(f'{c.coordinate}:{c.data_type}:{c.value}')\r\n\u001b[?2004l\r\u001b[?2004h>         if vals:\r\n\u001b[?2004l\r\u001b[?2004h>             f.write(f'{row[0].row}: {\" | \".join(vals)}\\n')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

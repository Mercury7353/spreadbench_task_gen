[52.208782, "i", "python3 - <<'PY'\nimport openpyxl\nws=openpyxl.load_workbook('/workspace/input.xlsx').active\nsections=[(40,42,67),(70,71,76),(79,82,89)]\nfor r0,r1,r2 in sections:\n    print('\\nRows',r0,'-' ,r2)\n    for r in range(r1,r2+1):\n        cells=[]\n        for col in ['D','E','F','G','H','I','J','K','L','M','N','O']:\n            c=ws[col+str(r)]\n            if c.value is None:\n                cells.append(col+':BLANK')\n            else:\n                cells.append(f\"{col}:{('F' if c.data_type=='f' else 'V')}\")\n        print(f'{r:3}', ' '.join(cells))\nprint('Also economic blanks')\nfor row in range(24,30):\n    print(row, [(c.coordinate, c.value) for c in ws[row] if c.coordinate[0] in ['C','D'] and c.coordinate[1:]==str(row)])\nPY\n"]
[52.209304, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> ws=openpyxl.load_workbook('/workspace/input.xlsx').active\r\n\u001b[?2004l\r\u001b[?2004h> "]

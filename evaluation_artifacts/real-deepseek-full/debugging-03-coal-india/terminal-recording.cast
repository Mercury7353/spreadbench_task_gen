[110.632739, "i", "python3 - <<'PY'\nimport openpyxl, re\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\ncoords=re.compile(r'([A-Z]{1,2}[0-9]+|\\$?[A-Z]{1,2}\\$?[0-9]+|\\$?[A-Z]{1,2}|\\$?[0-9]+)')\n# simpler canonical: replace cell refs with X, numbers with N, keep operators\nad=re.compile(r'([A-Z]{1,3}\\$?[0-9]+|\\$?[A-Z]{1,3}\\$?[0-9]+|\\$?[A-Z]{1,3}|\\$?[0-9]+)')\nfor ws in wb.worksheets:\n    rows=[]\n    for row in ws.iter_rows():\n        fs=[c for c in row if isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE')]\n        if len(fs)<2: continue\n        pats={}\n        for c in fs:\n            t=ad.sub('R', c.value[1:])\n            pats.setdefault(t,[]).append(c.coordinate)\n        if len(pats)>1:\n            R=row[0].row\n            rows.append((ws.title,R,fs,pats))\n    if rows:\n        print('\\n==== Variability', ws.title, '====')\n        for title,R,fs,pats in rows:\n            print(f'Row {R}: patterns={len(pats)}')\n            # print each formula with its canonical\n            f"]
[110.633419, "i", "or c in fs:\n                t=ad.sub('R', c.value[1:])\n                print(f'  {c.coordinate}: {c.value}')\n            print()\nPY\n"]
[110.633457, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl, re\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> coords=re.compile(r'([A-Z]{1,2}[0-9]+|\\$?[A-Z]{1,2}\\$?[0-9]+|\\$?[A-Z]{1,2}|\\$?[0-9]+)')\r\n\u001b[?2004l\r\u001b[?2004h> # simpler canonical: replace cell refs with X, numbers with N, keep operators\r\n\u001b[?2004l\ror c in fs:\r\n                t=ad.sub('R', c.value[1:])\r\n                print(f'  {c.coordinate}: {c.value}')\r\n            print()\r\nPY\r\n\u001b[?2004h> "]
[110.63363, "o", "ad=re.compile(r'([A-Z]{1,3}\\$?[0-9]+|\\$?[A-Z]{1,3}\\$?[0-9]+|\\$?[A-Z]{1,3}|\\$?[0-9]+)')\r\n"]
[110.634997, "o", "\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     rows=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h>         fs=[c for c in row if isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE')]\r\n\u001b[?2004l\r\u001b[?2004h>         if len(fs)<2: continue\r\n\u001b[?2004l\r\u001b[?2004h>         pats={}\r\n\u001b[?2004l\r\u001b[?2004h>         for c in fs:\r\n\u001b[?2004l\r\u001b[?2004h>             t=ad.sub('R', c.value[1:])\r\n\u001b[?2004l\r\u001b[?2004h>             pats.setdefault(t,[]).append(c.coordinate)\r\n\u001b[?2004l\r\u001b[?2004h>         if len(pats)>1:\r\n\u001b[?2004l\r\u001b[?2004h>             R=row[0].row\r\n\u001b[?2004l\r\u001b[?2004h>             rows.append((ws.title,R,fs,pats))\r\n\u001b[?2004l\r\u001b[?2004h>     if rows:\r\n\u001b[?2004l\r\u001b[?2004h>         print('\\n==== Variability', ws.title, '====')\r\n\u001b[?2004l\r\u001b[?2004h>         for title,R,fs,pats in rows:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f'Row {R}: patterns={len(pats)}')\r\n\u001b[?2004l\r\u001b[?2004h>             # print each formula with its canonical\r\n\u001b[?2004l\r\u001b[?2004h>             "]
[110.635022, "o", "for c in fs:\r\n\u001b[?2004l\r\u001b[?2004h>                 t=ad.sub('R', c.value[1:])\r\n\u001b[?2004l\r\u001b[?2004h>                 print(f'  {c.coordinate}: {c.value}')\r\n\u001b[?2004l\r\u001b[?2004h>             print()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[110.747076, "o", "\r\n==== Variability Assumptions ====\r\nRow 7: patterns=2\r\n  G7: ='P&L'!G7/'P&L'!F7-1\r\n  H7: ='P&L'!H7/'P&L'!G7-1\r\n  I7: ='P&L'!I7/'P&L'!H7-1\r\n  J7: ='P&L'!J7/'P&L'!I7-1\r\n  K7: =IF($E7=\"CAGR\",AVERAGE(G7:J7),K6/100)\r\n  L7: =IF($E7=\"CAGR\",AVERAGE(H7:K7),L6/100)\r\n  M7: =IF($E7=\"CAGR\",AVERAGE(I7:L7),M6/100)\r\n  N7: =IF($E7=\"CAGR\",AVERAGE(J7:M7),N6/100)\r\n  O7: =IF($E7=\"CAGR\",AVERAGE(K7:N7),O6/100)\r\n\r\nRow 10: patterns=2\r\n  G10: ='P&L'!G10/'P&L'!F10-1\r\n  H10: ='P&L'!H10/'P&L'!G10-1\r\n"]
[110.747116, "o", "  I10: ='P&L'!I10/'P&L'!H10-1\r\n  J10: ='P&L'!J10/'P&L'!I10-1\r\n  K10: =IF($E10=\"CAGR\",AVERAGE(G10:J10),K9/100)\r\n  L10: =IF($E10=\"CAGR\",AVERAGE(H10:K10),L9/100)\r\n  M10: =IF($E10=\"CAGR\",AVERAGE(I10:L10),M9/100)\r\n  N10: =IF($E10=\"CAGR\",AVERAGE(J10:M10),N9/100)\r\n  O10: =IF($E10=\"CAGR\",AVERAGE(K10:N10),O9/100)\r\n\r\nRow 13: patterns=2\r\n  G13: ='P&L'!G14/'P&L'!F14-1\r\n"]
[110.747211, "o", "  H13: ='P&L'!H14/'P&L'!G14-1\r\n  I13: ='P&L'!I14/'P&L'!H14-1\r\n  J13: ='P&L'!J14/'P&L'!I14-1\r\n  K13: =IF($E13=\"CAGR\",AVERAGE(G13:J13),K12/100)\r\n  L13: =IF($E13=\"CAGR\",AVERAGE(H13:K13),L12/100)\r\n  M13: =IF($E13=\"CAGR\",AVERAGE(I13:L13),M12/100)\r\n  N13: =IF($E13=\"CAGR\",AVERAGE(J13:M13),N12/100)\r\n  O13: =IF($E13=\"CAGR\",AVERAGE(K13:N13),O12/100)\r\n\r\nRow 16: patterns=2\r\n  G16: ='P&L'!G15/'P&L'!G7\r\n  H16: ='P&L'!H15/'P&L'!H7\r\n  I16: ='P&L'!I15/'P&L'!I7\r\n  J16: ='P&L'!J15/'P&L'!J7\r\n  K16: =IF($E16=\"CAGR\",AVERAGE(G16:J16),K15/100)\r\n  L16: =IF($E16=\"CAGR\",AVERAGE(H16:K16),L15/100)\r\n  M16: =IF($E16=\"CAGR\",AVERAGE(I16:L16),M15/100)\r\n  N16: =IF($E16=\"CAGR\",AVERAGE(J16:M16),N15/100)\r\n"]
[110.747235, "o", "  O16: =IF($E16=\"CAGR\",AVERAGE(K16:N16),O15/100)\r\n\r\nRow 19: patterns=2\r\n  G19: ='P&L'!G16/'P&L'!F16-1\r\n  H19: ='P&L'!H16/'P&L'!G16-1\r\n"]
[110.747244, "o", "  I19: ='P&L'!I16/'P&L'!H16-1\r\n  J19: ='P&L'!J16/'P&L'!I16-1\r\n  K19: =IF($E19=\"CAGR\",AVERAGE(G19:J19),K18/100)\r\n  L19: =IF($E19=\"CAGR\",AVERAGE(H19:K19),L18/100)\r\n"]
[110.747271, "o", "  M19: =IF($E19=\"CAGR\",AVERAGE(I19:L19),M18/100)\r\n  N19: =IF($E19=\"CAGR\",AVERAGE(J19:M19),N18/100)\r\n  O19: =IF($E19=\"CAGR\",AVERAGE(K19:N19),O18/100)\r\n\r\nRow 22: patterns=2\r\n"]

[43.045912, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nwv=openpyxl.load_workbook('/workspace/input.xlsx', data_only=True)\nfor ws in wb.worksheets:\n    print('\\n========', ws.title, ws.dimensions, '========')\n    vws=wv[ws.title]\n    # collect formulas only\n    prev_rowlabel=None\n    for row in ws.iter_rows():\n        formulas=[]\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE'):\n                formulas.append((c.coordinate, c.value))\n        if formulas:\n            print(f'Row {row[0].row}:', '; '.join(f'{coord}:{formula}' for coord, formula in formulas))\nPY\n"]

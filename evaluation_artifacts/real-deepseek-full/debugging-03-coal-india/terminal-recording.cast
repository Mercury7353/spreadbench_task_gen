[122.222266, "o", "\r\n==== Variability Cover ====\r\n\r\n==== Variability ReadMeFirst ====\r\n\r\n==== Variability Disclaimer ====\r\n\r\n==== Variability Assumptions ====\r\nRow 7 patterns=2\r\n  G7: ='P&L'!G7/'P&L'!F7-1\r\n  H7: ='P&L'!H7/'P&L'!G7-1\r\n  I7: ='P&L'!I7/'P&L'!H7-1\r\n  J7: ='P&L'!J7/'P&L'!I7-1\r\n  K7: =IF($E7=\"CAGR\",AVERAGE(G7:J7),K6/100)\r\n  L7: =IF($E7=\"CAGR\",AVERAGE(H7:K7),L6/100)\r\n  M7: =IF($E7=\"CAGR\",AVERAGE(I7:L7),M6/100)\r\n  N7: =IF($E7=\"CAGR\",AVERAGE(J7:M7),N6/100)\r\n  O7: =IF($E7=\"CAGR\",AVERAGE(K7:N7),O6/100)\r\nRow 10 patterns=2\r\n  G10: ='P&L'!G10/'P&L'!F10-1\r\n  H10: ='P&L'!H10/'P&L'!G10-1\r\n  I10: ='P&L'!I10/'P&L'!H10-1\r\n  J10: ='P&L'!J10/'P&L'!I10-1\r\n  K10: =IF($E10=\"CAGR\",AVERAGE(G10:J10),K9/100)"]

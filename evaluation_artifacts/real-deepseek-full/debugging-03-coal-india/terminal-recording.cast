[110.748105, "o", "Row 69: patterns=2\r\n  G69: =BS!F33/BS!F7\r\n  H69: =BS!G33/BS!G7\r\n  I69: =BS!H33/BS!H7\r\n  J69: =BS!I33/BS!I7\r\n  K69: =IF($E69=\"CAGR\",AVERAGE(G69:J69),K68/100)\r\n  L69: =IF($E69=\"CAGR\",AVERAGE(H69:K69),L68/100)\r\n  M69: =IF($E69=\"CAGR\",AVERAGE(I69:L69),M68/100)\r\n  N69: =IF($E69=\"CAGR\",AVERAGE(J69:M69),N68/100)\r\n  O69: =IF($E69=\"CAGR\",AVERAGE(K69:N69),O68/100)\r\n\r\n"]
[110.74965, "o", "\r\n==== Variability P&L ====\r\nRow 22: patterns=2\r\n  G22: =1+('Debt Schedule'!G20)\r\n  H22: ='Debt Schedule'!H20"]
[110.749711, "o", "\r\n  I22: ='Debt Schedule'!I20\r\n  J22: ='Debt Schedule'!J20\r\n  K22: ='Debt Schedule'!K20\r\n  L22: ='Debt Schedule'!L20\r\n  M22: ='Debt Schedule'!M20\r\n  N22: ='Debt Schedule'!N20\r\n  O22: ='Debt Schedule'!O20\r\n\r\nRow 27: patterns=2\r\n  K27: =Assumptions!K46*BS!K9\r\n  L27: =Assumptions!L46*BS!L9\r\n  M27: =Assumptions!M46*BS!M9\r\n  N27: =1+(Assumptions!N46*BS!N9)\r\n"]
[110.749717, "o", "  O27: =Assumptions!O46*BS!O9\r\n\r\nRow 42: patterns=2\r\n  F42: =-1*(F40+F41)\r\n"]
[110.749768, "o", "  G42: =G40+G41\r\n  H42: =H40+H41\r\n  I42: =I40+I41\r\n  J42: =J40+J41\r\n  K42: =K40+K41\r\n  L42: =L40+L41\r\n  M42: =M40+M41\r\n  N42: =N40+N41\r\n  O42: =O40+O41\r\n\r\nRow 60: patterns=3\r\n  K60: =-1*(J60/J56*K56)\r\n  L60: =1+(K60/K56*L56)\r\n  M60: =L60/L56*M56\r\n  N60: =M60/M56*N56\r\n  O60: =N60/N56*O56\r\n\r\n"]
[110.752108, "o", "\r\n==== Variability CF ====\r\nRow 10: patterns=2\r\n  G10: =BS!G13-BS!F13\r\n  H10: =BS!H13-BS!G13\r\n  I10: =1+(BS!I13-BS!H13)\r\n  J10: =BS!J13-BS!I13\r\n  K10: =BS!K13-BS!J13\r\n  L10: =BS!L13-BS!K13\r\n  M10: =BS!M13-BS!L13\r\n  N10: =BS!N13-BS!M13\r\n  O10: =BS!O13-BS!N13"]
[110.752121, "o", "\r\n\r\nRow 15: patterns=3\r\n  G15: =BS!G31-BS!F31\r\n  H15: =BS!H31-BS!G31\r\n"]

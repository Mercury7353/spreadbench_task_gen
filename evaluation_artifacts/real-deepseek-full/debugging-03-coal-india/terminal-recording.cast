[7.465391, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nprint(wb.sheetnames)\nfor ws in wb.worksheets:\n    print('\\nSHEET', ws.title, 'dims', ws.dimensions, 'max_row', ws.max_row, 'max_col', ws.max_column)\n    for row in ws.iter_rows():\n        for cell in row:\n            if cell.value is not None:\n                print(cell.coordinate, repr(cell.value), 'formula?', cell.data_type)\nPY\n"]

[215.617063, "i", "python3 - <<'PY'\nimport openpyxl, re\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nref=re.compile(r\"'?([A-Za-z ]+)'?!\\$?([A-Z]{1,3})\\$?([0-9]{1,3})|(?<![A-Za-z])!?\\$?([A-Z]{1,3})\\$?([0-9]{1,3})\")\n# Simplify: match any sheet-qualified refs or simple refs\npat = re.compile(r\"'(?P<sheet>[^']+)'!\\$?(?P<col>[A-Z]{1,3})\\$?(?P<row>[0-9]+)|(?<![A-Za-z$])\\$?(?P<col2>[A-Z]{1,3})\\$?(?P<row2>[0-9]+)\")\nfor ws in wb.worksheets:\n    flags=[]\n    for row in ws.iter_rows():\n        fs=[c for c in row if 6 <= c.column <= 15 and isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE')]\n        if len(fs)<5: continue\n        # build per referenced row pattern: for each formula, get refs (sheet,row)\n        refs_by_cell=[]\n        for c in fs:\n            refs=[]\n            for m in pat.finditer(c.value):\n                sheet=m.group('sheet') if m.group('sheet') else ws.title\n                col=m.group('col') or m.group('col2'); r=int(m.group('row') or m.group('row2'))\n     "]
[215.617612, "o", "python3 - <<'PY'\r\n"]
[215.617754, "i", "           refs.append((sheet,r))\n            refs_by_cell.append((c,refs))\n        # for each ref key column offset? Just flag if row number for same sheet changes non-monotonically? Use adjacent expected: for majority rows, row of same sheet should maybe be same or increase by year index.\n        # simpler: compare each cell to predecessor and successor of same sheet refs by position and row: flag if current row differs across cells in non-linear way.\n        # Count most common 'delta sequence': maybe too much.\n        # For each reference position count (sheet), rows across years; expected linear +/-1 if reference row changes with annual column; flag if row number deviates by not same as delta from majority.\n        # Do a basic: For each ref index, get row values by column index. Compute median of deltas between consecutive col values for sheet refs. Flag adjacent column where delta differs from median but neighboring delta same?\n        for sheet in set(s for _,refs in refs_by_cell for s,_ in refs):\n   "]
[215.619148, "o", "\u001b[?2004l\r\u001b[?2004h> import openpyxl, re\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> ref=re.compile(r\"'?([A-Za-z ]+)'?!\\$?([A-Z]{1,3})\\$?([0-9]{1,3})|(?<![A-Za-z])!?\\$?([A-Z]{1,3})\\$?([0-9]{1,3})\")\r\n\u001b[?2004l\r\u001b[?2004h> # Simplify: match any sheet-qualified refs or simple refs\r\n\u001b[?2004l\r\u001b[?2004h> pat = re.compile(r\"'(?P<sheet>[^']+)'!\\$?(?P<col>[A-Z]{1,3})\\$?(?P<row>[0-9]+)|(?<![A-Za-z$])\\$?(?P<col2>[A-Z]{1,3})\\$?(?P<row2>[0-9]+)\")\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     flags=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h>         fs=[c for c in row if 6 <= c.column <= 15 and isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE')]\r\n\u001b[?2004l\r\u001b[?2004h>         if len(fs)<5: continue\r\n\u001b[?2004l\r\u001b[?2004h>         # build per referenced row pattern: for each formula, get refs (sheet,row)\r\n\u001b[?2004l\r\u001b[?2004h>         refs_by_cell=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for c in "]
[215.619208, "i", "         vals=[]\n            for c,refs in refs_by_cell:\n                rs=[r for s,r in refs if s==sheet]\n                vals.append((c.coordinate, c.column, rs))\n            # for each position in rs list\n            if not vals: continue\n            maxlen=max(len(v[2]) for v in vals)\n            for pos in range(maxlen):\n                seq=[]\n                for coord,col,rs in vals:\n                    if pos < len(rs): seq.append((col,rs[pos],coord))\n                if len(seq)<5: continue\n                # expected delta = majority first diff of row numbers across annual columns\n                deltas=[]\n                for i in range(len(seq)-1):\n                    if seq[i][1] is not None and seq[i+1][1] is not None:\n                        deltas.append(seq[i+1][1]-seq[i][1])\n                if not deltas: continue\n                majority=max(set(deltas), key=deltas.count) if deltas else None\n                # flag transitions where delta != majority\n                for i in range(len(seq)-1):\n"]
[215.619219, "o", "fs:\r\n\u001b[?2004l\r\u001b[?2004h>             refs=[]\r\n\u001b[?2004l\r\u001b[?2004h>             for m in pat.finditer(c.value):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.619281, "i", "                    if seq[i][0]+1 != seq[i+1][0]: continue\n                    d=seq[i+1][1]-seq[i][1]\n                    if d != majority:\n                        flags.append((ws.title, seq[i][2], seq[i+1][2], 'delta', d, 'expected', majority))\n    if flags:\n        print('\\n', ws.title)\n        for f in flags[:200]:\n            print(f)\nPY\n"]
[215.619293, "o", "                sheet=m.group('sheet') if m.group('sheet') else ws.title\r\n\u001b[?2004l\r\u001b[?2004h"]

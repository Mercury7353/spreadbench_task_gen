[293.24884, "i", "python3 - <<'PY'\nimport openpyxl\npath='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(path)\nold=wb['Valuation']['W35'].value\nprint('OLD W35:', old)\nwb['Valuation']['W35'] = '=TABLE($L$34,$F$8,$L35,$F$5,W$34)'\nprint('NEW W35:', wb['Valuation']['W35'].value)\nwb.save(path)\nprint('saved')\nPY\npython3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/output.xlsx', data_only=False)\nbad=[]\nfor ws in wb.worksheets:\n    for row in ws.iter_rows():\n        for c in row:\n            v=c.value\n            if isinstance(v,str) and v.startswith('='):\n                if v.startswith('=1+(') or v.startswith('=-1*(') or v.startswith('=1+') or v.startswith('=-1'):\n                    bad.append((ws.title, c.coordinate, v))\nprint('remaining suspicious:', bad)\nPY\n"]

[92.042572, "i", "python3 - <<'PY'\nimport openpyxl\nf='/workspace/input.xlsx'\ng='/workspace/calculated.xlsx'\nwb=openpyxl.load_workbook(f, data_only=False)\nwv=openpyxl.load_workbook(g, data_only=True)\nfor sheet,rng in [('BS',(5,55)),('CF',(5,55))]:\n    print('\\n========', sheet, '========')\n    ws=wb[sheet]; vws=wv[sheet]\n    for r in range(*rng):\n        cells=[]\n        for c in ws[r]:\n            if c.value is not None:\n                val=c.value\n                if isinstance(val,str) and val.startswith('='):\n                    cells.append(f'{c.coordinate}:{val} => {vws[c.coordinate].value}')\n                else:\n                    cells.append(f'{c.coordinate}:{val}')\n        if cells:\n            print(r, ' | '.join(cells))\nPY\n"]

[62.783691, "o", "\r\n   K14 =K11+K12+K13\r\n   L14 =L11+L12+L13\r\n   M14 =M11+M12+M13"]
[62.783717, "o", "\r\n   N14 =N11+N12+N13\r\n   O14 =O11+O12+O13\r\n"]
[62.783782, "o", "R16 [Investments]:\r\n   K16 =J16\r\n   L16 =K16\r\n   M16 =L16\r\n   N16 =M16\r\n   O16 =N16\r\nR18 [Deffered tax Assets]:\r\n   K18 =J18\r\n   L18 =K18\r\n   M18 =L18\r\n   N18 =M18\r\n   O18 =N18\r\nR20 [Inventories]:\r\n   K20 =2*Assumptions!K60*('P&L'!K14+'P&L'!K15)/365-BS!J20\r\n   L20 =2*Assumptions!L60*('P&L'!L14+'P&L'!L15)/365-BS!K20\r\n   M20 =2*Assumptions!M60*('P&L'!M14+'P&L'!M15)/365-BS!L20\r\n   N20 =2*Assumptions!N60*('P&L'!N14+'P&L'!N15)/365-BS!M20\r\n   O20 =2*Assumptions!O60*('P&L'!O14+'P&L'!O15)/365-BS!N20\r\n"]
[62.783789, "o", "R21 [Sundry Debtors]:\r\n   K21 =Assumptions!K57*K7\r\n   L21 =Assumptions!L57*L7\r\n   M21 =Assumptions!M57*M7\r\n"]
[62.783851, "o", "   N21 =Assumptions!N57*N7\r\n   O21 =Assumptions!O57*O7\r\nR22 [Cash & Bank Balances]:\r\n   K22 =CF!K39+J22\r\n   L22 =CF!L39+K22\r\n   M22 =CF!M39+L22\r\n   N22 =CF!N39+M22\r\n"]
[62.783858, "o", "   O22 =CF!O39+N22\r\nR23 [loans & Advances]:\r\n   K23 =J23*(1+Assumptions!K63)\r\n   L23 =K23*(1+Assumptions!L63)\r\n   M23 =L23*(1+Assumptions!M63)\r\n   N23 =M23*(1+Assumptions!N63)\r\n   O23 =N23*(1+Assumptions!O63)\r\n"]
[62.783863, "o", "R24 [Total Current Assets]:\r\n   F24 =SUM(F20:F23)\r\n   G24 =SUM(G20:G23)\r\n   H24 =SUM(H20:H23)\r\n   I24 =SUM(I20:I23)\r\n   J24 =SUM(J20:J23)\r\n   K24 =SUM(K20:K23)\r\n   L24 =SUM(L20:L23)\r\n   M24 =SUM(M20:M23)\r\n"]
[62.783867, "o", "   N24 =SUM(N20:N23)\r\n"]

[266.593533, "i", "python3 - <<'PY'\nimport openpyxl, re\nwb=openpyxl.load_workbook('/workspace/output.xlsx', data_only=False)\nad=re.compile(r'([A-Z]{1,3}\\$?[0-9]+|\\$?[A-Z]{1,3}\\$?[0-9]+|\\$?[A-Z]{1,3}|\\$?[0-9]+)')\nfor ws in wb.worksheets:\n    flags=[]\n    for row in ws.iter_rows():\n        fs=[c for c in row if c.column>=6 and c.column<=15 and isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE')]\n        if len(fs)<4: continue\n        pats={}\n        for c in fs:\n            t=ad.sub('R', c.value[1:])\n            pats.setdefault(t,[]).append(c.coordinate)\n        maxpat=max(pats, key=lambda k:len(pats[k]))\n        for c in fs:\n            t=ad.sub('R', c.value[1:])\n            if t!=maxpat and len(pats[maxpat]) >= max(2,len(fs)//2):\n                flags.append((c.coordinate, c.value))\n    if flags:\n        print('\\n====', ws.title, '====')\n        for x in flags:\n            print(x)\nPY\n"]
[266.594687, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl, re\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook('/workspace/output.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> ad=re.compile(r'([A-Z]{1,3}\\$?[0-9]+|\\$?[A-Z]{1,3}\\$?[0-9]+|\\$?[A-Z]{1,3}|\\$?[0-9]+)')\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     flags=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h> "]

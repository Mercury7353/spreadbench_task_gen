[62.783636, "o", "R11 [Net Block]:\r\n   F11 =F7-F8-F9-F10\r\n   G11 =G7-G8-G9-G10\r\n   H11 =H7-H8-H9-H10\r\n   I11 =I7-I8-I9-I10\r\n   J11 =J7-J8-J9-J10\r\n   K11 =K7-K8-K9-K10\r\n   L11 =L7-L8-L9-L10\r\n   M11 =M7-M8-M9-M10\r\n   N11 =N7-N8-N9-N10\r\n   O11 =O7-O8-O9-O10\r\nR12 [Add: Capital Work in Progress]:\r\n   K12 =Assumptions!K51*'P&L'!K7\r\n   L12 =Assumptions!L51*'P&L'!L7\r\n   M12 =Assumptions!M51*'P&L'!M7\r\n   N12 =Assumptions!N51*'P&L'!N7\r\n"]

[62.806111, "o", "\u001b[?2004hroot@3b6411e8f617:/workspace# "]
[68.645146, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nwith open('/workspace/formulas.txt','w') as f:\n    for ws in wb.worksheets:\n        f.write(f'\\n==== {ws.title} ====\\n')\n        for row in ws.iter_rows():\n            fs=[c for c in row if isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE')]\n            if not fs: continue\n            labels=[c for c in row[:5] if c.value is not None]\n            lab=' | '.join(str(c.value) for c in labels)\n            f.write(f'R{row[0].row} [{lab}]:\\n')\n            for c in fs:\n                f.write(f'  {c.coordinate} {c.value}\\n')\nprint('done', sum(1 for _ in open('/workspace/formulas.txt')))\nPY\nwhich libreoffice || which soffice || echo no libreoffice\n"]

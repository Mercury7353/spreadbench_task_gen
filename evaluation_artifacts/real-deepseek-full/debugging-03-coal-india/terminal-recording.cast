[276.14091, "i", "python3 - <<'PY'\nimport openpyxl, re\nwb=openpyxl.load_workbook('/workspace/output.xlsx', data_only=False)\npat = re.compile(r\"'(?P<sheet>[^']+)'!\\$?(?P<col>[A-Z]{1,3})\\$?(?P<row>[0-9]+)|(?<![A-Za-z$])\\$?(?P<col2>[A-Z]{1,3})\\$?(?P<row2>[0-9]+)\")\nfor ws in wb.worksheets:\n    flags=[]\n    for row in ws.iter_rows():\n        fs=[c for c in row if 6 <= c.column <= 15 and isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE')]\n        if len(fs)<5: continue\n        refs_by_cell=[]\n        for c in fs:\n            refs=[]\n            for m in pat.finditer(c.value):\n                sheet=m.group('sheet') if m.group('sheet') else ws.title\n                r=int(m.group('row') or m.group('row2'))\n                refs.append((sheet,r))\n            refs_by_cell.append((c,refs))\n        for sheet in set(s for _,refs in refs_by_cell for s,_ in refs):\n            vals=[]\n            for c,refs in refs_by_cell:\n                rs=[r for s,r in refs if s==sheet]\n                vals.append((c.co"]
[276.144193, "i", "ordinate, c.column, rs))\n            maxlen=max(len(v[2]) for v in vals)\n            for pos in range(maxlen):\n                seq=[]\n                for coord,col,rs in vals:\n                    if pos < len(rs): seq.append((col,rs[pos],coord))\n                if len(seq)<5: continue\n                deltas=[]\n                for i in range(len(seq)-1):\n                    deltas.append(seq[i+1][1]-seq[i][1])\n                majority=max(set(deltas), key=deltas.count) if deltas else None\n                for i in range(len(seq)-1):\n                    if seq[i][0]+1 != seq[i+1][0]: continue\n                    d=seq[i+1][1]-seq[i][1]\n                    if d != majority:\n                        flags.append((ws.title, seq[i][2], seq[i+1][2], 'delta', d, 'expected', majority))\n    if flags:\n        print('\\n==', ws.title, '==')\n        for f in flags[:200]: print(f)\nPY\ngrep -nE \"N15|N27|I28|N17|M14|H7|I10|K15|L15|L30|K42|M18|N20|I14|I19|F42|K60|L60|T46|S45|U36|G22\" /workspace/formulas.txt | grep N\"]\" ; python3 "]

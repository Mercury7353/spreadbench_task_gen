[231.368139, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nws=wb['P&L']\nfor r in list(range(30,40))+list(range(52,60)):\n    cells=[]\n    for c in ws[r]:\n        if c.value is not None:\n            if isinstance(c.value,str) and c.value.startswith('='):\n                cells.append(f'{c.coordinate}:{c.value}')\n            else:\n                cells.append(f'{c.coordinate}:{c.value!r}')\n    print('R'+str(r)+': '+ ' | '.join(cells))\nPY\n"]

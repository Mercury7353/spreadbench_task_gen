[62.786988, "o", "R10 [Closing Balance]:\r\n   G10 =SUM(G7:G9)\r\n   H10 =SUM(H7:H9)\r\n   I10 =SUM(I7:I9)\r\n   J10 =SUM(J7:J9)\r\n   K10 =SUM(K7:K9)\r\n   L10 =SUM(L7:L9)\r\n   M10 =SUM(M7:M9)\r\n   N10 =SUM(N7:N9)\r\n   O10 =SUM(O7:O9)\r\n"]

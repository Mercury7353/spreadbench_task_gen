[62.669111, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    print('\\n====', ws.title, '====')\n    for row in ws.iter_rows():\n        fs=[c for c in row if isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE')]\n        if not fs: continue\n        labels=[c for c in row[:4] if c.value is not None]\n        lab=' | '.join(str(c.value) for c in labels)\n        print('R%d [%s]:' % (row[0].row, lab))\n        for c in fs:\n            print('  ', c.coordinate, c.value)\nPY\n"]
[62.66955, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[62.669653, "o", "\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.671006, "o", "wb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n====', ws.title, '====')\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h>         fs=[c for c in row if isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE')]\r\n\u001b[?2004l\r\u001b[?2004h>         if not fs: continue\r\n\u001b[?2004l\r\u001b[?2004h>         labels=[c for c in row[:4] if c.value is not None]\r\n\u001b[?2004l\r\u001b[?2004h>         lab=' | '.join(str(c.value) for c in labels)\r\n\u001b[?2004l\r\u001b[?2004h>         print('R%d [%s]:' % (row[0].row, lab))\r\n\u001b[?2004l\r\u001b[?2004h>         for c in fs:\r\n\u001b[?2004l\r\u001b[?2004h>             print('  ', c.coordinate, c.value)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

[100.761568, "i", "python3 - <<'PY'\nimport openpyxl\nfrom openpyxl.utils import column_index_from_string\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nfor sheet, rows in [('BS', range(18,27)),('CF', range(7,21)),('CF', range(24,40))]:\n    ws=wb[sheet]\n    print('\\n====', sheet, 'rows', rows, '====')\n    for r in rows:\n        cells=[]\n        for c in ws[r]:\n            if c.value is not None:\n                if isinstance(c.value,str) and c.value.startswith('='):\n                    cells.append(f'{c.coordinate}:{c.value}')\n                else:\n                    cells.append(f'{c.coordinate}:{c.value!r}')\n        print('Row', r, ' '.join(cells))\nPY\n"]

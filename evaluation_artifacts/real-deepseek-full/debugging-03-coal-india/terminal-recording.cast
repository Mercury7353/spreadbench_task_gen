[110.747763, "o", "  J43: ='P&L'!J26/'P&L'!I26-1\r\n  K43: =IF($E43=\"CAGR\",AVERAGE(G43:J43),K42/100)\r\n  L43: =IF($E43=\"CAGR\",AVERAGE(H43:K43),L42/100)\r\n  M43: =IF($E43=\"CAGR\",AVERAGE(I43:L43),M42/100)\r\n  N43: =IF($E43=\"CAGR\",AVERAGE(J43:M43),N42/100)\r\n  O43: =IF($E43=\"CAGR\",AVERAGE(K43:N43),O42/100)\r\n\r\nRow 46: patterns=2\r\n  G46: ='P&L'!G27/BS!G9\r\n  H46: ='P&L'!H27/BS!H9\r\n  I46: ='P&L'!I27/BS!I9\r\n  J46: ='P&L'!J27/BS!J9\r\n  K46: =IF($E46=\"CAGR\",AVERAGE(G46:J46),K45/100)\r\n  L46: =IF($E46=\"CAGR\",AVERAGE(H46:K46),L45/100)\r\n  M46: =IF($E46=\"CAGR\",AVERAGE(I46:L46),M45/100)\r\n  N46: =IF($E46=\"CAGR\",AVERAGE(J46:M46),N45/100)\r\n  O46: =IF($E46=\"CAGR\",AVERAGE(K46:N46),O45/100)\r\n\r\nRow 51: patterns=2\r\n  G51: =BS!G12/'P&L'!G7\r\n  H51: =BS!H12/'P&L'!H7\r\n  I51: =BS!I12/'P&L'!I7\r\n"]
[110.747811, "o", "  J51: =BS!J12/'P&L'!J7\r\n  K51: =IF($E51=\"CAGR\",AVERAGE(G51:J51),K50/100)\r\n  L51: =IF($E51=\"CAGR\",AVERAGE(H51:K51),L50/100)\r\n  M51: =IF($E51=\"CAGR\",AVERAGE(I51:L51),M50/100)\r\n  N51: =IF($E51=\"CAGR\",AVERAGE(J51:M51),N50/100)\r\n  O51: =IF($E51=\"CAGR\",AVERAGE(K51:N51),O50/100)\r\n\r\nRow 54: patterns=2\r\n  G54: =BS!F13/BS!F11\r\n  H54: =BS!G13/BS!G11\r\n  I54: =BS!H13/BS!H11\r\n  J54: =BS!I13/BS!I11\r\n  K54: =IF($E54=\"CAGR\",AVERAGE(G54:J54),K53/100)\r\n"]
[110.747832, "o", "  L54: =IF($E54=\"CAGR\",AVERAGE(H54:K54),L53/100)\r\n  M54: =IF($E54=\"CAGR\",AVERAGE(I54:L54),M53/100)\r\n  N54: =IF($E54=\"CAGR\",AVERAGE(J54:M54),N53/100)\r\n  O54: =IF($E54=\"CAGR\",AVERAGE(K54:N54),O53/100)\r\n\r\nRow 57: patterns=2\r\n"]
[110.74788, "o", "  G57: =BS!G21/BS!G7\r\n  H57: =BS!H21/BS!H7\r\n  I57: =BS!I21/BS!I7\r\n  J57: =BS!J21/BS!J7\r\n  K57: =IF($E57=\"CAGR\",AVERAGE(G57:J57),K56/100)\r\n  L57: =IF($E57=\"CAGR\",AVERAGE(H57:K57),L56/100)\r\n  M57: =IF($E57=\"CAGR\",AVERAGE(I57:L57),M56/100)\r\n  N57: =IF($E57=\"CAGR\",AVERAGE(J57:M57),N56/100)\r\n"]
[110.747892, "o", "  O57: =IF($E57=\"CAGR\",AVERAGE(K57:N57),O56/100)\r\n\r\nRow 60: patterns=2\r\n"]
[110.747915, "o", "  G60: =AVERAGE(BS!F20:G20)/('P&L'!G14+'P&L'!G15)*365\r\n  H60: =AVERAGE(BS!G20:H20)/('P&L'!H14+'P&L'!H15)*365\r\n  I60: =AVERAGE(BS!H20:I20)/('P&L'!I14+'P&L'!I15)*365\r\n  J60: =AVERAGE(BS!I20:J20)/('P&L'!J14+'P&L'!J15)*365\r\n  K60: =IF($E60=\"CAGR\",AVERAGE(G60:J60),K59)\r\n"]
[110.747937, "o", "  L60: =IF($E60=\"CAGR\",AVERAGE(H60:K60),L59)\r\n"]
[110.748003, "o", "  M60: =IF($E60=\"CAGR\",AVERAGE(I60:L60),M59)\r\n  N60: =IF($E60=\"CAGR\",AVERAGE(J60:M60),N59)\r\n  O60: =IF($E60=\"CAGR\",AVERAGE(K60:N60),O59)\r\n\r\nRow 63: patterns=2\r\n  G63: =BS!G23/BS!F23-1\r\n  H63: =BS!H23/BS!G23-1\r\n  I63: =BS!I23/BS!H23-1\r\n  J63: =BS!J23/BS!I23-1\r\n  K63: =IF($E63=\"CAGR\",AVERAGE(G63:J63),K62/100)\r\n  L63: =IF($E63=\"CAGR\",AVERAGE(H63:K63),L62/100)\r\n  M63: =IF($E63=\"CAGR\",AVERAGE(I63:L63),M62/100)\r\n  N63: =IF($E63=\"CAGR\",AVERAGE(J63:M63),N62/100)\r\n  O63: =IF($E63=\"CAGR\",AVERAGE(K63:N63),O62/100)\r\n\r\nRow 66: patterns=2\r\n  G66: =BS!G31/BS!G7\r\n  H66: =BS!H31/BS!H7\r\n  I66: =BS!I31/BS!I7\r\n"]
[110.748034, "o", "  J66: =BS!J31/BS!J7\r\n  K66: =IF($E66=\"CAGR\",AVERAGE(G66:J66),K65/100)\r\n  L66: =IF($E66=\"CAGR\",AVERAGE(H66:K66),L65/100)\r\n  M66: =IF($E66=\"CAGR\",AVERAGE(I66:L66),M65/100)\r\n"]

[251.274273, "i", "rm -rf /workspace/lo2 && mkdir -p /workspace/lo2\nlibreoffice --headless --convert-to xlsx --outdir /workspace/lo2 /workspace/output.xlsx\nmv /workspace/lo2/output.xlsx /workspace/output_calc.xlsx\npython3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/output_calc.xlsx', data_only=False)\nwv=openpyxl.load_workbook('/workspace/output_calc.xlsx', data_only=True)\nfor ws in wb.worksheets:\n    vws=wv[ws.title]\n    errors=[]\n    for row in ws.iter_rows():\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('='):\n                vv=vws[c.coordinate].value\n                if isinstance(vv,str) and vv.startswith('#') or vv is None:\n                    errors.append((c.coordinate, c.value, vv))\n    if errors:\n        print(ws.title, len(errors))\n        for e in errors[:100]: print(e)\nPY\n"]

[19.05975, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nwv=openpyxl.load_workbook('/workspace/input.xlsx', data_only=True)\nwith open('/workspace/dump.txt','w') as f:\n    for ws in wb.worksheets:\n        vws=wv[ws.title]\n        f.write('\\n======== %s ======== dims=%s maxrow=%s maxcol=%s\\n' % (ws.title, ws.dimensions, ws.max_row, ws.max_column))\n        for row in ws.iter_rows():\n            for c in row:\n                if c.value is not None:\n                    val=c.value\n                    vv=vws[c.coordinate].value\n                    if isinstance(val,str) and val.startswith('='):\n                        if val.startswith('=TABLE'):\n                            continue\n                        f.write('%s %s => %s\\n' % (c.coordinate, val, vv))\n                    else:\n                        f.write('%s %r || cached %r\\n' % (c.coordinate, val, vv))\n        f.write('\\nTABLE cells: ' + str(sum(1 for row in ws.iter_rows() for c in row if isinstance(c.value,str)"]

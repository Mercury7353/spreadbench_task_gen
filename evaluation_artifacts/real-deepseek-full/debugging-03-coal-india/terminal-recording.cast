[62.787071, "o", "R16 [Closing Balance]:\r\n   G16 =SUM(G13:G15)\r\n   H16 =SUM(H13:H15)\r\n   I16 =SUM(I13:I15)\r\n   J16 =SUM(J13:J15)\r\n   K16 =SUM(K13:K15)\r\n   L16 =SUM(L13:L15)\r\n   M16 =SUM(M13:M15)\r\n   N16 =SUM(N13:N15)\r\n   O16 =SUM(O13:O15)\r\n"]
[62.787182, "o", "R18 [Average Loan Outstanding]:\r\n   G18 =AVERAGE(G16,G13,G10,G7)\r\n   H18 =AVERAGE(H16,H13,H10,H7)\r\n   I18 =AVERAGE(I16,I13,I10,I7)\r\n   J18 =AVERAGE(J16,J13,J10,J7)\r\n   K18 =AVERAGE(K16,K13,K10,K7)\r\n   L18 =AVERAGE(L16,L13,L10,L7)\r\n   M18 =AVERAGE(M16,M13,M10,M7)\r\n   N18 =AVERAGE(N16,N13,N10,N7)\r\n   O18 =AVERAGE(O16,O13,O10,O7)\r\nR20 [Interest Expense]:\r\n   G20 =G18*G19\r\n   H20 =H18*H19\r\n   I20 =I18*I19\r\n   J20 =J18*J19\r\n   K20 =K18*K19\r\n   L20 =L18*L19\r\n   M20 =M18*M19\r\n   N20 =N18*N19\r\n   O20 =O18*O19\r\n"]

[117.24208, "i", "python3 - <<'PY'\nimport openpyxl, re\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nad=re.compile(r'([A-Z]{1,3}\\$?[0-9]+|\\$?[A-Z]{1,3}\\$?[0-9]+|\\$?[A-Z]{1,3}|\\$?[0-9]+)')\nwith open('/workspace/variability.txt','w') as f:\n    for ws in wb.worksheets:\n        f.write(f'\\n==== Variability {ws.title} ====\\n')\n        for row in ws.iter_rows():\n            fs=[c for c in row if isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE')]\n            if len(fs)<2: continue\n            pats={}\n            for c in fs:\n                t=ad.sub('R', c.value[1:])\n                pats.setdefault(t,[]).append(c.coordinate)\n            if len(pats)>1:\n                f.write(f'Row {row[0].row} patterns={len(pats)}\\n')\n                for c in fs:\n                    f.write(f'  {c.coordinate}: {c.value}\\n')\nprint('wrote variability.txt', sum(1 for _ in open('/workspace/variability.txt')))\nPY\ngrep -n '====\\|=1+(\\| -1\\*(' /workspace/variability.txt\n"]
[117.242252, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]

[110.747613, "o", "  O31: =IF($E31=\"CAGR\",AVERAGE(K31:N31),O30/100)\r\n\r\nRow 34: patterns=2\r\n  G34: ='P&L'!G21/'P&L'!G7\r\n  H34: ='P&L'!H21/'P&L'!H7\r\n  I34: ='P&L'!I21/'P&L'!I7\r\n  J34: ='P&L'!J21/'P&L'!J7\r\n  K34: =IF($E34=\"CAGR\",AVERAGE(G34:J34),K33/100)\r\n  L34: =IF($E34=\"CAGR\",AVERAGE(H34:K34),L33/100)\r\n  M34: =IF($E34=\"CAGR\",AVERAGE(I34:L34),M33/100)\r\n  N34: =IF($E34=\"CAGR\",AVERAGE(J34:M34),N33/100)\r\n  O34: =IF($E34=\"CAGR\",AVERAGE(K34:N34),O33/100)\r\n\r\nRow 37: patterns=2\r\n  G37: ='P&L'!G23/'P&L'!G7\r\n  H37: ='P&L'!H23/'P&L'!H7\r\n  I37: ='P&L'!I23/'P&L'!I7\r\n  J37: ='P&L'!J23/'P&L'!J7\r\n  K37: =IF($E37=\"CAGR\",AVERAGE(G37:J37),K36/100)\r\n  L37: =IF($E37=\"CAGR\",AVERAGE(H37:K37),L36/100)\r\n  M37: =IF($E37=\"CAGR\",AVERAGE(I37:L37),M36/100)\r\n  N37: =IF($E37=\"CAGR\",AVERAGE(J37:M37),N36/100)\r\n"]

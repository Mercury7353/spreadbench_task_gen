[182.921368, "i", "python3 - <<'PY'\nimport openpyxl, re\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nref=re.compile(r'([A-Z]{1,3})([0-9]{1,3})')\n# Cells to inspect by sheet and row: print compact\nfor sheet, rows in [('Assumptions', range(1,110))]:\n    ws=wb[sheet]\n    print('====',sheet,'====')\n    for r in rows:\n        cells=[]\n        for c in ws[r]:\n            if c.value is not None:\n                if isinstance(c.value,str) and c.value.startswith('='):\n                    cells.append(f'{c.coordinate}:{c.value}')\n                else:\n                    val=c.value\n                    if r%2==0: pass\n                    cells.append(f'{c.coordinate}:{val!r}')\n        if cells:\n            rowtext=' '.join(cells)\n            print('R'+str(r)+': '+rowtext[:2200])\nPY\n"]

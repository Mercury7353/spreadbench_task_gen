[75.079325, "i", "mkdir -p /workspace/lo_out\nlibreoffice --headless --convert-to xlsx --outdir /workspace/lo_out /workspace/input.xlsx\nmv /workspace/lo_out/input.xlsx /workspace/calculated.xlsx\npython3 - <<'PY'\nimport openpyxl\npath='/workspace/calculated.xlsx'\nwb=openpyxl.load_workbook(path, data_only=False)\nwv=openpyxl.load_workbook(path, data_only=True)\nprint('sheets', wb.sheetnames)\nfor ws in wb.worksheets:\n    vws=wv[ws.title]\n    vals=[]\n    for row in ws.iter_rows():\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('=') and not c.value.startswith('=TABLE'):\n                vv=vws[c.coordinate].value\n                if isinstance(vv,str) and vv.startswith('#'):\n                    vals.append((c.coordinate, c.value, vv))\n                elif vv is None:\n                    vals.append((c.coordinate, c.value, vv))\n    if vals:\n        print('\\n', ws.title, 'error/none formulas:', len(vals))\n        for x in vals[:200]:\n            print(x)\nPY\n"]

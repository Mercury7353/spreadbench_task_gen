[162.858398, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nws=wb['P&L']\nfor r in range(1,70):\n    cells=[]\n    for c in ws[r]:\n        if c.value is not None:\n            val=c.value\n            if isinstance(val,str) and val.startswith('='):\n                val=val\n            cells.append(f'{c.coordinate}:{val}')\n    if cells:\n        rowtext=' '.join(cells)\n        if len(rowtext)>2500:\n            rowtext=rowtext[:2500]+' ...'\n        print('R'+str(r)+': '+rowtext)\nPY\n"]
[162.858764, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[162.859417, "o", "\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> ws=wb['P&L']\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(1,70):\r\n\u001b[?2004l\r\u001b[?2004h>     cells=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for c in ws[r]:\r\n\u001b[?2004l\r\u001b[?2004h>         if c.value is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             val=c.value\r\n\u001b[?2004l\r\u001b[?2004h>             if isinstance(val,str) and val.startswith('='):\r\n\u001b[?2004l\r\u001b[?2004h>                 val=val\r\n\u001b[?2004l\r\u001b[?2004h>             cells.append(f'{c.coordinate}:{val}')\r\n\u001b[?2004l\r\u001b[?2004h>     if cells:\r\n\u001b[?2004l\r\u001b[?2004h>         rowtext=' '.join(cells)\r\n\u001b[?2004l\r\u001b[?2004h>         if len(rowtext)>2500:\r\n\u001b[?2004l\r\u001b[?2004h>             rowtext=rowtext[:2500]+' ...'\r\n\u001b[?2004l\r\u001b[?2004h>         print('R'+str(r)+': '+rowtext)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

[12.677012, "i", "python3 - <<'PY'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nwv=openpyxl.load_workbook('/workspace/input.xlsx', data_only=True)\nfor ws in wb.worksheets:\n    vws = wv[ws.title]\n    print('\\n========', ws.title, '========')\n    print('dims', ws.dimensions, 'rows', ws.max_row, 'cols', ws.max_column)\n    for row in ws.iter_rows():\n        for c in row:\n            if c.value is not None:\n                val = c.value\n                vv = vws[c.coordinate].value\n                if isinstance(val,str) and val.startswith('='):\n                    print(c.coordinate, val, '=>', vv)\n                else:\n                    print(c.coordinate, repr(val), '|| cached', vv)\nPY\n"]
[12.677423, "o", "python3 - <<'PY'"]

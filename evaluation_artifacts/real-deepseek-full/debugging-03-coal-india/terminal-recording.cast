[140.889159, "o", "==== Variability P&L ====\r\nRow 22 patterns=2\r\n  G22: =1+('Debt Schedule'!G20)\r\n  H22: ='Debt Schedule'!H20\r\n  I22: ='Debt Schedule'!I20\r\n  J22: ='Debt Schedule'!J20\r\n  K22: ='Debt Schedule'!K20\r\n  L22: ='Debt Schedule'!L20\r\n  M22: ='Debt Schedule'!M20\r\n  N22: ='Debt Schedule'!N20\r\n  O22: ='Debt Schedule'!O20\r\nRow 27 patterns=2\r\n  K27: =Assumptions!K46*BS!K9\r\n  L27: =Assumptions!L46*BS!L9\r\n  M27: =Assumptions!M46*BS!M9\r\n  N27: =1+(Assumptions!N46*BS!N9)\r\n  O27: =Assumptions!O46*BS!O9\r\nRow 42 patterns=2\r\n  F42: =-1*(F40+F41)\r\n  G42: =G40+G41\r\n  H42: =H40+H41\r\n  I42: =I40+I41\r\n  J42: =J40+J41\r\n  K42: =K40+K41\r\n  L42: =L40+L41\r\n  M42: =M40+M41\r\n  N42: =N40+N41\r\n  O42: =O40+O41\r\nRow 60 patterns=3\r\n  K60: =-1*(J60/J56*K56)\r\n  L60: =1+(K60/K56*L56)\r\n  M60: =L60/L56*M56\r\n  N60: =M60/M56*N56\r\n  O60: =N60/N56*O56\r\n\r\n"]

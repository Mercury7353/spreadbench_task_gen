[62.781916, "o", "R7 [Sales]:\r\n   K7 =J7*(1+Assumptions!K7)\r\n   L7 =K7*(1+Assumptions!L7)\r\n   M7 =L7*(1+Assumptions!M7)\r\n   N7 =M7*(1+Assumptions!N7)\r\n   O7 =N7*(1+Assumptions!O7)\r\nR8 [Coal used for other purposes]:\r\n   K8 =J8\r\n   L8 =K8\r\n   M8 =L8\r\n   N8 =M8\r\n   O8 =N8\r\n"]
[62.781986, "o", "R9 [Accretion(+)/Decretion(-) of stock]:\r\n   K9 =J9\r\n   L9 =K9\r\n   M9 =L9\r\n   N9 =M9\r\n   O9 =N9\r\nR10 [Other Income]:\r\n   K10 =J10*(1+Assumptions!K10)\r\n   L10 =K10*(1+Assumptions!L10)\r\n   M10 =L10*(1+Assumptions!M10)\r\n   N10 =M10*(1+Assumptions!N10)\r\n   O10 =N10*(1+Assumptions!O10)\r\n"]
[62.782019, "o", "R11 [Total]:\r\n   F11 =SUM(F7:F10)\r\n   G11 =SUM(G7:G10)\r\n   H11 =SUM(H7:H10)\r\n   I11 =SUM(I7:I10)\r\n   J11 =SUM(J7:J10)\r\n   K11 =SUM(K7:K10)\r\n   L11 =SUM(L7:L10)\r\n   M11 =SUM(M7:M10)\r\n   N11 =SUM(N7:N10)\r\n   O11 =SUM(O7:O10)\r\n"]
[62.782082, "o", "R14 [Internal consumption of coal]:\r\n   K14 =J14*(1+Assumptions!K13)\r\n   L14 =K14*(1+Assumptions!L13)\r\n   M14 =L14*(1+Assumptions!M13)\r\n   N14 =M14*(1+Assumptions!N13)\r\n   O14 =N14*(1+Assumptions!O13)\r\nR15 [Consumption of Stores & Spares]:\r\n   K15 =Assumptions!K16*K7\r\n   L15 =Assumptions!L16*L7\r\n   M15 =Assumptions!M16*M7\r\n   N15 =Assumptions!N17*N7\r\n   O15 =Assumptions!O16*O7\r\n"]
[62.782105, "o", "R16 [Employees remuneration & Benefits]:\r\n   K16 =J16*(1+Assumptions!K19)\r\n   L16 =K16*(1+Assumptions!L19)\r\n"]
[62.782139, "o", "   M16 =L16*(1+Assumptions!M19)\r\n   N16 =M16*(1+Assumptions!N19)\r\n   O16 =N16*(1+Assumptions!O19)\r\n"]
[62.782148, "o", "R17 [Power & Fuel]:\r\n   K17 =Assumptions!K22*K7\r\n   L17 =Assumptions!L22*L7\r\n   M17 =Assumptions!M22*M7\r\n   N17 =Assumptions!N22*N7\r\n   O17 =Assumptions!O22*O7\r\nR18 [Social Overhead]:\r\n"]
[62.782184, "o", "   K18 =Assumptions!K25*K7\r\n   L18 =Assumptions!L25*L7\r\n   M18 =Assumptions!M25*M7\r\n   N18 =Assumptions!N25*N7\r\n   O18 =Assumptions!O25*O7\r\nR19 [Repairs]:\r\n   K19 =Assumptions!K28*K7\r\n   L19 =Assumptions!L28*L7\r\n   M19 =Assumptions!M28*M7\r\n   N19 =Assumptions!N28*N7\r\n   O19 =Assumptions!O28*O7\r\n"]
[62.782199, "o", "R20 [Contractual Expenses]:\r\n   K20 =Assumptions!K31*K7\r\n   L20 =Assumptions!L31*L7\r\n   M20 =Assumptions!M31*M7\r\n   N20 =Assumptions!N31*N7\r\n   O20 =Assumptions!O31*O7\r\n"]
[62.782258, "o", "R21 [Other Expenditure]:\r\n   K21 =Assumptions!K34*K7\r\n   L21 =Assumptions!L34*L7\r\n   M21 =Assumptions!M34*M7\r\n   N21 =Assumptions!N34*N7\r\n   O21 =Assumptions!O34*O7\r\nR22 [Interest]:\r\n   G22 =1+('Debt Schedule'!G20)\r\n   H22 ='Debt Schedule'!H20\r\n   I22 ='Debt Schedule'!I20\r\n   J22 ='Debt Schedule'!J20\r\n   K22 ='Debt Schedule'!K20\r\n   L22 ='Debt Schedule'!L20\r\n   M22 ='Debt Schedule'!M20\r\n   N22 ='Debt Schedule'!N20\r\n   O22 ='Debt Schedule'!O20\r\n"]
[62.782325, "o", "R23 [Overburden removal adjustment]:\r\n   K23 =Assumptions!K37*K7\r\n   L23 =Assumptions!L37*L7\r\n   M23 =Assumptions!M37*M7\r\n   N23 =Assumptions!N37*N7\r\n   O23 =Assumptions!O37*O7\r\nR24 [Finance Charges/Commitment Charges]:\r\n   K24 =J24\r\n   L24 =K24\r\n   M24 =L24\r\n   N24 =M24\r\n   O24 =N24\r\nR25 [Depreciation]:\r\n   K25 =J25/BS!J7*BS!K7\r\n   L25 =K25/BS!K7*BS!L7\r\n   M25 =L25/BS!L7*BS!M7\r\n   N25 =M25/BS!M7*BS!N7\r\n   O25 =N25/BS!N7*BS!O7\r\n"]
[62.782377, "o", "R26 [Impairment]:\r\n   K26 =J26*(1+Assumptions!K43)\r\n   L26 =K26*(1+Assumptions!L43)\r\n   M26 =L26*(1+Assumptions!M43)\r\n   N26 =M26*(1+Assumptions!N43)\r\n   O26 =N26*(1+Assumptions!O43)\r\nR27 [Provisions/Write off]:\r\n   K27 =Assumptions!K46*BS!K9\r\n   L27 =Assumptions!L46*BS!L9\r\n   M27 =Assumptions!M46*BS!M9\r\n   N27 =1+(Assumptions!N46*BS!N9)\r\n   O27 =Assumptions!O46*BS!O9\r\n"]
[62.782406, "o", "R28 [Total Operating Costs]:\r\n   F28 =SUM(F14:F27)\r\n   G28 =SUM(G14:G27)\r\n   H28 =SUM(H14:H27)\r\n   I28 =SUM(I15:I27)\r\n   J28 =SUM(J14:J27)\r\n"]
[62.782442, "o", "   K28 =SUM(K14:K27)\r\n   L28 =SUM(L14:L27)\r\n   M28 =SUM(M14:M27)\r\n   N28 =SUM(N14:N27)\r\n   O28 =SUM(O14:O27)\r\n"]
[62.782556, "o", "R30 [Profit for the year]:\r\n   F30 =F11-F28\r\n   G30 =G11-G28\r\n   H30 =H11-H28\r\n   I30 =I11-I28\r\n   J30 =J11-J28\r\n   K30 =K11-K28\r\n   L30 =L11-L28\r\n   M30 =M11-M28\r\n   N30 =N11-N28\r\n   O30 =O11-O28\r\nR33 [Profit Before Tax & Extra-Ordinary Items]:\r\n   F33 =F30+F31\r\n   G33 =G30+G31\r\n   H33 =H30+H31\r\n   I33 =I30+I31\r\n   J33 =J30+J31\r\n   K33 =K30+K31\r\n   L33 =L30+L31\r\n   M33 =M30+M31\r\n   N33 =N30+N31\r\n   O33 =O30+O31\r\nR34 [Provision for Income Tax]:\r\n   K34 =AVERAGE(F34/F33,G34/G33,H34/H33,I34/I33,J34/J33)*K33\r\n   L34 =AVERAGE(G34/G33,H34/H33,I34/I33,J34/J33,K34/K33)*L33\r\n   M34 =AVERAGE(H34/H33,I34/I33,J34/J33,K34/K33,L34/L33)*M33\r\n   N34 =AVERAGE(I34/I33,J34/J33,K34/K33,L34/L33,M34/M33)*N33\r\n   O34 =AVERAGE(J34/J33,K34/K33,L34/L33,M34/M33,N34/N33)*O33\r\n"]
[62.782599, "o", "R38 [Fringe benefit Tax]:\r\n   K38 =AVERAGE(F38/F16,G38/G16,H38/H16,I38/I16,J38/J16)*K16\r\n   L38 =AVERAGE(G38/G16,H38/H16,I38/I16,J38/J16,K38/K16)*L16\r\n   M38 =AVERAGE(H38/H16,I38/I16,J38/J16,K38/K16,L38/L16)*M16\r\n   N38 =AVERAGE(I38/I16,J38/J16,K38/K16,L38/L16,M38/M16)*N16\r\n   O38 =AVERAGE(J38/J16,K38/K16,L38/L16,M38/M16,N38/N16)*O16\r\n"]
[62.782645, "o", "R40 [Profit After Tax, Before Extra Ordinary Items]:\r\n   F40 =F33-SUM(F34:F38)\r\n   G40 =G33-SUM(G34:G38)\r\n   H40 =H33-SUM(H34:H38)\r\n   I40 =I33-SUM(I34:I38)\r\n   J40 =J33-SUM(J34:J38)\r\n   K40 =K33-SUM(K34:K38)\r\n   L40 =L33-SUM(L34:L38)\r\n   M40 =M33-SUM(M34:M38)\r\n   N40 =N33-SUM(N34:N38)\r\n   O40 =O33-SUM(O34:O38)\r\n"]
[62.782692, "o", "R42 [Profit after Tax]:\r\n   F42 =-1*(F40+F41)\r\n   G42 =G40+G41\r\n   H42 =H40+H41\r\n   I42 =I40+I41\r\n   J42 =J40+J41\r\n   K42 =K40+K41\r\n   L42 =L40+L41\r\n   M42 =M40+M41\r\n   N42 =N40+N41\r\n   O42 =O40+O41\r\n"]
[62.78277, "o", "R50 [Total of adjustments after tax impact]:\r\n   F50 =SUM(F45:F49)\r\n   G50 =SUM(G45:G49)\r\n   H50 =SUM(H45:H49)\r\n"]
[62.782813, "o", "   I50 =SUM(I45:I49)\r\n   J50 =SUM(J45:J49)\r\n   K50 =SUM(K45:K49)\r\n   L50 =SUM(L45:L49)\r\n   M50 =SUM(M45:M49)\r\n   N50 =SUM(N45:N49)\r\n   O50 =SUM(O45:O49)\r\n"]
[62.782841, "o", "R52 [Profit After Tax (Restated)]:\r\n   F52 =F42+F50\r\n   G52 =G42+G50\r\n   H52 =H42+H50\r\n   I52 =I42+I50\r\n   J52 =J42+J50\r\n"]
[62.782903, "o", "   K52 =K42+K50\r\n   L52 =L42+L50\r\n   M52 =M42+M50\r\n   N52 =N42+N50\r\n   O52 =O42+O50\r\nR54 [Profit (Loss) brought forward from previous year]:\r\n   G54 =F66\r\n   H54 =G66\r\n   I54 =H66\r\n   J54 =I66\r\n   K54 =J66\r\n   L54 =K66\r\n   M54 =L66\r\n   N54 =M66\r\n   O54 =N66\r\nR56 [Profit/(Loss) available for appropriation]:\r\n   F56 =F52+F54+F55\r\n   G56 =G52+G54+G55\r\n   H56 =H52+H54+H55\r\n   I56 =I52+I54+I55\r\n   J56 =J52+J54+J55\r\n   K56 =K52+K54+K55\r\n   L56 =L52+L54+L55\r\n   M56 =M52+M54+M55\r\n   N56 =N52+N54+N55\r\n   O56 =O52+O54+O55\r\n"]
[62.782946, "o", "R59 [Transfer to Reserve for Foreign Exchange Transaction]:\r\n   K59 =J60\r\n   L59 =K59\r\n   M59 =L59\r\n   N59 =M59\r\n   O59 =N59\r\n"]
[62.782987, "o", "R60 [Transfer to General reserve(Incl. Bond Redemption Reserve)]:\r\n   K60 =-1*(J60/J56*K56)\r\n   L60 =1+(K60/K56*L56)\r\n   M60 =L60/L56*M56\r\n   N60 =M60/M56*N56\r\n   O60 =N60/N56*O56\r\nR62 [Interim dividend]:\r\n"]
[62.783006, "o", "   K62 =AVERAGE(J62/J52,I62/I52,H62/H52,G62/G52,F62/F52)*K52\r\n   L62 =AVERAGE(K62/K52,J62/J52,I62/I52,H62/H52,G62/G52)*L52\r\n   M62 =AVERAGE(L62/L52,K62/K52,J62/J52,I62/I52,H62/H52)*M52\r\n   N62 =AVERAGE(M62/M52,L62/L52,K62/K52,J62/J52,I62/I52)*N52\r\n   O62 =AVERAGE(N62/N52,M62/M52,L62/L52,K62/K52,J62/J52)*O52\r\n"]
[62.78302, "o", "R63 [Tax on Dividend]:\r\n   K63 =AVERAGE(J63/J62,I63/I62,H63/H62,G63/G62,F63/F62)*K62\r\n   L63 =AVERAGE(K63/K62,J63/J62,I63/I62,H63/H62,G63/G62)*L62\r\n   M63 =AVERAGE(L63/L62,K63/K62,J63/J62,I63/I62,H63/H62)*M62\r\n   N63 =AVERAGE(M63/M62,L63/L62,K63/K62,J63/J62,I63/I62)*N62\r\n"]
[62.783037, "o", "   O63 =AVERAGE(N63/N62,M63/M62,L63/L62,K63/K62,J63/J62)*O62\r\n"]
[62.783082, "o", "R64 [Total Appropriations]:\r\n   F64 =SUM(F59:F63)\r\n   G64 =SUM(G59:G63)\r\n   H64 =SUM(H59:H63)\r\n   I64 =SUM(I59:I63)\r\n   J64 =SUM(J59:J63)\r\n   K64 =SUM(K59:K63)\r\n"]

[62.790624, "o", "R21 [Free Cash Flow to firm]:\r\n   G21 =G13+G14+G15-G16-SUM(G18:G20)\r\n   H21 =H13+H14+H15-H16-SUM(H18:H20)\r\n   I21 =I13+I14+I15-I16-SUM(I18:I20)\r\n   J21 =J13+J14+J15-J16-SUM(J18:J20)\r\n   K21 =K13+K14+K15-K16-SUM(K18:K20)\r\n   L21 =L13+L14+L15-L16-SUM(L18:L20)\r\n   M21 =M13+M14+M15-M16-SUM(M18:M20)\r\n   N21 =N13+N14+N15-N16-SUM(N18:N20)\r\n   O21 =O13+O14+O15-O16-SUM(O18:O20)\r\nR22 [Less: Interest*(1-Tax Rate)]:\r\n   G22 ='P&L'!G22*(1-$F$7)\r\n   H22 ='P&L'!H22*(1-$F$7)\r\n"]
[62.790672, "o", "   I22 ='P&L'!I22*(1-$F$7)\r\n   J22 ='P&L'!J22*(1-$F$7)\r\n   K22 ='P&L'!K22*(1-$F$7)\r\n   L22 ='P&L'!L22*(1-$F$7)\r\n   M22 ='P&L'!M22*(1-$F$7)\r\n   N22 ='P&L'!N22*(1-$F$7)\r\n   O22 ='P&L'!O22*(1-$F$7)\r\n"]

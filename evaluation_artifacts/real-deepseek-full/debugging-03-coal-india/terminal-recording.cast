[298.755386, "i", "rm -rf /workspace/lo3 && mkdir -p /workspace/lo3\nlibreoffice --headless --convert-to xlsx --outdir /workspace/lo3 /workspace/output.xlsx\nmv /workspace/lo3/output.xlsx /workspace/output_calc2.xlsx\npython3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/output_calc2.xlsx', data_only=False)\nwv=openpyxl.load_workbook('/workspace/output_calc2.xlsx', data_only=True)\nerrors=[]\nfor ws in wb.worksheets:\n    vws=wv[ws.title]\n    for row in ws.iter_rows():\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('='):\n                vv=vws[c.coordinate].value\n                if isinstance(vv,str) and vv.startswith('#') or vv is None:\n                    errors.append((ws.title,c.coordinate,c.value,vv))\nprint('error_count', len(errors))\nfor e in errors[:50]:\n    print(e)\nPY\n"]

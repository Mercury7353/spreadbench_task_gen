[461.527973, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    print('###', ws.title)\n    for row in ws.iter_rows():\n        for c in row:\n            if c.data_type=='f' and isinstance(c.value,str):\n                if c.coordinate in c.value or c.coordinate.replace('$','') in c.value:\n                    print('SELFREF', c.coordinate, c.value)\n                if c.column_letter=='I' and 'SUM(D' in c.value:\n                    pass\nPY\n"]

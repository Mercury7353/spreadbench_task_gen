[353.937078, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nws=wb['Loan Payment Calculator']\n# print last rows nonempty\nfor r in range(360, 375):\n    vals=[(c.coordinate,c.data_type,c.value) for c in ws[r] if c.value is not None]\n    if vals:\n        print(r, vals)\nprint('PATTERN MISMATCHES')\nfor r in range(12, 372):\n    errors=[]\n    C=ws.cell(r,3).value; D=ws.cell(r,4).value; E=ws.cell(r,5).value; F=ws.cell(r,6).value; G=ws.cell(r,7).value\n    if r==12:\n        if D != '=C7': errors.append(('D', D))\n    else:\n        if D != f'=D{r-1}+E{r-1}': errors.append(('D', D))\n    if E != f'=G{r}-F{r}': errors.append(('E', E))\n    if F != f'=-$C$6*D{r}': errors.append(('F', F))\n    if G != f'=IF(C{r}>$C$8,0,$C$9)': errors.append(('G', G))\n    if C is not None and C != r-11:\n        errors.append(('C', C))\n    if errors:\n        print('row', r, errors)\nPY\n"]

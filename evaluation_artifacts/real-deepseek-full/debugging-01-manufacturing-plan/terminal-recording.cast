[117.886046, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nws=wb['Model Inputs']\nprint('max', ws.max_row, ws.max_column, ws.dimensions)\nprint('C26', repr(ws['C26'].value))\nprint('D26', repr(ws['D26'].value))\nfor c in ['B20','C20','C24','C25','C32','B32','C31','B31','C40','B40','C44','B44']:\n    print(c, repr(ws[c].value))\nprint('keys with value')\nfor coord, c in sorted(ws._cells.items()):\n    if c.value is not None:\n        print(coord, c.data_type, repr(c.value))\nPY\n"]

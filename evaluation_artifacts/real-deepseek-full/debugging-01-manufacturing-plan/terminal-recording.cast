[54.473586, "i", "cat > /tmp/xlsx_report.py <<'PY'\nimport openpyxl\nwb = openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nprint('SHEETS', wb.sheetnames)\nfor ws in wb.worksheets:\n    print('\\n### SHEET', ws.title, ws.dimensions, ws.max_row, ws.max_column, 'state', ws.sheet_state)\n    print('Merged:', list(ws.merged_cells.ranges))\n    print('Rows 1-15:')\n    for row_idx, row in enumerate(ws.iter_rows(), start=1):\n        vals=[(c.coordinate,c.data_type,c.value) for c in row if c.value is not None]\n        if vals and row_idx <= 15:\n            print(' ', row_idx, vals)\n    print('Formulas other than B/C/D/E/F/G in main sheet:')\n    for row in ws.iter_rows():\n        for c in row:\n            if c.data_type == 'f' and c.column_letter not in ('D','E','F','G'):\n                print(' ', c.coordinate, c.value)\n    # print around summary rows and all non-body formula rows\n    print('All formulas (first 200):')\n    n=0\n    for row in ws.iter_rows():\n        for c in row:\n            if c.data_type == 'f':\n             "]

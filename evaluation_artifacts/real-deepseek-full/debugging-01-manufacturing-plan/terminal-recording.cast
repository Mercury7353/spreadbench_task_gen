[493.162388, "i", "oan Payment Calculator','E191'),('Loan Payment Calculator','F282'),('Loan Payment Calculator','G310'),('Loan Payment Calculator','D318')]\nfor sheet, coord in changes:\n    print(f'{sheet}!{coord}: {wb[sheet][coord].value!r}')\nprint('\\nSuspicious formulas remaining:') \nfor ws in wb.worksheets:\n    for row in ws.iter_rows():\n        for c in row:\n            if c.data_type=='f' and isinstance(c.value,str):\n                v=c.value\n                coord=c.coordinate\n                if coord in v and not ('Model Inputs' in ws.title and coord in ('B1','B2')):\n                    pass\n                if '1+(' in v or coord==v.replace('=','').replace('+',''):\n                    if coord not in ('B1','B2'):\n                        print(ws.title, coord, v)\nPY\n"]

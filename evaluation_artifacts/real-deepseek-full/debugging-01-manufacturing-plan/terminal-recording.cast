[29.358854, "i", "cat > /tmp/inspect.py <<'PY'\nimport openpyxl\nfrom collections import Counter\nwb = openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    print('SHEET', ws.title, ws.dimensions, ws.max_row, ws.max_column)\n    print('merge', list(ws.merged_cells.ranges))\n    for row_idx, row in enumerate(ws.iter_rows(), start=1):\n        vals=[(c.coordinate,c.data_type,c.value) for c in row if c.value is not None]\n        if vals and row_idx <= 50:\n            print('ROW', row_idx, vals)\n    counts=Counter()\n    ex={}\n    for row in ws.iter_rows():\n        for c in row:\n            if c.data_type=='f':\n                counts[c.column_letter]+=1\n                ex.setdefault(c.column_letter, []).append((c.row,c.value))\n    print('FORMULA COUNT per col', dict(counts))\n    print('Examples per col')\n    for col, arr in ex.items():\n        print(col, arr[:5])\nPY\npython3 /tmp/inspect.py\n"]

[353.938774, "o", "ws=wb['Loan Payment Calculator']\r\n\u001b[?2004l\r\u001b[?2004h> # print last rows nonempty\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(360, 375):\r\n\u001b[?2004l\r\u001b[?2004h>     vals=[(c.coordinate,c.data_type,c.value) for c in ws[r] if c.value is not None]\r\n\u001b[?2004l\r\u001b[?2004h>     if vals:\r\n\u001b[?2004l\r\u001b[?2004h>         print(r, vals)\r\n\u001b[?2004l\r\u001b[?2004h> print('PATTERN MISMATCHES')\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(12, 372):\r\n\u001b[?2004l\r\u001b[?2004h>     errors=[]\r\n\u001b[?2004l\r\u001b[?2004h>     C=ws.cell(r,3).value; D=ws.cell(r,4).value; E=ws.cell(r,5).value; F=ws.cell(r,6).value; G=ws.cell(r,7).value\r\n\u001b[?2004l\r\u001b[?2004h>     if r==12:\r\n\u001b[?2004l\r\u001b[?2004h>         if D != '=C7': errors.append(('D', D))\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         if D != f'=D{r-1}+E{r-1}': errors.append(('D', D))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.938948, "o", "    if E != f'=G{r}-F{r}': errors.append(('E', E))\r\n\u001b[?2004l\r\u001b[?2004h>     if F != f'=-$C$6*D{r}': errors.append(('F', F))\r\n\u001b[?2004l\r\u001b[?2004h>     if G != f'=IF(C{r}>$C$8,0,$C$9)': errors.append(('G', G))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.939036, "o", "    if C is not None and C != r-11:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.939063, "o", "        errors.append(('C', C))\r\n\u001b[?2004l\r"]
[353.939085, "o", "\u001b[?2004h> "]
[353.939142, "o", "    if errors:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.939195, "o", "        print('row', r, errors)\r\n\u001b[?2004l\r\u001b[?2004h"]

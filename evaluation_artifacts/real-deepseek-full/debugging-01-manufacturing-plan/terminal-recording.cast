[397.834831, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\npatterns=['1+(','=-1*(','1+(+','=+1','-1*MIN','-1*MAX','G51','G3?']\nfor ws in wb.worksheets:\n    print('###', ws.title)\n    for row in ws.iter_rows():\n        for c in row:\n            if c.data_type=='f' and isinstance(c.value,str):\n                if any(p in c.value for p in patterns):\n                    print(c.coordinate, c.value)\nPY\n"]

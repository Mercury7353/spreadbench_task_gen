[71.968523, "o", "### SHEET Model Inputs B1:G46 46 7 state visible\r\nMerged: [<MergedCellRange B10:E16>]\r\nRows 1-15:\r\n  1 [('B1', 's', '[Company Name]')]\r\n  2 [('B2', 's', '5-Year Financial Plan—Manufacturing')]\r\n  3 [('B3', 's', 'Model inputs and investor scenario')]\r\n  5 [('B5', 's', 'Enter data in white cells only.')]\r\n  6 [('B6', 's', 'Italicized numbers in gray cells are calculations that should not be overwritten.')]\r\n  7 [('B7', 's', 'Non-italicized numbers in gray cells are calculations that can be overwritten.')]\r\n  9 [('B9', 's', 'General notes and assumptions')]\r\n  10 [('B10', 's', '[Document key financial planning assumptions here.]')]\r\nFormulas other than B/C/D/E/F/G in main sheet:\r\n  C26 =+C24*C25\r\n  C28 =SUM(C26:F26)\r\n  C31 =C23\r\n  C33 =+C26*C32\r\n  C35 =SUM(C33:F33)\r\nAll formulas (first 200):\r\n  C26 =+C24*C25\r\n  D26 =+D24*D25\r\n  E26 =+E24*E25\r\n  F26 =+F24*F25\r\n  C28 =SUM(C26:F26)\r\n  C31 =C23\r\n  D31 =D23\r\n  E31 =E23\r\n  F31 =F23\r\n  C33 =+C26*C32\r\n  D33 =+D26*D32\r\n  E33 =+E26*E32\r\n  F33 =+F26*F32\r\n  C35 =SUM(C33:F"]
[71.968547, "o", "33)\r\n\r\n### SHEET Profit and Loss A1:I49 49 9 state visible\r\nMerged: []\r\nRows 1-15:\r\n  1 [('B1', 'f', \"=+'Model Inputs'!B1\")]\r\n  2 [('B2', 'f', \"=+'Model Inputs'!B2\")]\r\n  3 [('B3', 's', 'Profit and loss projections')]\r\n  6 [('B6', 's', 'Year-by-year profit and loss assumptions')]\r\n  7 [('E7', 's', 'Year 1'), ('F7', 's', 'Year 2'), ('G7', 's', 'Year 3'), ('H7', 's', 'Year 4'), ('I7', 's', 'Year 5')]\r\n  8 [('C8', 's', 'Annual cumulative price (revenue) increase'), ('E8', 's', '-'), ('F8', 'n', 0.02), ('G8', 'n', 0.04), ('H8', 'n', 0.06), ('I8', 'n', 0.08)]\r\n  9 [('C9', 's', 'Annual cumulative inflation (expense) increase'), ('E9', 's', '-'), ('F9', 'n', 0.02), ('G9', 'n', 0.04), ('H9', 'n', 0.06), ('I9', 'n', 0.08)]\r\n  10 [('C10', 's', 'Interest rate on ending cash balance'), ('E10', 'n', 0.005), ('F10', 'n', 0.005), ('G10', 'n', 0.005), ('H10', 'n', 0.005), ('I10', 'n', 0.005)]\r\n"]

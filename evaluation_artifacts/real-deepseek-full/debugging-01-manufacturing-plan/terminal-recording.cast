[21.753744, "i", "python3 - <<'PY'\nimport openpyxl\nwb = openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    print('SHEET', ws.title, ws.dimensions, ws.max_row, ws.max_column)\n    print('merge', list(ws.merged_cells.ranges))\n    # print first 60 non-empty cells and rows containing formulas in columns outside main body\n    printed=set()\n    for row in ws.iter_rows():\n        for c in row:\n            if c.value is not None:\n                if row[0].row <= 40 or c.data_type=='f':\n                    key=(row[0].row,len([x for x in row if x.value is not None]))\n                    if key not in printed:\n                        printed.add(key)\n                        vals=[(cc.coordinate, cc.data_type, cc.value) for cc in row if cc.value is not None][:20]\n                        print('ROW', row[0].row, vals)\n                else:\n                    break\n            else:\n                break\n    # count formula cells by column and rows\n    from collections import Counter\n    counts=Co"]

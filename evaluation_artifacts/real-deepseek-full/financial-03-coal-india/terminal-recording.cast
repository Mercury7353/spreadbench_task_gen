[555.605473, "i", "python3 - <<'PY'\nimport openpyxl, os\nfrom openpyxl.utils import get_column_letter\nwb=openpyxl.load_workbook('/workspace/output.xlsx', data_only=False)\nlog=[]\n\ndef setf(sheet,r,c,val):\n    ws=wb[sheet]\n    if ws.cell(r,c).value is None:\n        ws.cell(r,c).value=val\n        log.append((sheet,get_column_letter(c)+str(r),val))\n\n# CF row-specific visible fills\nsetf('CF',4,7, '=BS!G4')\nsetf('CF',7,7, \"='P&L'!G52\")\nsetf('CF',10,11, '=BS!K13-BS!J13')\nsetf('CF',13,8, '=BS!H21-BS!G21')\nsetf('CF',13,12, '=BS!L21-BS!K21')\nsetf('CF',14,9, '=BS!I23-BS!H23')\nsetf('CF',14,12, '=BS!L23-BS!K23')\nsetf('CF',15,11, '=BS!K31-BS!J31')\nsetf('CF',16,14, '=BS!N32-BS!M32')\nsetf('CF',21,9, '=-(BS!I7-BS!H7)')\nsetf('CF',21,10, '=-(BS!J7-BS!I7)')\nsetf('CF',24,10, '=-(BS!J12-BS!I12)')\nsetf('CF',26,8, '=-(BS!H17-BS!G17)')\nsetf('CF',26,12, '=-(BS!L17-BS!K17)')\nsetf('CF',32,12, \"=-'P&L'!L64\")\n\n# Reserves row-specific fills visible in change patterns\nsetf('Reserves',4,8, '=BS!H4')\nsetf('Reserves',4,12, '=BS!L4')\nsetf('Reserves',4,14, '=BS!N4'"]

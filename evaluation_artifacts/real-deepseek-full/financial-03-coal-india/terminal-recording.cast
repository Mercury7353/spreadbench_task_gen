[521.257257, "o", "\u001b[?2004l\r\u001b[?2004h> # row22 cash, M missing\r\n\u001b[?2004l\r\u001b[?2004h> set_formula('BS',22,13, '=CF!M39+L22')\r\n\u001b[?2004l\r\u001b[?2004h> # row29 secured loans, H/J/L missing, use Debt Schedule same col\r\n\u001b[?2004l\r\u001b[?2004h> for col in [8,10,12]:\r\n\u001b[?2004l\r\u001b[?2004h>     set_formula('BS',29,col, f\"='Debt Schedule'!{get_column_letter(col)}16\")\r\n\u001b[?2004l\r\u001b[?2004h> # row30 unsecured, J missing\r\n\u001b[?2004l\r\u001b[?2004h> set_formula('BS',30,10, \"='Debt Schedule'!J10\")\r\n\u001b[?2004l\r\u001b[?2004h> # row35 total liabilities, M missing\r\n\u001b[?2004l\r\u001b[?2004h> set_formula('BS',35,13, '=SUM(M29:M34)')\r\n\u001b[?2004l\r\u001b[?2004h> # row41 misc expenditure, H/J missing\r\n\u001b[?2004l\r\u001b[?2004h> for col in [8,10]:\r\n\u001b[?2004l\r\u001b[?2004h>     set_formula('BS',41,col, f\"=Reserves!{get_column_letter(col)}17\")\r\n\u001b[?2004l\r\u001b[?2004h> # row42 net worth, N missing\r\n\u001b[?2004l\r\u001b[?2004h> set_formula('BS',42,14, '=N39+N40-N41')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.save(OUT)\r\n\u001b[?2004l\r\u001b[?2004h> with open('/workspace/final_changes.txt','w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for x in log: f.w"]
[521.257307, "o", "rite('\\t'.join(map(str,x))+'\\n')\r\n\u001b[?2004l\r\u001b[?2004h> print('saved', os.path.getsize(OUT), len(log))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[521.42593, "o", "saved 57684 28\r\n"]

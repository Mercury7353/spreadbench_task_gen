[521.245078, "i", "python3 - <<'PY'\nimport openpyxl, os\nfrom openpyxl.utils import get_column_letter\nSRC='/workspace/input.xlsx'; OUT='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(SRC, data_only=False)\nlog=[]\n\ndef set_formula(sheet,r,c,val):\n    ws=wb[sheet]\n    if ws.cell(r,c).value is None:\n        ws.cell(r,c).value=val\n        log.append((sheet,get_column_letter(c)+str(r),val))\n\n# P&L patterns\npl=wb['P&L']\n# row18: percent of sales template, L missing\nL_co=c=12\nfor col in [12]:\n    set_formula('P&L',18,col, f'=Assumptions!{get_column_letter(col)}25*{get_column_letter(col)}7')\n# row25 Depreciation: L/M missing, template = prev/BS!prev*BS!?; K already =J25/BS!J7*BS!K7, L should =K25/BS!K7*BS!L7, M should =L25/BS!L7*BS!M7\nfor col in [12,13]:\n    prev=col-1\n    set_formula('P&L',25,col, f'={get_column_letter(prev)}25/BS!{get_column_letter(prev)}7*BS!{get_column_letter(col)}7')\n# row30 profit = sales - costs, M missing\nset_formula('P&L',30,13, f'=M11-M28')\n# row42 PAT after extra, I missing\nset_formula('P&L',42,9, '=I40+I41"]
[521.249967, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl, os\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl.utils import get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h> SRC='/workspace/input.xlsx'; OUT='/workspace/output.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(SRC, data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> log=[]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def set_formula(sheet,r,c,val):\r\n\u001b[?2004l\r\u001b[?2004h>     ws=wb[sheet]\r\n\u001b[?2004l\r\u001b[?2004h>     if ws.cell(r,c).value is None:\r\n\u001b[?2004l\r\u001b[?2004h>         ws.cell(r,c).value=val\r\n\u001b[?2004l\r\u001b[?2004h>         log.append((sheet,get_column_letter(c)+str(r),val))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # P&L patterns\r\n\u001b[?2004l\r\u001b[?2004h> pl=wb['P&L']\r\n\u001b[?2004l\r\u001b[?2004h> # row18: percent of sales template, L missing\r\n\u001b[?2004l\r\u001b[?2004h> L_co=c=12\r\n\u001b[?2004l\r\u001b[?2004h> for col in [12]:\r\n\u001b[?2004l\r\u001b[?2004h>     set_formula('P&L',18,col, f'=Assumptions!{get_column_letter(col)}25*{get_column_letter(col)}7')\r\n\u001b[?2004l\r\u001b[?2004h> # row25 Depreciation: L/M missing, template = prev/BS!prev*BS!?; K alre"]
[521.250634, "i", "')\n# row50 total adjustments, J missing\nset_formula('P&L',50,10, '=SUM(J45:J49)')\n# row52 restated, L missing\nset_formula('P&L',52,12, '=L42+L50')\n# row54 previous year carry forward, I missing\nset_formula('P&L',54,9, '=H66')\n# row56 available for appropriation, G and L missing\nset_formula('P&L',56,7, '=G52+G54+G55')\nset_formula('P&L',56,12, '=L52+L54+L55')\n# row59 transfer reserve FX, L missing per template K:=J59, M:=L59, N:=M59, O:=N59 => L:=K59\nset_formula('P&L',59,12, '=K59')\n# row63 tax on dividend: M missing, template from N/O etc: M should =AVERAGE(L63/L62,K63/K62,J63/J62,I63/I62,H63/H62)*M62\nset_formula('P&L',63,13, '=AVERAGE(L63/L62,K63/K62,J63/J62,I63/I62,H63/H62)*M62')\n# row64 total appropriations, I missing based on adjacent sum\nset_formula('P&L',64,9, '=SUM(I59:I63)')\n# row66 balance carried, I,J,K missing\nfor col in [9,10,11]:\n    set_formula('P&L',66,col, f'={get_column_letter(col)}56-{get_column_letter(col)}64')\n\n# BS patterns\n# row4 links, J missing\nset_formula('BS',4,10, \"='P&L'!J4\")\n# row1"]
[521.251063, "o", "ady =J25/BS!J7*BS!K7, L should =K25/BS!K7*BS!L7, M should =L25/BS!L7*BS!M7\r\n\u001b[?2004l\r\u001b[?2004h> for col in [12,13]:\r\n\u001b[?2004l\r\u001b[?2004h>     prev=col-1\r\n\u001b[?2004l\r\u001b[?2004h>     set_formula('P&L',25,col, f'={get_column_letter(prev)}25/BS!{get_column_letter(prev)}7*BS!{get_column_letter(col)}7')\r\n\u001b[?2004l\r\u001b[?2004h> # row30 profit = sales - costs, M missing\r\n\u001b[?2004l\r\u001b[?2004h> set_formula('P&L',30,13, f'=M11-M28')\r\n\u001b[?2004l\r\u001b[?2004h> # row42 PAT after extra, I missing\r\n\u001b[?2004l\r\u001b[?2004h> set_formula('P&L',42,9, '=I40+I41')\r\n\u001b[?2004l\r\u001b[?2004h> # row50 total adjustments, J missing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.25131, "i", "0 other provisions, J missing\nset_formula('BS',10,10, \"='Asset Schedule'!J15\")\n# row13 surveyed off assets, L missing\nset_formula('BS',13,12, '=Assumptions!L54*L11')\n# row20 inventories, L missing based on K/M template: L = 2*Assumptions!L60*(P&L L14+L15)/365 - BS K20\nset_formula('BS',20,12, \"=2*Assumptions!L60*('P&L'!L14+'P&L'!L15)/365-BS!K20\")\n# row22 cash, M missing\nset_formula('BS',22,13, '=CF!M39+L22')\n# row29 secured loans, H/J/L missing, use Debt Schedule same col\nfor col in [8,10,12]:\n    set_formula('BS',29,col, f\"='Debt Schedule'!{get_column_letter(col)}16\")\n# row30 unsecured, J missing\nset_formula('BS',30,10, \"='Debt Schedule'!J10\")\n# row35 total liabilities, M missing\nset_formula('BS',35,13, '=SUM(M29:M34)')\n# row41 misc expenditure, H/J missing\nfor col in [8,10]:\n    set_formula('BS',41,col, f\"=Reserves!{get_column_letter(col)}17\")\n# row42 net worth, N missing\nset_formula('BS',42,14, '=N39+N40-N41')\n\nwb.save(OUT)\nwith open('/workspace/final_changes.txt','w') as f:\n    for x in log: f.write('\\t'.j"]
[521.251326, "o", "set_formula('P&L',50,10, '=SUM(J45:J49)')\r\n"]

[480.958609, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/output.xlsx', data_only=False)\nws=wb['Assumptions']\n# Specific rows/cells that we filled with forecast formulas using wrong prefix, from earlier change log\nfixes = {\n (7,14): 7, (16,15): 16, (37,11): 37, (51,13): 51, (60,13): 60, (60,15): 60, (63,13): 63, (66,12): 66, (69,11): 69\n}\nfor (r,c), row in fixes.items():\n    v=ws.cell(r,c).value\n    if isinstance(v,str) and '$F'+str(r) in v:\n        ws.cell(r,c).value=v.replace('$F'+str(r), '$E'+str(row))\n    if isinstance(v,str) and '$D'+str(r) in v:\n        ws.cell(r,c).value=v.replace('$D'+str(r), '$E'+str(row))\nwb.save('/workspace/output.xlsx')\nprint('saved')\nPY\n"]

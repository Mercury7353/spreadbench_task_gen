[590.445107, "i", "python3 - <<'PY'\nimport openpyxl, os\np='/workspace/output.xlsx'\nprint('exists', os.path.exists(p), 'size', os.path.getsize(p) if os.path.exists(p) else 0)\nif os.path.exists(p):\n wb=openpyxl.load_workbook(p, data_only=False)\n for ws in wb.worksheets:\n  nf=sum(1 for row in ws.iter_rows() for c in row if isinstance(c.value,str) and c.value.startswith('='))\n  print(ws.title, nf)\nPY\n"]

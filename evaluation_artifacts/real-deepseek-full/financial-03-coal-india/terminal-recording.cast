[452.131716, "o", "\u001b[?2004h> "]
[452.131752, "o", "    for c in range(6,16):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.1318, "o", "        v=ws.cell(r,c).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.131863, "o", "        if isinstance(v,str) and v.startswith('='):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.131894, "o", "            fs[c]=v\r\n\u001b[?2004l\r\u001b[?2004h"]
[452.131906, "o", "> "]
[452.131965, "o", "            if 'AVERAGE' in v: fc[c]=v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.132046, "o", "            elif v.startswith('=CF!'): links[c]=v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.132084, "o", "            else: actual[c]=v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.132135, "o", "    if not fs: continue"]
[452.132204, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.132218, "o", "    if links:\r\n\u001b[?2004l\r"]
[452.132273, "o", "\u001b[?2004h>         for c in range(6,16):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.132327, "o", "            if ws.cell(r,c).value: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[452.132332, "o", "> "]
[452.13249, "o", "            left=[x for x in links if x<c]; right=[x for x in links if x>c]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.132566, "o", "            pairs=left+right\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.132619, "o", "            if not pairs: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.132756, "o", "            sc=max(left) if left else min(right); nf=shift(links[sc], sc, c, r)\r\n\u001b[?2004l\r"]
[452.132801, "o", "\u001b[?2004h> "]
[452.132953, "o", "            if '#REF!' not in nf: ws.cell(r,c).value=nf; log.append(('link',r,c,nf))\r\n\u001b[?2004l\r"]
[452.132997, "o", "\u001b[?2004h> "]
[452.133042, "o", "    if actual:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.133091, "o", "        for c in range(7,11):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.133164, "o", "            if ws.cell(r,c).value: continue\r\n\u001b[?2004l\r"]
[452.133178, "o", "\u001b[?2004h> "]
[452.133326, "o", "            left=[x for x in actual if x<c]; right=[x for x in actual if x>c]\r\n\u001b[?2004l\r"]
[452.133369, "o", "\u001b[?2004h> "]
[452.133406, "o", "            pairs=left+right\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.13347, "o", "            if not pairs: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.133638, "o", "            sc=max(left) if left else min(right); nf=shift(actual[sc], sc, c, r)\r\n\u001b[?2004l\r\u001b[?2004h"]
[452.133647, "o", "> "]
[452.133819, "o", "            if '#REF!' not in nf: ws.cell(r,c).value=nf; log.append(('actual',r,c,nf))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.133853, "o", "    if fc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.133907, "o", "        for c in range(11,16):\r\n\u001b[?2004l\r"]
[452.133952, "o", "\u001b[?2004h> "]
[452.133995, "o", "            if ws.cell(r,c).value: continue\r\n\u001b[?2004l\r"]
[452.134036, "o", "\u001b[?2004h> "]
[452.134119, "o", "            left=[x for x in fc if x<c]; right=[x for x in fc if x>c]\r\n\u001b[?2004l\r"]
[452.134174, "o", "\u001b[?2004h> "]
[452.134253, "o", "            pairs=left+right\r\n\u001b[?2004l\r\u001b[?2004h> "]
[452.134293, "o", "            if not pairs: continue\r\n\u001b[?2004l\r"]
[452.134312, "o", "\u001b[?2004h> "]
[452.134453, "o", "            sc=max(left) if left else min(right); nf=shift(fc[sc], sc, c, r)\r\n\u001b[?2004l\r\u001b[?2004h"]
[452.134521, "o", "> "]
[452.134601, "o", "            if '#REF!' not in nf: ws.cell(r,c).value=nf; log.append(('fc',r,c,nf))\r\n\u001b[?2004l\r\u001b[?2004h"]
[452.134614, "o", "> "]

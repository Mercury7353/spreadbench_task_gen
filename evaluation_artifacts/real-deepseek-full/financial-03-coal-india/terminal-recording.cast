[404.954818, "o", "    dc=tc-sc\r\n\u001b[?2004l\r\u001b[?2004h>     def sh(m):\r\n\u001b[?2004l\r\u001b[?2004h>         ref=m.group(0)\r\n\u001b[?2004l\r\u001b[?2004h>         mm=re.fullmatch(r'(\\$?)([A-Za-z]{1,3})(\\$?)([0-9]+)', ref)\r\n\u001b[?2004l\r\u001b[?2004h>         if not mm: return ref\r\n\u001b[?2004l\r\u001b[?2004h>         pre,letters,post,rows=mm.groups()\r\n\u001b[?2004l\r\u001b[?2004h>         ncol=colnum(letters)+dc; nrow=int(rows)\r\n\u001b[?2004l\r\u001b[?2004h>         if ncol<1 or nrow<1: return '#REF!'\r\n\u001b[?2004l\r\u001b[?2004h>         return pre+get_column_letter(ncol)+post+str(nrow)\r\n\u001b[?2004l\r\u001b[?2004h>     return re.sub(r'\\$?[A-Za-z]{1,3}\\$?[0-9]+', sh, f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ws=wb['Assumptions']\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(1, ws.max_row+1):\r\n\u001b[?2004l\r\u001b[?2004h> "]

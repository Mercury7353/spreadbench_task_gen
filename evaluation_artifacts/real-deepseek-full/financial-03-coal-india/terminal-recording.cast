[92.035227, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nlines=[]\nfor ws in wb.worksheets:\n    lines.append('SHEET '+ws.title+' '+str(ws.max_row)+'x'+str(ws.max_column)+' merges '+str(len(ws.merged_cells.ranges)))\n    formulas=[]; blanks=[]; vals=[]\n    for row in ws.iter_rows():\n        for c in row:\n            if c.value is None:\n                blanks.append(c.coordinate)\n            elif isinstance(c.value,str) and c.value.startswith('='):\n                formulas.append(c.coordinate+': '+c.value)\n            else:\n                vals.append(c.coordinate+': '+repr(c.value)[:80])\n    lines.append('FORMULAS '+str(len(formulas)))\n    lines += formulas[:500]\n    lines.append('BLANKS '+str(len(blanks))+' first '+','.join(blanks[:100]))\n    lines.append('VALUES '+str(len(vals))+' first')\n    lines += vals[:80]\nopen('/workspace/info.txt','w').write('\\n'.join(lines))\nprint('OK')\nPY\n"]

[311.810988, "i", "python3 - <<'PY'\nimport openpyxl, re, os\nfrom openpyxl.utils import get_column_letter\nSRC='/workspace/input.xlsx'\nOUT='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(SRC, data_only=False)\nlog=[]\n\ndef colnum(s):\n    n=0\n    for ch in s: n=n*26+(ord(ch)-64)\n    return n\n\ndef shift(f, sc, tc, r):\n    dc=tc-sc\n    def sh(m):\n        ref=m.group(0)\n        mm=re.fullmatch(r'(\\$?)([A-Za-z]{1,3})(\\$?)([0-9]+)', ref)\n        if not mm: return ref\n        pre,letters,post,rows=mm.groups()\n        ncol=colnum(letters)+dc; nrow=int(rows)\n        if ncol<1 or nrow<1: return '#REF!'\n        return pre+get_column_letter(ncol)+post+str(nrow)\n    return re.sub(r'\\$?[A-Za-z]{1,3}\\$?[0-9]+', sh, f)\n\nfor ws in wb.worksheets:\n    if ws.title in ('Cover','ReadMeFirst','Disclaimer'): continue\n    if ws.title=='Assumptions':\n        cols=range(7,16)  # G:O\n    elif ws.title in ('P&L','BS','CF','Reserves','Debt Schedule','Asset Schedule','Valuation'):\n        cols=range(1, ws.max_column+1)\n    else:\n        cols=range(1, ws.max_c"]
[311.811738, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl, re, os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[311.811766, "i", "olumn+1)\n    for r in range(1, ws.max_row+1):\n        fm={}\n        for c in cols:\n            v=ws.cell(r,c).value\n            if isinstance(v,str) and v.startswith('='): fm[c]=v\n        if not fm:\n            continue\n        lo=min(fm); hi=max(fm)\n        if ws.title=='Assumptions':\n            lo=min(lo,7); hi=max(hi,15)\n        for c in range(lo, hi+1):\n            if ws.cell(r,c).value is not None: continue\n            left=[x for x in fm if x<c]\n            right=[x for x in fm if x>c]\n            if not left and not right: continue\n            sc=max(left) if left else min(right)\n            nf=shift(fm[sc], sc, c, r)\n            if '#REF!' not in nf:\n                ws.cell(r,c).value=nf\n                log.append((ws.title,get_column_letter(c)+str(r),get_column_letter(sc)+str(r),nf))\n\nwb.save(OUT)\nwith open('/workspace/final_changes.txt','w') as f:\n    for x in log: f.write('\\t'.join(map(str,x))+'\\n')\nprint('saved', os.path.getsize(OUT), 'changes', len(log))\nPY\n"]

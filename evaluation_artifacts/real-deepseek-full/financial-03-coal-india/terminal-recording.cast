[501.171956, "i", "python3 - <<'PY'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nfor sn in ['P&L','BS']:\n ws=wb[sn]\n print('###',sn)\n for r in range(1, ws.max_row+1):\n  fs=[get_column_letter(c)+':'+str(ws.cell(r,c).value) for c in range(1,ws.max_column+1) if isinstance(ws.cell(r,c).value,str) and ws.cell(r,c).value.startswith('=')]\n  if fs:\n   print(r, ' | '.join(fs))\nPY\n"]
[501.172881, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl.utils import get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> for sn in ['P&L','BS']:\r\n\u001b[?2004l\r\u001b[?2004h>  ws=wb[sn]\r\n\u001b[?2004l\r\u001b[?2004h>  print('###',sn)\r\n\u001b[?2004l\r\u001b[?2004h>  for r in range(1, ws.max_row+1):\r\n\u001b[?2004l\r\u001b[?2004h>   fs=[get_column_letter(c)+':'+str(ws.cell(r,c).value) for c in range(1,ws.max_column+1) if isinstance(ws.cell(r,c).value,str) and ws.cell(r,c).value.startswith('=')]\r\n\u001b[?2004l\r\u001b[?2004h>   if fs:\r\n\u001b[?2004l\r\u001b[?2004h>    print(r, ' | '.join(fs))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

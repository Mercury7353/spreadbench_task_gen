[404.952241, "i", "python3 - <<'PY'\nimport openpyxl, re, os\nfrom openpyxl.utils import get_column_letter\nSRC='/workspace/input.xlsx'; OUT='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(SRC, data_only=False)\nlog=[]\n\ndef colnum(s):\n    n=0\n    for ch in s: n=n*26+(ord(ch)-64)\n    return n\n\ndef shift(f, sc, tc, r):\n    dc=tc-sc\n    def sh(m):\n        ref=m.group(0)\n        mm=re.fullmatch(r'(\\$?)([A-Za-z]{1,3})(\\$?)([0-9]+)', ref)\n        if not mm: return ref\n        pre,letters,post,rows=mm.groups()\n        ncol=colnum(letters)+dc; nrow=int(rows)\n        if ncol<1 or nrow<1: return '#REF!'\n        return pre+get_column_letter(ncol)+post+str(nrow)\n    return re.sub(r'\\$?[A-Za-z]{1,3}\\$?[0-9]+', sh, f)\n\nws=wb['Assumptions']\nfor r in range(1, ws.max_row+1):\n    fs={}; actual={}; fc={}; links={}\n    for c in range(6,16):\n        v=ws.cell(r,c).value\n        if isinstance(v,str) and v.startswith('='):\n            fs[c]=v\n            if 'AVERAGE' in v: fc[c]=v\n            elif v.startswith('=CF!'): links[c]=v\n            else: act"]
[404.952787, "i", "ual[c]=v\n    if not fs: continue\n    if links:\n        for c in range(6,16):\n            if ws.cell(r,c).value: continue\n            left=[x for x in links if x<c]; right=[x for x in links if x>c]\n            pairs=left+right\n            if not pairs: continue\n            sc=max(left) if left else min(right)\n            nf=shift(links[sc], sc, c, r)\n            if '#REF!' not in nf:\n                ws.cell(r,c).value=nf; log.append(('link',r,c,nf))\n    if actual:\n        for c in range(7,11):\n            if ws.cell(r,c).value: continue\n            left=[x for x in actual if x<c]; right=[x for x in actual if x>c]\n            pairs=left+right\n            if not pairs: continue\n            sc=max(left) if left else min(right)\n            nf=shift(actual[sc], sc, c, r)\n            if '#REF!' not in nf:\n                ws.cell(r,c).value=nf; log.append(('actual',r,c,nf))\n    if fc:\n        for c in range(11,16):\n            if ws.cell(r,c).value: continue\n            left=[x for x in fc if x<c]; right=[x for x in "]
[404.952816, "i", "fc if x>c]\n            pairs=left+right\n            if not pairs: continue\n            sc=max(left) if left else min(right)\n            nf=shift(fc[sc], sc, c, r)\n            if '#REF!' not in nf:\n                ws.cell(r,c).value=nf; log.append(('fc',r,c,nf))\n\nwb.save(OUT)\nwith open('/workspace/assump_changes2.txt','w') as f:\n    for x in log: f.write('\\t'.join(map(str,x))+'\\n')\nprint('saved', os.path.getsize(OUT), 'changes', len(log))\nPY\n"]

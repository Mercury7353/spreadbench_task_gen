[419.048008, "o", "link\t4\t13\t=CF!M4\r\nlink\t4\t14\t=CF!N4\r\nfc\t7\t14\t=IF($F7=\"CAGR\",AVERAGE(J7:M7),N6/100)\r\nactual\t10\t7\t='P&L'!G10/'P&L'!F10-1\r\nactual\t13\t10\t='P&L'!J14/'P&L'!I14-1\r\nfc\t16\t15\t=IF($F16=\"CAGR\",AVERAGE(K16:N16),O15/100)\r\nactual\t19\t8\t='P&L'!H16/'P&L'!G16-1\r\nactual\t22\t7\t='P&L'!G17/'P&L'!G7\r\nactual\t28\t9\t='P&L'!I19/'P&L'!I7\r\nactual\t31\t10\t='P&L'!J20/'P&L'!J7\r\nfc\t37\t11\t=IF($D37=\"CAGR\",AVERAGE(G37:J37),K36/100)\r\nactual\t40\t10\t='P&L'!J24/'P&L'!I24-1\r\nfc\t51\t13\t=IF($F51=\"CAGR\",AVERAGE(I51:L51),M50/100)\r\nactual\t57\t10\t=BS!J21/BS!J7\r\nfc\t60\t13\t=IF($F60=\"CAGR\",AVERAGE(I60:L60),M59)\r\nfc\t60\t15\t=IF($F60=\"CAGR\",AVERAGE(K60:N60),O59)\r\nfc\t63\t13\t=IF($F63=\"CAGR\",AVERAGE(I63:L63),M62/100)\r\nactual\t66\t10\t=BS!J31/BS!J7\r\nfc\t66\t12\t=IF($F66=\"CAGR\",AVERAGE(H66:K66),L65/100)\r\nfc\t69\t11\t=IF($D69=\"CAGR\",AVERAGE(G69:J69),K68/100)\r\n\r\n"]
[419.063006, "o", "\u001b[?2004hroot@dff243765408:/workspace# "]
[434.926302, "i", "python3 - <<'PY'\nimport openpyxl, re\nfrom openpyxl.utils import get_column_letter\nwb=openpyxl.load_workbook('/workspace/output.xlsx', data_only=False)\nws=wb['Assumptions']\n\n# Inspect existing forecast formulas per row to infer correct $E/$D column prefix\nfor r in range(1, ws.max_row+1):\n    fcs=[]\n    for c in range(11,16):\n        v=ws.cell(r,c).value\n        if isinstance(v,str) and 'AVERAGE' in v:\n            fcs.append(v)\n    if not fcs:\n        continue\n    prefix='E'\n    for f in fcs:\n        m=re.search(r'\\$(E|F|D)(\\d+)=\"CAGR\"', f)\n        if m:\n            prefix=m.group(1)\n            break\n    # Normalize all CAGR test references in the row's K:O cells to prefix\n    for c in range(11,16):\n        v=ws.cell(r,c).value\n        if isinstance(v,str) and 'AVERAGE' in v:\n            v2=re.sub(r'\\$(E|F|D)(\\d+)=\"CAGR\"', '$'+prefix+r'=\"CAGR\"', v)\n            if v2 != v:\n                print('fix', r, c, v, '->', v2)\n                ws.cell(r,c).value=v2\n\nwb.save('/workspace/output.xlsx')\nprint('done')\nPY\n"]

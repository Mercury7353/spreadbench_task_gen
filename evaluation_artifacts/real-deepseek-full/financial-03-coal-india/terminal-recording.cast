[282.028797, "i", "python3 - <<'PY'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nlines=[]\nfor ws in wb.worksheets:\n    if ws.title in ('Cover','ReadMeFirst','Disclaimer'): continue\n    lines.append('### '+ws.title)\n    for r in range(1, ws.max_row+1):\n        fm=[]; label=None\n        for c in range(1, ws.max_column+1):\n            v=ws.cell(r,c).value\n            if label is None and isinstance(v,str) and not v.startswith('='):\n                label=v[:50]\n            if isinstance(v,str) and v.startswith('='):\n                fm.append(get_column_letter(c))\n        if label or fm:\n            lines.append(f'{r}: {label!r} F={','.join(fm)}')\nopen('/workspace/matrix.txt','w').write('\\n'.join(lines))\nprint('wrote')\nPY\nsed -n '1,80p' /workspace/matrix.txt\n"]

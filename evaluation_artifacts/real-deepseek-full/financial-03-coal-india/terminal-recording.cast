[612.563319, "i", "python3 - <<'PY'\nimport openpyxl, re, os\nfrom openpyxl.utils import get_column_letter\nSRC='/workspace/output.xlsx'; OUT='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(SRC, data_only=False)\ndef colnum(s):\n n=0\n for ch in s: n=n*26+(ord(ch)-64)\n return n\ndef shift(f, sc, tc, r):\n dc=tc-sc\n def sh(m):\n  ref=m.group(0); mm=re.fullmatch(r'(\\$?)([A-Za-z]{1,3})(\\$?)([0-9]+)', ref)\n  if not mm: return ref\n  pre,letters,post,rows=mm.groups(); ncol=colnum(letters)+dc; nrow=int(rows)\n  if ncol<1 or nrow<1: return '#REF!'\n  return pre+get_column_letter(ncol)+post+str(nrow)\n return re.sub(r'\\$?[A-Za-z]{1,3}\\$?[0-9]+', sh, f)\nws=wb['Assumptions']\nlog=[]\nfor r in range(1, ws.max_row+1):\n fs={}; actual={}; fc={}; links={}\n for c in range(6,16):\n  v=ws.cell(r,c).value\n  if isinstance(v,str) and v.startswith('='):\n   fs[c]=v\n   if 'AVERAGE' in v: fc[c]=v\n   elif v.startswith('=CF!'): links[c]=v\n   else: actual[c]=v\n if not fs: continue\n if links:\n  for c in range(6,16):\n   if ws.cell(r,c).value: continue\n   left=[x for x i"]
[612.569148, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl, re, os\r\n\u001b[?2004l\r"]
[612.569195, "i", "n links if x<c]; right=[x for x in links if x>c]\n   pairs=left+right\n   if not pairs: continue\n   sc=max(left) if left else min(right); nf=shift(links[sc], sc, c, r)\n   if '#REF!' not in nf: ws.cell(r,c).value=nf; log.append(('link',r,c,nf))\n if actual:\n  for c in range(7,11):\n   if ws.cell(r,c).value: continue\n   left=[x for x in actual if x<c]; right=[x for x in actual if x>c]\n   pairs=left+right\n   if not pairs: continue\n   sc=max(left) if left else min(right); nf=shift(actual[sc], sc, c, r)\n   if '#REF!' not in nf: ws.cell(r,c).value=nf; log.append(('actual',r,c,nf))\n if fc:\n  for c in range(11,16):\n   if ws.cell(r,c).value: continue\n   left=[x for x in fc if x<c]; right=[x for x in fc if x>c]\n   pairs=left+right\n   if not pairs: continue\n   sc=max(left) if left else min(right); nf=shift(fc[sc], sc, c, r)\n   if '#REF!' not in nf: ws.cell(r,c).value=nf; log.append(('fc',r,c,nf))\n# fix wrong CAGR prefixes for filled formulas\nfixes={(7,14):7,(16,15):16,(37,11):37,(51,13):51,(60,13):60,(60,15):60,(63,13):63,("]
[612.573023, "o", "\u001b[?2004h> from openpyxl.utils import get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h> SRC='/workspace/output.xlsx'; OUT='/workspace/output.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(SRC, data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> def colnum(s):\r\n\u001b[?2004l\r\u001b[?2004h>  n=0\r\n\u001b[?2004l\r\u001b[?2004h>  for ch in s: n=n*26+(ord(ch)-64)\r\n\u001b[?2004l\r\u001b[?2004h>  return n\r\n\u001b[?2004l\r\u001b[?2004h> def shift(f, sc, tc, r):\r\n\u001b[?2004l\r\u001b[?2004h>  dc=tc-sc\r\n\u001b[?2004l\r\u001b[?2004h>  def sh(m):\r\n\u001b[?2004l\r\u001b[?2004h>   ref=m.group(0); mm=re.fullmatch(r'(\\$?)([A-Za-z]{1,3})(\\$?)([0-9]+)', ref)\r\n\u001b[?2004l\r\u001b[?2004h>   if not mm: return ref\r\n\u001b[?2004l\r\u001b[?2004h>   pre,letters,post,rows=mm.groups(); ncol=colnum(letters)+dc; nrow=int(rows)\r\n\u001b[?2004l\r\u001b[?2004h>   if ncol<1 or nrow<1: return '#REF!'\r\n\u001b[?2004l\r\u001b[?2004h>   return pre+get_column_letter(ncol)+post+str(nrow)\r\n\u001b[?2004l\r\u001b[?2004h>  return re.sub(r'\\$?[A-Za-z]{1,3}\\$?[0-9]+', sh, f)\r\n"]
[612.57342, "i", "66,12):66,(69,11):69}\nfor (r,c),row in fixes.items():\n v=ws.cell(r,c).value\n if isinstance(v,str) and '$F'+str(r) in v: ws.cell(r,c).value=v.replace('$F'+str(r),'$E'+str(row))\n if isinstance(v,str) and '$D'+str(r) in v: ws.cell(r,c).value=v.replace('$D'+str(r),'$E'+str(row))\nwb.save(OUT)\nprint('saved', os.path.getsize(OUT), 'changes', len(log))\nPY\n"]
[612.574413, "o", "\u001b[?2004l\r\u001b[?2004h> ws=wb['Assumptions']\r\n\u001b[?2004l\r\u001b[?2004h> log=[]\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(1, ws.max_row+1):\r\n\u001b[?2004l\r\u001b[?2004h>  fs={}; actual={}; fc={}; links={}\r\n\u001b[?2004l\r\u001b[?2004h>  for c in range(6,16):\r\n\u001b[?2004l\r\u001b[?2004h>   v=ws.cell(r,c).value\r\n\u001b[?2004l\r\u001b[?2004h>   if isinstance(v,str) and v.startswith('='):\r\n\u001b[?2004l\r\u001b[?2004h>    fs[c]=v\r\n\u001b[?2004l\r\u001b[?2004h>    if 'AVERAGE' in v: fc[c]=v\r\n\u001b[?2004l\r\u001b[?2004h>    elif v.startswith('=CF!'): links[c]=v\r\n\u001b[?2004l\r\u001b[?2004h>    else: actual[c]=v\r\n\u001b[?2004l\r\u001b[?2004h>  if not fs: continue\r\n\u001b[?2004l\r\u001b[?2004h>  if links:\r\n\u001b[?2004l\r\u001b[?2004h>   for c in range(6,16):\r\n\u001b[?2004l\r\u001b[?2004h>    if ws.cell(r,c).value: continue\r\n\u001b[?2004l\r\u001b[?2004h>    left=[x for x in links if x<c]; right=[x for x in links if x>c]\r\n\u001b[?2004l\r\u001b[?2004h>    pairs=left+right\r\n\u001b[?2004l\r\u001b[?2004h>    if not pairs: continue\r\n\u001b[?2004l\r\u001b[?2004h>    sc=max(left) if left else min(right); nf=shift(links[sc], sc, c, r)\r\n\u001b[?2004l\r\u001b[?2004h>    if '#REF!' not in nf: ws.cell(r,c).value=nf; log.append("]

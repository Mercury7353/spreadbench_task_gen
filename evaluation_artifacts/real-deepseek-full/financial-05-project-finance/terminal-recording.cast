[51.888845, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\nwb=load_workbook('input.xlsx', data_only=False)\nfor sheet in ['Operation','Amortization']:\n    ws=wb[sheet]\n    print('\\n===', sheet, '===')\n    chunks=[('E-M',5,13),('N-V',14,22),('W-AD',23,30),('AE-AM',31,39),('AN-AR',40,44)]\n    for title,a,b in chunks:\n        print('---', title, '---')\n        for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\n            cells=[]\n            for col in range(a,b+1):\n                c=ws.cell(row=row[0].row, column=col)\n                if c.value is not None:\n                    cells.append(f'{c.coordinate}={c.value!r}')\n            if cells:\n                print('R'+str(row[0].row)+': '+' | '.join(cells))\nPY\n"]
[51.889939, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl.utils import get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook('input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> for sheet in ['Operation','Amortization']:\r\n\u001b[?2004l\r\u001b[?2004h>     ws=wb[sheet]\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n===', sheet, '===')\r\n\u001b[?2004l\r\u001b[?2004h>     chunks=[('E-M',5,13),('N-V',14,22),('W-AD',23,30),('AE-AM',31,39),('AN-AR',40,44)]\r\n\u001b[?2004l\r\u001b[?2004h>     for title,a,b in chunks:\r\n\u001b[?2004l\r\u001b[?2004h>         print('---', title, '---')\r\n\u001b[?2004l\r\u001b[?2004h> "]

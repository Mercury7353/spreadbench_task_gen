[97.586897, "i", "python3 - <<'PY'\nimport re\n\ndef incr_refs(formula, dx=1):\n    # increment xl references in formula by dx. Try careful token replacement; refs can be like Construction!E26 or E$26 or $E$26\n    def repl(m):\n        pre, col, absrow, row = m.groups()\n        newcol = col if False else chr(ord(col[0])+dx) if len(col)==1 and dx small else None\n        # use openpyxl utilities\n        from openpyxl.utils import column_index_from_string, get_column_letter\n        old_col_idx = column_index_from_string(col)\n        new_col_idx = old_col_idx + dx\n        new_col = get_column_letter(new_col_idx)\n        return pre + new_col + (absrow or '') + row\n    # pattern supports single letter cols only? We need double too. It matches after optional ! and optional $, letters, optional $, digits.\n    # Use openpyxl column index.\n    pat = re.compile(r'([A-Za-z_]+!)?(\\$?)([A-Z]{1,3})(\\$?)(\\d+)')\n    def repl2(m):\n        from openpyxl.utils import column_index_from_string, get_column_letter\n        prefix = m.group(1) or ''\n       "]
[97.589481, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def incr_refs(formula, dx=1):\r\n\u001b[?2004l\r\u001b[?2004h>     # increment xl references in formula by dx. Try careful token replacement; refs can be like Construction!E26 or E$26 or $E$26\r\n\u001b[?2004l\r\u001b[?2004h>     def repl(m):\r\n\u001b[?2004l\r\u001b[?2004h>         pre, col, absrow, row = m.groups()\r\n\u001b[?2004l\r\u001b[?2004h>         newcol = col if False else chr(ord(col[0])+dx) if len(col)==1 and dx small else None\r\n\u001b[?2004l\r\u001b[?2004h>         # use openpyxl utilities\r\n\u001b[?2004l\r\u001b[?2004h>         from openpyxl.utils import column_index_from_string, get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h>         old_col_idx = column_index_from_string(col)\r\n\u001b[?2004l\r\u001b[?2004h>         new_col_idx = old_col_idx + dx\r\n\u001b[?2004l\r\u001b[?2004h>         new_col = get_column_letter(new_col_idx)\r\n\u001b[?2004l\r\u001b[?2004h>         return pre + new_col + (absrow or '') + row\r\n\u001b[?2004l\r\u001b[?2004h>     # pattern supports single letter cols only? We need double too. It matches after optional ! and"]
[97.589535, "i", " abs_col = m.group(2) or ''\n        col = m.group(3)\n        abs_row = m.group(4) or ''\n        row = m.group(5)\n        new_col = get_column_letter(column_index_from_string(col) + dx)\n        return prefix + abs_col + new_col + abs_row + row\n    return pat.sub(repl2, formula)\n\nfor f in ['=SUM(Construction!$E$26:E26)', \"='P&L'!G25+CFS!G21+'Balance Sheet'!F14\", '=E16-E28<0.01']:\n    print(f, '->', incr_refs(f,1))\nPY\n"]

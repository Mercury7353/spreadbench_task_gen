[219.416549, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('/workspace/output.xlsx', data_only=False)\nfor sheet, rows in [('CFS',[14]),('Balance Sheet',[8,9,14]),('Ratios',[16,24]),('CFS',[8,10,12,16,17,19,21,23,25]),('Balance Sheet',[13])]:\n    ws=wb[sheet]\n    for r in rows:\n        print('\\n',sheet,'R',r)\n        for col in range(5, min(ws.max_column,46)+1):\n            c=ws.cell(row=r,column=col)\n            print(c.coordinate, repr(c.value), 'fill', c.fill.patternType)\nPY\n"]
[219.41797, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook('/workspace/output.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> for sheet, rows in [('CFS',[14]),('Balance Sheet',[8,9,14]),('Ratios',[16,24]),('CFS',[8,10,12,16,17,19,21,23,25]),('Balance Sheet',[13])]:\r\n\u001b[?2004l\r\u001b[?2004h>     ws=wb[sheet]\r\n\u001b[?2004l\r\u001b[?2004h>     for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>         print('\\n',sheet,'R',r)\r\n\u001b[?2004l\r\u001b[?2004h>         for col in range(5, min(ws.max_column,46)+1):\r\n\u001b[?2004l\r\u001b[?2004h>             c=ws.cell(row=r,column=col)\r\n\u001b[?2004l\r\u001b[?2004h>             print(c.coordinate, repr(c.value), 'fill', c.fill.patternType)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

[230.950139, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\nwb=load_workbook('/workspace/output.xlsx', data_only=False)\nchecks=[('CFS',14),('Balance Sheet',8),('Balance Sheet',9),('Balance Sheet',14),('Ratios',16),('Ratios',24)]\nfor sheet,r in checks:\n    ws=wb[sheet]; row=list(ws.iter_rows(min_row=r,max_row=r))[0]\n    print('\\n',sheet,'R',r)\n    vals={c.column_letter:c.value for c in row if c.value is not None}\n    for col in range(5,ws.max_column+1):\n        L=get_column_letter(col)\n        if L not in vals:\n            prev=get_column_letter(col-1); nxt=get_column_letter(col+1)\n            print(L,'EMPTY prev%s=%r next%s=%r' % (prev,vals.get(prev),nxt,vals.get(nxt)))\nPY\n"]
[230.951518, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl.utils import get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook('/workspace/output.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]

[239.887861, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('/workspace/output.xlsx', data_only=False)\nfixes = [\n    ('CFS',14,'O','=SUM(O8:O13)'),\n    ('CFS',14,'P','=SUM(P8:P13)'),\n    ('Balance Sheet',8,'N','=Amortization!M10'),\n    ('Balance Sheet',8,'O','=Amortization!N10'),\n    ('Balance Sheet',9,'AS','=CFS!AS25'),\n    ('Ratios',16,'N',\"='P&L'!N23\"),\n    ('Ratios',16,'O',\"='P&L'!O23\"),\n]\nfor sheet,r,col,f in fixes:\n    ws=wb[sheet]\n    ws[f'{col}{r}'] = f\n    print('set',sheet,r,col,f)\nwb.save('/workspace/output.xlsx')\nprint('saved')\nPY\n"]

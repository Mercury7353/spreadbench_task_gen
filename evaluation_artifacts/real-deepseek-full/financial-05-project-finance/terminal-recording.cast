[84.452445, "o", "R14 D EMPTY; prev C='=SUM(E14:AR14)'; next E='=E38'\r\nR14 G EMPTY; prev F='=F38'; next H='=H38'"]
[84.452486, "o", "\r\nR14 Q EMPTY; prev P='=P38'; next R='=R38'\r\n"]
[84.452587, "o", "R15 D EMPTY; prev C='=SUM(E15:AR15)'; next E='=E39'\r\nR15 J EMPTY; prev I='=I39'; next K='=K39'\r\n"]
[84.452645, "o", "R16 D EMPTY; prev C='=SUM(E16:AR16)'; next E='=SUM(E12:E15)'\r\nR16 W EMPTY; prev V='=SUM(V12:V15)'; next X='=SUM(X12:X15)'\r\nR16 AG EMPTY; prev AF='=SUM(AF12:AF15)'; next AH='=SUM(AH12:AH15)'\r\n"]
[84.453599, "o", "R26 D EMPTY; prev C='=SUM(E26:AR26)'; next E='=IF(MAX($C$22-SUM($D$26:D26),0)>E19,E19,MAX($C$22-SUM($D$26:D26),0))'\r\nR26 AJ EMPTY; prev AI='=IF(MAX($C$22-SUM($D$26:AH26),0)>AI19,AI19,MAX($C$22-SUM($D$26:AH26),0))'; next AK='=IF(MAX($C$22-SUM($D$26:AJ26),0)>AK19,AK19,MAX($C$22-SUM($D$26:AJ26),0))'\r\n"]
[84.453684, "o", "R27 D EMPTY; prev C='=SUM(E27:AR27)'; next E='=IF(E19-E26>0,E19-E26,0)'\r\nR27 V EMPTY; prev U='=IF(U19-U26>0,U19-U26,0)'; next W='=IF(W19-W26>0,W19-W26,0)'\r\nR27 AK EMPTY; prev AJ='=IF(AJ19-AJ26>0,AJ19-AJ26,0)'; next AL='=IF(AL19-AL26>0,AL19-AL26,0)'\r\n"]
[84.453779, "o", "R28 D EMPTY; prev C='=SUM(E28:AR28)'; next E='=SUM(E26:E27)'\r\nR28 F EMPTY; prev E='=SUM(E26:E27)'; next G='=SUM(G26:G27)'\r\nR28 U EMPTY; prev T='=SUM(T26:T27)'; next V='=SUM(V26:V27)'\r\nR28 AE EMPTY; prev AD='=SUM(AD26:AD27)'; next AF='=SUM(AF26:AF27)'\r\n"]
[84.454534, "o", "R34 D EMPTY; prev C='=SUM(E34:AR34)'; next E='=E27'\r\nR34 Z EMPTY; prev Y='=Y27'; next AA='=AA27'\r\n"]
[84.454656, "o", "R35 U EMPTY; prev T='=SUM(T33:T34)'; next V='=SUM(V33:V34)'\r\nR35 Z EMPTY; prev Y='=SUM(Y33:Y34)'; next AA='=SUM(AA33:AA34)'\r\n"]
[84.454884, "o", "R37 T EMPTY; prev S=\"='Input Assumptions'!$D$37*Construction!$C$34*TBA!R13\"; next U=\"='Input Assumptions'!$D$37*Construction!$C$34*TBA!T13\"\r\nR37 AC EMPTY; prev AB=\"='Input Assumptions'!$D$37*Construction!$C$34*TBA!AA13\"; next AD=\"='Input Assumptions'!$D$37*Construction!$C$34*TBA!AC13\"\r\n"]
[84.454953, "o", "R38 AB EMPTY; prev AA=\"=($C$34-AA33)*TBA!Z14*'Input Assumptions'!$D$36*'Input Assumptions'!$D$38\"; next AC=\"=($C$34-AC33)*TBA!AB14*'Input Assumptions'!$D$36*'Input Assumptions'!$D$38\"\r\n"]
[84.45507, "o", "R39 L EMPTY; prev K=\"=('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*K33*TBA!J14\"; next M=\"=('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*M33*TBA!L14\"\r\n"]
[84.455107, "o", "R39 AA EMPTY; prev Z=\"=('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*Z33*TBA!Y14\"; next AB=\"=('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*AB33*TBA!AA14\"\r\nR39 AD EMPTY; prev AC=\"=('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*AC33*TBA!AB14\"; next AE=\"=('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*AE33*TBA!AD14\"\r\n"]
[84.455585, "o", "R43 AG EMPTY; prev AF='=AF16-AF28<0.01'; next AH='=AH16-AH28<0.01'\r\n\r\n=== Operation ===\r\n"]
[84.456087, "o", "R7 X EMPTY; prev W=\"='Input Assumptions'!$D$14*(1+'Input Assumptions'!$D$17)^(SUM(TBA!$D$10:'TBA'!V10)-1)*TBA!V10\"; next Y=\"='Input Assumptions'!$D$14*(1+'Input Assumptions'!$D$17)^(SUM(TBA!$D$10:'TBA'!X10)-1)*TBA!X10\"\r\n"]
[84.456194, "o", "R8 AG EMPTY; prev AF=\"='Input Assumptions'!$D$15*(1+'Input Assumptions'!$D$17)^(SUM(TBA!$D$10:'TBA'!AE10)-1)*TBA!AE10\"; next AH=\"='Input Assumptions'!$D$15*(1+'Input Assumptions'!$D$17)^(SUM(TBA!$D$10:'TBA'!AG10)-1)*TBA!AG10\"\r\n"]
[84.456402, "o", "R10 AM EMPTY; prev AL=\"=AL7*'Input Assumptions'!$D$20/1000\"; next AN=\"=AN7*'Input Assumptions'!$D$20/1000\"\r\n"]

[148.590148, "i", "cat > /tmp/fix_gaps2.py <<'PY'\nimport re\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter, column_index_from_string\n\npath='input.xlsx'\nout='output.xlsx'\nwb=load_workbook(path, data_only=False)\n\n# Regex for references: optional sheet prefix, optional $, column, optional $, digits\npat = re.compile(r'([A-Za-z_]+!|\\'[^\\']+\\'!)?(\\$?)([A-Z]{1,3})(\\$?)(\\d+)')\n\ndef shift_refs_preserve_abs(formula, dx):\n    def repl(m):\n        prefix = m.group(1) or ''\n        abs_col = m.group(2) or ''\n        col = m.group(3)\n        abs_row = m.group(4) or ''\n        row = m.group(5)\n        if abs_col:\n            return prefix + abs_col + col + abs_row + row\n        new_col = get_column_letter(column_index_from_string(col) + dx)\n        return prefix + new_col + abs_row + row\n    return pat.sub(repl, formula)\n\n# no D, no C? fill from E to max\nfilled=[]\nfor ws in wb.worksheets:\n    for r in range(1, ws.max_row+1):\n        vals = {c.column_letter: c.value for c in ws[r-1] if c.value is not None}\n    "]
[148.592111, "o", "cat > /tmp/fix_gaps2.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl.utils import get_column_letter, column_index_from_string\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> path='input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> out='output.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook(path, data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Regex for references: optional sheet prefix, optional $, column, optional $, digits\r\n\u001b[?2004l\r\u001b[?2004h> pat = re.compile(r'([A-Za-z_]+!|\\'[^\\']+\\'!)?(\\$?)([A-Z]{1,3})(\\$?)(\\d+)')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def shift_refs_preserve_abs(formula, dx):\r\n\u001b[?2004l\r\u001b[?2004h>     def repl(m):\r\n\u001b[?2004l\r\u001b[?2004h>         prefix = m.group(1) or ''\r\n\u001b[?2004l\r\u001b[?2004h>         abs_col = m.group(2) or ''\r\n\u001b[?2004l\r\u001b[?2004h>         col = m.group(3)\r\n\u001b[?2004l\r\u001b[?2004h>         abs_row = m.group(4) or ''\r\n\u001b[?2004l\r\u001b[?2004h>         row = m.group(5)\r\n\u001b[?2004l\r\u001b[?2004h>         if abs_col:\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[148.592805, "i", "    for col in range(5, ws.max_column+1):\n            L = get_column_letter(col)\n            if L in vals:\n                continue\n            prev = get_column_letter(col-1)\n            nxt = get_column_letter(col+1)\n            if prev in vals and nxt in vals:\n                left=vals[prev]; right=vals[nxt]\n                if isinstance(left,str) and left.startswith('=') and isinstance(right,str) and right.startswith('='):\n                    # Use right shifted left for running totals. For simple formulas this is same after absolute preserve.\n                    formula = shift_refs_preserve_abs(right, -1)\n                    ws.cell(row=r, column=col).value = formula\n                    filled.append((ws.title, r, L, formula))\n\nwb.save(out)\nprint('Filled', len(filled), 'Saved', out)\nfor item in filled[:20]: print(item)\n\n# print still missing between formulas (excluding D)\nprint('\\nRemaining gaps (between formulas, col E+):')\nfor ws in wb.worksheets:\n    for r in range(1, ws.max_row+1):\n        vals = {c"]
[148.59282, "o", "        return prefix + abs_col + col + abs_row + row\r\n\u001b[?2004l\r\u001b[?2004h>         new_col = get_column_letter(column_index_from_string(col) + dx)\r\n\u001b[?2004l\r\u001b[?2004h>         return prefix + new_col + abs_row + row\r\n\u001b[?2004l\r\u001b[?2004h>     return pat.sub(repl, formula)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # no D, no C? fill from E to max\r\n\u001b[?2004l\r\u001b[?2004h> filled=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.592856, "i", ".column_letter: c.value for c in ws[r-1] if c.value is not None}\n        gaps=[]\n        for col in range(5, ws.max_column+1):\n            L=get_column_letter(col)\n            if L not in vals and get_column_letter(col-1) in vals and get_column_letter(col+1) in vals:\n                left=vals[get_column_letter(col-1)]; right=vals[get_column_letter(col+1)]\n                if isinstance(left,str) and left.startswith('=') and isinstance(right,str) and right.startswith('='):\n                    gaps.append(L)\n        if gaps:\n            print(ws.title, 'R', r, ','.join(gaps))\nPY\npython3 /tmp/fix_gaps2.py\n"]

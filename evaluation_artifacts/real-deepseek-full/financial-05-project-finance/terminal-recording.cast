[207.502704, "i", "python3 - <<'PY'\nimport re\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import column_index_from_string, get_column_letter\nwb=load_workbook('/workspace/output.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    print('\\n===', ws.title, '===')\n    for r in range(1, ws.max_row+1):\n        row=list(ws.iter_rows(min_row=r, max_row=r))[0]\n        label=None\n        for c in row:\n            if c.column_letter in ('A','B','C') and c.value is not None:\n                label=str(c.value)\n                break\n        formulas=[]\n        for c in row:\n            if 5 <= c.column <= 45 and isinstance(c.value,str) and c.value.startswith('='):\n                formulas.append((c.column,c.coordinate))\n        if formulas:\n            idxs=[x[0] for x in formulas]\n            print('R%d %r formulas %s-%s count=%d gaps=%s' % (r, label, formulas[0][1], formulas[-1][1], len(formulas), ','.join(get_column_letter(i) for i in range(min(idxs),max(idxs)+1) if i not in idxs)))\nPY\n"]

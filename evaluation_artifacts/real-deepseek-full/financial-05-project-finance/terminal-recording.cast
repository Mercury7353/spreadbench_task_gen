[9.611461, "i", "python3 - <<'PY'\nimport zipfile\nfrom openpyxl import load_workbook\n\npath = 'input.xlsx'\nwb = load_workbook(path, data_only=False)\nprint('Sheets:', wb.sheetnames)\nfor ws in wb.worksheets:\n    print('\\n=== SHEET:', ws.title, 'dims', ws.dimensions, 'max', ws.max_row, ws.max_column, 'state', ws.sheet_state)\n    print('merged:', ws.merged_cells.ranges)\n    for row in ws.iter_rows():\n        vals=[]\n        for c in row:\n            if c.value is not None:\n                vals.append(f'{c.coordinate}={c.value!r}')\n        if vals:\n            print(' | '.join(vals))\n\nprint('\\nDefined names:', wb.defined_names)\nPY\n"]
[9.612922, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import zipfile\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> path = 'input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb = load_workbook(path, data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('Sheets:', wb.sheetnames)\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n=== SHEET:', ws.title, 'dims', ws.dimensions, 'max', ws.max_row, ws.max_column, 'state', ws.sheet_state)\r\n\u001b[?2004l\r\u001b[?2004h>     print('merged:', ws.merged_cells.ranges)\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h>         vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for c in row:\r\n\u001b[?2004l\r\u001b[?2004h>             if c.value is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 vals.append(f'{c.coordinate}={c.value!r}')\r\n\u001b[?2004l\r\u001b[?2004h>         if vals:\r\n\u001b[?2004l\r\u001b[?2004h>             print(' | '.join(vals))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('\\nDefined names:', wb.defined_names)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

[164.671073, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb = load_workbook('/workspace/output.xlsx', data_only=False)\nprint('Sheets:', wb.sheetnames)\nprint('Nonempty by sheet:')\nfor ws in wb.worksheets:\n    nonempty=sum(c.value is not None for row in ws.iter_rows() for c in row)\n    formula=sum(isinstance(c.value,str) and c.value.startswith('=') for row in ws.iter_rows() for c in row)\n    print(ws.title, nonempty, formula)\nPY\nls -l /workspace/output.xlsx\n"]

[129.919974, "i", "cat > /tmp/fix_gaps.py <<'PY'\nimport re\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter, column_index_from_string\n\npath='input.xlsx'\nout='output.xlsx'\nwb=load_workbook(path, data_only=False)\n\npat = re.compile(r'([A-Za-z_]+!)?(\\$?)([A-Z]{1,3})(\\$?)(\\d+)')\n\ndef shift_refs(formula, dx):\n    def repl(m):\n        prefix = m.group(1) or ''\n        abs_col = m.group(2) or ''\n        col = m.group(3)\n        abs_row = m.group(4) or ''\n        row = m.group(5)\n        new_col = get_column_letter(column_index_from_string(col) + dx)\n        return prefix + abs_col + new_col + abs_row + row\n    return pat.sub(repl, formula)\n\ndef neighbor_values(ws, r):\n    vals = {}\n    for col in range(1, ws.max_column+1):\n        c = ws.cell(row=r, column=col)\n        if c.value is not None:\n            vals[col] = c.value\n    return vals\n\n# Fill blanks that are between existing formulas in same row. Use right shifted left formula.\nchanged=[]\nfor ws in wb.worksheets:\n    for r in range(1, ws.max_row+1):\n"]
[129.922913, "o", "cat > /tmp/fix_gaps.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl.utils import get_column_letter, column_index_from_string\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> path='input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> out='output.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook(path, data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pat = re.compile(r'([A-Za-z_]+!)?(\\$?)([A-Z]{1,3})(\\$?)(\\d+)')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def shift_refs(formula, dx):\r\n\u001b[?2004l\r\u001b[?2004h>     def repl(m):\r\n\u001b[?2004l\r\u001b[?2004h>         prefix = m.group(1) or ''\r\n\u001b[?2004l\r\u001b[?2004h>         abs_col = m.group(2) or ''\r\n\u001b[?2004l\r\u001b[?2004h>         col = m.group(3)\r\n\u001b[?2004l\r\u001b[?2004h>         abs_row = m.group(4) or ''\r\n\u001b[?2004l\r\u001b[?2004h>         row = m.group(5)\r\n\u001b[?2004l\r\u001b[?2004h>         new_col = get_column_letter(column_index_from_string(col) + dx)\r\n\u001b[?2004l\r\u001b[?2004h>         return prefix + abs_col + new_col + abs_row + row\r\n\u001b[?2004l\r\u001b[?2004h>     re"]
[129.923001, "i", "        vals = neighbor_values(ws, r)\n        for col in range(4, ws.max_column+1):\n            if col in vals:\n                continue\n            if col-1 not in vals or col+1 not in vals:\n                continue\n            left=vals[col-1]; right=vals[col+1]\n            if isinstance(left, str) and left.startswith('=') and isinstance(right, str) and right.startswith('='):\n                formula = shift_refs(right, -1)\n                # For non-range patterns and running sums, this should be correct; if refs would be invalid, use left shift.\n                # Ensure formula is not empty\n                ws.cell(row=r, column=col).value = formula\n                changed.append((ws.title, r, get_column_letter(col), formula))\n\nwb.save(out)\nprint('Filled', len(changed), 'cells. Saved', out)\nfor sheet,r,col,f in changed[:10]: print(sheet, r, col, f)\n\n# Print gap detection after fill (between formulas)\nprint('\\nGaps after fill:')\nfor ws in wb.worksheets:\n    for r in range(1, ws.max_row+1):\n        vals = neig"]
[129.923012, "o", "turn pat.sub(repl, formula)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def neighbor_values(ws, r):\r\n\u001b[?2004l\r\u001b[?2004h>     vals = {}\r\n\u001b[?2004l\r\u001b[?2004h>     for col in range(1, ws.max_column+1):\r\n\u001b[?2004l\r\u001b[?2004h>         c = ws.cell(row=r, column=col)\r\n\u001b[?2004l\r\u001b[?2004h>         if c.value is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             vals[col] = c.value\r\n\u001b[?2004l\r\u001b[?2004h>     return vals\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Fill blanks that are between existing formulas in same row. Use right shifted left formula.\r\n\u001b[?2004l\r\u001b[?2004h> changed=[]\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     for r in range(1, ws.max_row+1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.923083, "i", "hbor_values(ws, r)\n        gaps=[]\n        for col in range(4, ws.max_column+1):\n            if col not in vals:\n                if col-1 in vals and col+1 in vals and isinstance(vals[col-1], str) and vals[col-1].startswith('=') and isinstance(vals[col+1], str) and vals[col+1].startswith('='):\n                    gaps.append(get_column_letter(col))\n        if gaps:\n            print(ws.title, 'R', r, ','.join(gaps))\nPY\npython3 /tmp/fix_gaps.py\n"]

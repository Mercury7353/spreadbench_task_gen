[84.358476, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\nwb=load_workbook('input.xlsx', data_only=False)\nfor sheet in ['Construction','Operation','Amortization','Debt','P&L','CFS','Balance Sheet','Ratios']:\n    ws=wb[sheet]\n    print('\\n===', sheet, '===')\n    for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\n        vals={c.column_letter:c.value for c in row if c.value is not None}\n        for col in range(4, ws.max_column+1):\n            L=get_column_letter(col)\n            if L not in vals:\n                prev=get_column_letter(col-1); nxt=get_column_letter(col+1)\n                if prev in vals and nxt in vals and isinstance(vals[prev], str) and vals[prev].startswith('=') and isinstance(vals[nxt], str) and vals[nxt].startswith('='):\n                    print('R%d %s EMPTY; prev %s=%r; next %s=%r' % (row[0].row, L, prev, vals[prev], nxt, vals[nxt]))\nPY\n"]
[84.358972, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.359824, "o", "from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl.utils import get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook('input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> for sheet in ['Construction','Operation','Amortization','Debt','P&L','CFS','Balance Sheet','Ratios']:\r\n\u001b[?2004l\r\u001b[?2004h>     ws=wb[sheet]\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n===', sheet, '===')\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\r\n\u001b[?2004l\r\u001b[?2004h>         vals={c.column_letter:c.value for c in row if c.value is not None}"]
[84.360093, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         for col in range(4, ws.max_column+1):"]
[84.360187, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.360313, "o", "            L=get_column_letter(col)\r\n\u001b[?2004l\r\u001b[?2004h>             if L not in vals:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.360518, "o", "                prev=get_column_letter(col-1); nxt=get_column_letter(col+1)\r\n\u001b[?2004l\r\u001b[?2004h> "]

[16.411897, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    print(ws.title, 'max_row', ws.max_row, 'max_col', ws.max_column, 'nonblank', sum(c.value is not None for row in ws.iter_rows() for c in row))\nprint('Sample cells Construction:')\nws=wb['Construction']\nfor row in ws.iter_rows():\n    vals=[]\n    for c in row:\n        if c.value is not None:\n            vals.append(f'{c.coordinate}={c.value!r}')\n    if vals:\n        print(' | '.join(vals))\nPY\n"]
[16.412435, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[16.412495, "o", "\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.414219, "o", "wb=load_workbook('input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     print(ws.title, 'max_row', ws.max_row, 'max_col', ws.max_column, 'nonblank', sum(c.value is not None for row in ws.iter_rows() for c in row))\r\n\u001b[?2004l\r\u001b[?2004h> print('Sample cells Construction:')\r\n\u001b[?2004l\r\u001b[?2004h> ws=wb['Construction']\r\n\u001b[?2004l\r\u001b[?2004h> for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h>     vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for c in row:\r\n\u001b[?2004l\r\u001b[?2004h>         if c.value is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             vals.append(f'{c.coordinate}={c.value!r}')\r\n\u001b[?2004l\r\u001b[?2004h>     if vals:\r\n\u001b[?2004l\r\u001b[?2004h>         print(' | '.join(vals))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

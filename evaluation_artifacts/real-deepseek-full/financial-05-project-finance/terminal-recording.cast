[59.913565, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nfrom openpyxl.styles import PatternFill\nwb=load_workbook('input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    print('\\n===', ws.title, '===')\n    count=0\n    for row in ws.iter_rows():\n        blanks=[]\n        nonblank=[]\n        for c in row:\n            if c.column_letter in [get_column_letter for_] and c.value is None:\n                if c.fill and c.fill.patternType:\n                    blanks.append(c.coordinate)\n            if c.value is not None:\n                nonblank.append(c.coordinate)\n        if blanks:\n            print('R%d nonblank=%s styles-blank=%s' % (row[0].row, ','.join(nonblank), ','.join(blanks)))\n            count+=1\n        if count>30:\n            print('...')\n            break\nPY\n"]

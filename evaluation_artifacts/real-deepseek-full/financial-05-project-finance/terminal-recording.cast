[191.193939, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb = load_workbook('/tmp/recalc/output.xlsx', data_only=True)\nprint('Sheets:', wb.sheetnames)\nerrors=[]\nfor ws in wb.worksheets:\n    for row in ws.iter_rows():\n        for c in row:\n            if isinstance(c.value,str) and (c.value.startswith('#') or 'Err:' in str(c.value)):\n                errors.append((ws.title,c.coordinate,c.value))\nprint('Error cells:', len(errors))\nfor e in errors[:100]:\n    print(e)\n# print a few calculated values from ratios\nfor coord in ['E19','E29']:\n    print('Ratios', coord, wb['Ratios'][coord].value)\nPY\n"]

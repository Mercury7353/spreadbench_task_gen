[110.825736, "o", "\u001b[?2004hroot@8e9927c36272:/workspace# "]
[118.009878, "i", "python3 - <<'PY' > /tmp/gaps.txt\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\nwb=load_workbook('input.xlsx', data_only=False)\nfor sheet in ['Construction','Operation','Amortization','Debt','P&L','CFS','Balance Sheet','Ratios']:\n    ws=wb[sheet]\n    print('\\n===', sheet, '===')\n    for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\n        vals={c.column_letter:c.value for c in row if c.value is not None}\n        gaps=[]\n        for col in range(4, ws.max_column+1):\n            L=get_column_letter(col)\n            if L not in vals:\n                prev=get_column_letter(col-1); nxt=get_column_letter(col+1)\n                if prev in vals and nxt in vals and isinstance(vals[prev], str) and vals[prev].startswith('=') and isinstance(vals[nxt], str) and vals[nxt].startswith('='):\n                    gaps.append((L, vals[prev], vals[nxt]))\n        if gaps:\n            print('R%d:' % row[0].row, '; '.join(f'{L}: L={left!r} R={right!r}' for L,left,right in gaps))\nPY\nwc -l /tmp/"]
[118.010591, "i", "gaps.txt\nsed -n '1,60p' /tmp/gaps.txt\n"]
[118.010667, "o", "python3 - <<'PY' > /tmp/gaps.txt\r\n\u001b[?2004l\r"]

[156.43849, "i", "python3 - <<'PY'\nimport re, pprint\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter, column_index_from_string\n\npath='input.xlsx'\nout='output.xlsx'\nwb=load_workbook(path, data_only=False)\npat = re.compile(r'([A-Za-z_]+!|\\'[^\\']+\\'!)?(\\$?)([A-Z]{1,3})(\\$?)(\\d+)')\n\ndef shift_refs_preserve_abs(formula, dx):\n    def repl(m):\n        prefix = m.group(1) or ''\n        abs_col = m.group(2) or ''\n        col = m.group(3)\n        abs_row = m.group(4) or ''\n        row = m.group(5)\n        if abs_col:\n            return prefix + abs_col + col + abs_row + row\n        new_col = get_column_letter(column_index_from_string(col) + dx)\n        return prefix + new_col + abs_row + row\n    return pat.sub(repl, formula)\n\nfilled=[]\nfor ws in wb.worksheets:\n    for r in range(1, ws.max_row+1):\n        row=list(ws.iter_rows(min_row=r, max_row=r))[0]\n        vals={c.column_letter:c.value for c in row if c.value is not None}\n        for col in range(5, ws.max_column+1):\n            L=get_column_letter(col"]

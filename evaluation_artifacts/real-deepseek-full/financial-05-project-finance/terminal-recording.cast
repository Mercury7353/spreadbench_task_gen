[118.151859, "o", ")'; AC: L='=SUM(AB21:AB24)' R='=SUM(AD21:AD24)'\r\n\r\n=== CFS ===\r\nR8: S: L='=Operation!Q14' R='=Operation!S14'\r\nR10: G: L='=-Operation!E21' R='=-Operation!G21'; I: L='=-Operation!G21' R='=-Operation!I21'; AB: L='=-Operation!Z21' R='=-Operation!AB21'\r\nR12: T: L=\"='P&L'!S23\" R=\"='P&L'!U23\"; Z: L=\"='P&L'!Y23\" R=\"='P&L'!AA23\"; AG: L=\"='P&L'!AF23\" R=\"='P&L'!AH23\"; AM: L=\"='P&L'!AL23\" R=\"='P&L'!AN23\"\r\nR14: H: L='=SUM(G8:G13)' R='=SUM(I8:I13)'; K: L='=SUM(J8:J13)' R='=SUM(L8:L13)'; AA: L='=SUM(Z8:Z13)' R='=SUM(AB8:AB13)'; AP: L='=SUM(AO8:AO13)' R='=SUM(AQ8:AQ13)'\r\nR17: G: L='=Debt!F10' R='=Debt!H10'\r\nR19: J: L='=I14+I16+I17' R='=K14+K16+K17'; AF: L='=AE14+AE16+AE17' R='=AG14+AG16+AG17'; AH: L='=AG14+AG16+AG17' R='=AI14+AI16+AI17'; AN: L='=AM14+AM16+AM17' R='=AO14+AO16+AO17'; AP: L='=AO14+AO16+AO17' R='=AQ14+AQ16+AQ17'\r\nR23: AC: L='=AB19+AB21' R='=AD19+AD21'; AO: L='=AN19+AN21' R='=AP19+AP21'\r\n\r\n=== Balance Sheet ===\r\nR8: T: L='=Amortization!R10' R='=Amortization!T10'; Y: L='=Amortization!W10' R='=Amortization!Y10'\r\nR9"]

[73.763622, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import column_index_from_string, get_column_letter\nwb=load_workbook('input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    print('\\n===', ws.title, '===')\n    for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\n        vals={c.column_letter:c.value for c in row if c.value is not None}\n        blanks=[]\n        # data range common\n        for col in range(4, ws.max_column+1):  # D..max\n            L=get_column_letter(col)\n            if L not in vals:\n                prev_col=col-1; next_col=col+1\n                prev=get_column_letter(prev_col) if prev_col<=ws.max_column else None\n                nxt=get_column_letter(next_col) if next_col<=ws.max_column else None\n                # blank with nonblank on both sides within row\n                if prev in vals and nxt in vals and isinstance(vals[prev], str) and vals[prev].startswith('=') and isinstance(vals[nxt], str) and vals[nxt].startswith('='):\n                    blanks.append("]

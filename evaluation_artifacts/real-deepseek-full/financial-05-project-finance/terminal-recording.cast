[23.213238, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import column_index_from_string, get_column_letter\nwb=load_workbook('input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    print('\\n===', ws.title, '=== maxcol', ws.max_column)\n    cols=[get_column_letter(i) for i in range(1, ws.max_column+1)]\n    for row in ws.iter_rows():\n        label = None\n        present=[]\n        for c in row:\n            if c.value is not None:\n                present.append(c.coordinate)\n                if label is None and c.column_letter in ['A','B','C']:\n                    label=str(c.value)\n        if present:\n            # only print rows with possible gaps among D+ and not labels/totals? all\n            print(f'R{row[0].row}: {label} | nonblank=', ','.join(present))\nPY\n"]
[23.214755, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl.utils import column_index_from_string, get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook('input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n===', ws.title, '=== maxcol', ws.max_column)\r\n\u001b[?2004l\r\u001b[?2004h>     cols=[get_column_letter(i) for i in range(1, ws.max_column+1)]\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h>         label = None\r\n\u001b[?2004l\r\u001b[?2004h>         present=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for c in row:\r\n\u001b[?2004l\r\u001b[?2004h>             if c.value is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 present.append(c.coordinate)\r\n\u001b[?2004l\r\u001b[?2004h>                 if label is None and c.column_letter in ['A','B','C']:\r\n\u001b[?2004l\r\u001b[?2004h>                     label=str(c.value)\r\n\u001b[?2004l\r\u001b[?2004h>         if present:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.215454, "o", "            # only print rows with possible gaps among D+ and not labels/totals? all\r\n\u001b[?2004l\r\u001b[?2004h>             print(f'R{row[0].row}: {label} | nonblank=', ','.join(present))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

[238.227504, "i", "cd /workspace && python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('output.xlsx', data_only=False)\nws=wb['Model Inputs']\nfor r in range(24,43):\n    vals=[]\n    for c in range(1, 8):\n        v=ws.cell(r,c).value\n        vals.append('.' if v is None else str(v))\n    print(f'{r:02d}', ' | '.join(vals))\nPY\n"]

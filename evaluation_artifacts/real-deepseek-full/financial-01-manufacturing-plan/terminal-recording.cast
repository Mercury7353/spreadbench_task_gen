[97.318528, "i", "cd /workspace && python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False)\nfor sheet, r1, r2 in [('Profit and Loss',1,48),('Balance Sheet',1,45)]:\n    ws=wb[sheet]\n    print('###',sheet)\n    for r in range(r1,r2+1):\n        vals=[]\n        for c in range(1, ws.max_column+1):\n            v=ws.cell(r,c).value\n            if v is None: vals.append('.')\n            elif isinstance(v,str) and v.startswith('='): vals.append(str(v))\n            else: vals.append(str(v))\n        print(f'{r:02d}', ' | '.join(vals))\nPY\n"]
[97.319532, "o", "cd /workspace && python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook('input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> for sheet, r1, r2 in [('Profit and Loss',1,48),('Balance Sheet',1,45)]:\r\n\u001b[?2004l\r\u001b[?2004h>     ws=wb[sheet]\r\n\u001b[?2004l\r\u001b[?2004h>     print('###',sheet)\r\n\u001b[?2004l\r\u001b[?2004h>     for r in range(r1,r2+1):\r\n\u001b[?2004l\r\u001b[?2004h>         vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for c in range(1, ws.max_column+1):\r\n\u001b[?2004l\r\u001b[?2004h>             v=ws.cell(r,c).value\r\n\u001b[?2004l\r\u001b[?2004h>             if v is None: vals.append('.')\r\n\u001b[?2004l\r\u001b[?2004h>             elif isinstance(v,str) and v.startswith('='): vals.append(str(v))\r\n\u001b[?2004l\r\u001b[?2004h>             else: vals.append(str(v))\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'{r:02d}', ' | '.join(vals))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

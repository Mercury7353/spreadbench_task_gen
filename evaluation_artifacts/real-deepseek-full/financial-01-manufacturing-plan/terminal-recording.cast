[73.888982, "o", "\u001b[?2004hroot@e034ee74ee5d:/workspace# "]
[78.749104, "i", "cd /workspace && python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    fn='/tmp/formulas_'+ws.title.replace(' ','_')+'.txt'\n    with open(fn,'w') as f:\n        for row in ws.iter_rows():\n            for c in row:\n                if c.value is not None:\n                    f.write(f'{c.coordinate}\\t{repr(c.value)}\\n')\n    print('wrote', fn)\nPY\nhead -100 /tmp/formulas_Model_Inputs.txt /tmp/formulas_Profit_and_Loss.txt\n"]
[78.749624, "o", "cd /workspace && python3 - <<'PY'\r\n\u001b[?2004l\r"]
[78.75042, "o", "\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook('input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     fn='/tmp/formulas_'+ws.title.replace(' ','_')+'.txt'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.750494, "o", "    with open(fn,'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>         for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.750746, "o", "            for c in row:\r\n\u001b[?2004l\r\u001b[?2004h>                 if c.value is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.750958, "o", ">                     f.write(f'{c.coordinate}\\t{repr(c.value)}\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]

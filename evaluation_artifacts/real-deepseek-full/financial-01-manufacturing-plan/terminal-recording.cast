[229.361154, "i", "cp /workspace/recalc/output.xlsx /workspace/output.xlsx\ncd /workspace && python3 - <<'PY'\nfrom openpyxl import load_workbook\nwbv=load_workbook('output.xlsx', data_only=True)\nwbf=load_workbook('output.xlsx', data_only=False)\nprint('Sheets', wbv.sheetnames)\nchecks=[('Model Inputs',['C26','B28','C33','B35']),('Profit and Loss',['E15','E17','E21','E33','E35','E37','E39','E44','E48']),('Balance Sheet',['E7','E20','E37','G37','I39','D43','E52']),('Cash Flow',['D16','D23','D31','D33','D36','E36']),('Loan Payment Calculator',['D12','E12','F12','G12','D13','D14','D60','D72','D371'])]\nfor ws, coords in checks:\n    print('###',ws)\n    vf=wbf[ws]; vv=wbv[ws]\n    for c in coords:\n        f=vf[c].value\n        val=vv[c].value\n        print(c, 'formula=', repr(f), 'calc=', val)\n# print any error strings\nfor ws in wbv.worksheets:\n    errs=[]\n    for row in ws.iter_rows():\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('#') and len(c.value)>1:\n                errs.append(c.coordinate+':'+c"]

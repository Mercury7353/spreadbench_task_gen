[187.218321, "i", "\nput(cf,'E35','=D36')\nput(cf,'F35','=E36')\nput(cf,'H35','=G36')\nput(cf,'I35','=H36')\nput(cf,'E36','=E35+E33')\nput(cf,'F36','=F35+F33')\nput(cf,'I36','=I35+I33')\n\nlpc=wb['Loan Payment Calculator']\nfor r in range(12,372):\n    # Ensure month number if blank, though likely all present\n    if lpc.cell(r,3).value is None:\n        lpc.cell(r,3).value = r-11\n    put(lpc, f'D{r}', f'=D{r-1}+E{r-1}' if r > 12 else '=C7')\n    put(lpc, f'E{r}', f'=G{r}-F{r}')\n    put(lpc, f'F{r}', f'=-$C$6*D{r}')\n    put(lpc, f'G{r}', f'=IF(C{r}>$C$8,0,$C$9)')\n\nwb.save(OUT)\nprint('saved', OUT)\nPY\n"]

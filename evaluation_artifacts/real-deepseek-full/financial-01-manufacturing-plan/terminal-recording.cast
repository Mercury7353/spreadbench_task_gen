[101.627745, "i", "cd /workspace && python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False)\nfor sheet, r1, r2 in [('Cash Flow',1,40),('Loan Payment Calculator',1,40)]:\n    ws=wb[sheet]\n    print('###',sheet)\n    for r in range(r1,r2+1):\n        vals=[]\n        for c in range(1, ws.max_column+1):\n            v=ws.cell(r,c).value\n            if v is None: vals.append('.')\n            elif isinstance(v,str) and v.startswith('='): vals.append(str(v))\n            else: vals.append(str(v))\n        print(f'{r:02d}', ' | '.join(vals))\nPY\n"]

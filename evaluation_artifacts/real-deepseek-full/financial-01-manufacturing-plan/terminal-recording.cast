[187.212461, "i", "cd /workspace && python3 - <<'PY'\nfrom openpyxl import load_workbook\n\nSRC='input.xlsx'\nOUT='/workspace/output.xlsx'\nwb=load_workbook(SRC, data_only=False)\n\n# Helper to set only if blank or maybe overwrite selected? We'll set missing formulas only.\ndef put(ws, coord, formula):\n    cell=ws[coord]\n    if cell.value is None:\n        cell.value=formula\n\nmi=wb['Model Inputs']\nput(mi,'C26','=C24*C25')\nput(mi,'D26','=D24*D25')\nput(mi,'E26','=E24*E25')\nput(mi,'F26','=F24*F25')\nput(mi,'B28','=SUM(C26:F26)')\nput(mi,'C33','=C26*(1-C32)')\nput(mi,'D33','=D26*(1-D32)')\nput(mi,'E33','=E26*(1-E32)')\nput(mi,'F33','=F26*(1-F32)')\nput(mi,'B35','=SUM(C33:F33)')\n\npnl=wb['Profit and Loss']\nput(pnl,'H13','=+H7')\nput(pnl,'I13','=+I7')\nput(pnl,'E15',\"='Model Inputs'!C28\")\nput(pnl,'E17','=E15-E16')\nput(pnl,'H17','=H15-H16')\nput(pnl,'E21','=+E17+E19+E20')\nput(pnl,'G21','=+G17+G19+G20')\nput(pnl,'I21','=+I17+I19+I20')\nfor col, prev in [('G','F'),('H','G'),('I','H')]:\n    put(pnl, f'{col}25', f'=+{prev}25*(1+{col}$9)')\nput(pnl,'I26',\"=('Ba"]

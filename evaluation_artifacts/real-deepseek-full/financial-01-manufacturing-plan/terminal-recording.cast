[199.483438, "i", "cd /workspace && python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('output.xlsx', data_only=False)\nsections=[('Model Inputs',1,46),('Profit and Loss',1,50),('Balance Sheet',1,53,),('Cash Flow',1,37),('Loan Payment Calculator',10,80)]\nfor sheet,r1,r2 in sections:\n    ws=wb[sheet]\n    blanks=[]\n    for r in range(r1,r2+1):\n        for c in range(1,ws.max_column+1):\n            if ws.cell(r,c).value is None:\n                blanks.append(ws.cell(r,c).coordinate)\n    print(sheet, 'nonempty blanks in shown range', blanks[:200], 'count', len(blanks))\nPY\nwhich libreoffice || which soffice || true\n"]

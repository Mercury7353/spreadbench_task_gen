[192.876951, "i", "cd /workspace && python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('output.xlsx', data_only=False)\nprint('Sheets:', wb.sheetnames)\nfor sheet,ranges in [('Balance Sheet',[('D46',),('E49',),('D52',),('E52',),('D43',),('E37',)]),('Cash Flow',[('E19',),('F19',),('E21',),('G26',),('E36',)]),('Profit and Loss',[('E21',),('F37',),('H17',)]),('Loan Payment Calculator',[('D21',),('D53',),('E72',),('G13',)])]:\n    ws=wb[sheet]\n    print('###', sheet)\n    for t in ranges:\n        c=t[0]\n        print(c, repr(ws[c].value))\n# Count non-empty formulas per sheet and print cells still maybe blank in known ranges\nfor ws in wb.worksheets:\n    print(ws.title, 'formulas', sum(1 for row in ws.iter_rows() for c in row if isinstance(c.value,str) and c.value.startswith('=')))\nPY\n"]
[192.878135, "o", "cd /workspace && python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook('output.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('Sheets:', wb.sheetnames)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[192.879116, "o", "for sheet,ranges in [('Balance Sheet',[('D46',),('E49',),('D52',),('E52',),('D43',),('E37',)]),('Cash Flow',[('E19',),('F19',),('E21',),('G26',),('E36',)]),('Profit and Loss',[('E21',),('F37',),('H17',)]),('Loan Payment Calculator',[('D21',),('D53',),('E72',),('G13',)])]:\r\n\u001b[?2004l\r\u001b[?2004h>     ws=wb[sheet]\r\n\u001b[?2004l\r\u001b[?2004h>     print('###', sheet)\r\n\u001b[?2004l\r\u001b[?2004h>     for t in ranges:\r\n\u001b[?2004l\r\u001b[?2004h>         c=t[0]\r\n\u001b[?2004l\r\u001b[?2004h>         print(c, repr(ws[c].value))\r\n\u001b[?2004l\r\u001b[?2004h> # Count non-empty formulas per sheet and print cells still maybe blank in known ranges\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     print(ws.title, 'formulas', sum(1 for row in ws.iter_rows() for c in row if isinstance(c.value,str) and c.value.startswith('=')))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[192.970253, "o", "Sheets: ['Model Inputs', 'Profit and Loss', 'Balance Sheet', 'Cash Flow', 'Loan Payment Calculator']\r\n### Balance Sheet\r\nD46 50000\r\nE49 \"=+'Profit and Loss'!E48\"\r\nD52 '=D50+D43'\r\nE52 '=E50+E43'\r\nD43 '=D35+D37+D41'\r\nE37 \"='Loan Payment Calculator'!D12\"\r\n"]
[192.970376, "o", "### Cash Flow\r\nE19 \"=-1*MAX(0,SUM('Balance Sheet'!F15:F18)-SUM('Balance Sheet'!E15:E18))\"\r\nF19 \"=-1*MAX(0,SUM('Balance Sheet'!G15:G18)-SUM('Balance Sheet'!F15:F18))\"\r\nE21 \"=(-1*MIN(0,SUM('Balance Sheet'!F15:F18)-SUM('Balance Sheet'!E15:E18))-'Profit and Loss'!F41)\"\r\nG26 \"='Balance Sheet'!H37+'Balance Sheet'!H38-('Balance Sheet'!G37+'Balance Sheet'!G38)\"\r\nE36 '=E35+E33'\r\n### Profit and Loss\r\nE21 '=+E17+E19+E20'\r\nF37 \"=-SUM('Loan Payment Calculator'!F24:F35)\"\r\nH17 '=H15-H16'\r\n### Loan Payment Calculator\r\nD21 '=D20+E20'\r\nD53 '=D52+E52'\r\nE72 '=G72-F72'\r\nG13 '=IF(C13>$C$8,0,$C$9)'\r\n"]

[246.394899, "i", "cd /workspace && python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('output.xlsx', data_only=False)\nws=wb['Model Inputs']\nws['C28']='=SUM(C26:F26)'\nws['C35']='=SUM(C33:F33)'\nwb.save('output.xlsx')\nprint(ws['B28'].value, ws['C28'].value, ws['B35'].value, ws['C35'].value)\nPY\nrm -rf /workspace/recalc && mkdir -p /workspace/recalc && libreoffice --headless --convert-to xlsx --outdir /workspace/recalc /workspace/output.xlsx\ncp /workspace/recalc/output.xlsx /workspace/output.xlsx\ncd /workspace && python3 - <<'PY'\nfrom openpyxl import load_workbook\nwbv=load_workbook('output.xlsx', data_only=True)\nwbf=load_workbook('output.xlsx', data_only=False)\nfor ws in ['Model Inputs','Profit and Loss','Balance Sheet','Cash Flow']:\n    v=wbv[ws]; f=wbf[ws]\n    for c in ['C28','C35'] if ws=='Model Inputs' else (['E15','E16','E17','E21','E35','E37','E48'] if ws=='Profit and Loss' else (['E7','E20','E37','D43','E52'] if ws=='Balance Sheet' else ['D16','D23','D31','D33','D36','E36'])):\n        print(ws,c,'f=',f[c].v"]
[246.395993, "o", "cd /workspace && python3 - <<'PY'\r\n\u001b[?2004l\r"]

[78.86821, "o", "==> /tmp/formulas_Model_Inputs.txt <==\r\nB1\t'[Company Name]'\r\nB2\t'5-Year Financial Plan—Manufacturing'\r\nB3\t'Model inputs and investor scenario'\r\nB5\t'Enter data in white cells only.'\r\nB6\t'Italicized numbers in gray cells are calculations that should not be overwritten.'\r\nB7\t'Non-italicized numbers in gray cells are calculations that can be overwritten.'\r\nB9\t'General notes and assumptions'\r\nB10\t'[Document key financial planning assumptions here.]'\r\nB19\t'Year 1 model inputs'\r\nB20\t'Use this area to capture key components of the Profit and Loss Statement and the Balance Sheet for the first year only.'\r\nB22\t'1. Year-one revenue expectancy'\r\nC23\t'<Product 1>'\r\nD23\t'<Product 2>'\r\nE23\t'<Product 3>'"]
[78.86824, "o", "\r\nF23\t'<Product 4>'\r\nB24\t'Number of units sold annually'\r\nC24\t2800\r\nD24\t1200\r\nE24\t1600\r\nF24\t0\r\nB25\t'Average sales price per unit'\r\nC25\t120\r\nD25\t80\r\nE25\t40\r\nF25\t0\r\nB26\t'Annual revenue per product'\r\nB28\t'Total year 1 revenue'\r\nB30\t'2. Year 1 cost of goods sold'\r\nB32\t'Expected gross margin per product'\r\nC32\t0.5\r\nD32\t0.4\r\nE32\t0.25\r\nF32\t0\r\nB33\t'Annual cost of goods sold per product'\r\nB35\t'Total year 1 cost of goods sold'\r\nB37\t'3. Annual maintenance, repair, and overhaul'\r\nB38\t'Factor (%) on capital equipment'\r\nC38\t0.15\r\nB40\t'4. Number of years for straight-line depreciation'\r\nC40\t5\r\nB42\t'5. Annual tax rate'\r\nC42\t0.3\r\nB44\t'6. If long-term debt is being used to finance\\n     operations, enter the total loan value.'\r\nC44\t80000\r\n"]
[78.868347, "o", "\r\n==> /tmp/formulas_Profit_and_Loss.txt <==\r\nB1\t\"=+'Model Inputs'!B1\"\r\nB3\t'Profit and loss projections'\r\nB6\t'Year-by-year profit and loss assumptions'\r\nE7\t'Year 1'\r\nF7\t'Year 2'\r\nG7\t'Year 3'\r\nH7\t'Year 4'\r\nI7\t'Year 5'\r\nC8\t'Annual cumulative price (revenue) increase'\r\nE8\t'-'\r\nF8\t0.02\r\nG8\t0.04\r\nH8\t0.06\r\nI8\t0.08\r\nC9\t'Annual cumulative inflation (expense) increase'\r\nE9\t'-'\r\nF9\t0.02\r\nG9\t0.04\r\nH9\t0.06\r\nI9\t0.08\r\nC10\t'Interest rate on ending cash balance'\r\nE10\t0.005\r\nF10\t0.005\r\nG10\t0.005\r\nH10\t0.005\r\nI10\t0.005\r\nE13\t'=+E7'\r\nF13\t'=+F7'\r\nG13\t'=+G7'\r\nB14\t'Revenue'\r\nC15\t'Gross revenue'\r\nF15\t'=+E15*(1+F8)'\r\nG15\t'=+F15*(1+G8)'\r\nH15\t'=+G15*(1+H8)'\r\nI15\t'=+H15*(1+I8)'\r\nC16\t"]
[78.868379, "o", "'Cost of goods sold'\r\nE16\t\"=+'Model Inputs'!C35\"\r\nF16\t'=+E16*(1+F9)'\r\nG16\t'=+F16*(1+G9)'\r\nH16\t'=+G16*(1+H9)'\r\nI16\t'=+H16*(1+I9)'\r\nC17\t'Gross margin'\r\nF17\t'=F15-F16'\r\nG17\t'=G15-G16'\r\nI17\t'=I15-I16'\r\nC19\t'Other revenue [source]'\r\nE19\t0\r\nF19\t0\r\nG19\t10000\r\nH19\t0\r\nI19\t0\r\nC20\t'Interest income'\r\nE20\t1000\r\nF20\t0\r\nG20\t0\r\nH20\t0\r\nI20\t0\r\nC21\t'Total revenue'\r\nF21\t'=+F17+F19+F20'\r\nH21\t'=+H17+H19+H20'\r\nB23\t'Operating expenses'\r\nC24\t'Sales and marketing'\r\nE24\t40000\r\nF24\t'=+E24*(1+F$9)'\r\nG24\t'=+F24*(1+G$9)'\r\nH24\t'=+G24*(1+H$9)'\r\nI24\t'=+H24*(1+I$9)'\r\nC25\t'Payroll and payroll taxes'\r\nE25\t60000\r\nF25\t'=+E25*(1+F$9)'\r\nG25\t'=+F25*(1+G$9)'\r\nC26\t'Depreciation'\r\nE26\t\"=('Balance Sheet'!D15+'Balance Sheet'!D17+'Balance Sheet'!D18)/'Model Inputs'!$C$40\"\r\nF26\t\"=('Balance Sheet'!E15+'Balance Sheet'!E17+'Balance Sheet'!E18)/'Model Inputs'!$C$40*(1+F$9)\"\r\nG26\t\"=('Balance Sheet'!F15+'Balance Sheet'!F17+'Balance Sheet'!F18)/'Model Inputs'!$C$40*(1+G$9)\"\r\nH26\t\"=('Balance Sheet'!G15+'Balance Sheet'!G17+'Balance Sheet'!G18)/'Model Inputs'!$C$40*("]
[78.868388, "o", "1+H$9)\"\r\nC27\t'Insurance'\r\nE27\t40000\r\nG27\t'=+F27*(1+G$9)'\r\nC28\t'Maintenance, repair, and overhaul'\r\nF28\t\"=('Balance Sheet'!E18*'Model Inputs'!$C$38)*(1+F$9)\"\r\nG28\t\"=('Balance Sheet'!F18*'Model Inputs'!$C$38)*(1+G$9)\"\r\nH28\t\"=('Balance Sheet'!G18*'Model Inputs'!$C$38)*(1+H$9)\"\r\nI28\t\"=('Balance Sheet'!H18*'Model Inputs'!$C$38)*(1+I$9)\"\r\nC29\t'Utilities'\r\nE29\t30000\r\nF29\t'=+E29*(1+F$9)'\r\nG29\t'=+F29*(1+G$9)'\r\nH29\t'=+G29*(1+H$9)'\r\nC30\t'Property taxes'\r\nE30\t15000\r\nF30\t'=+E30*(1+F$9)'\r\nG30\t'=+F30*(1+G$9)'\r\nI30\t'=+H30*(1+I$9)'\r\nC31\t'Administrative fees'\r\nE31\t18000\r\nF31\t'=+E31*(1+F$9)'\r\nH31\t'=+G31*(1+H$9)'\r\nI31\t'=+H31*(1+I$9)'\r\nC32\t'Other'\r\n"]

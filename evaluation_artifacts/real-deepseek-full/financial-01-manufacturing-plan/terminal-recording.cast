[14.203673, "o", "\u001b[?2004hroot@e034ee74ee5d:/workspace# "]
[65.424383, "i", "cd /workspace && python3 - <<'PY' > /tmp/report.txt 2>&1\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    print('\\n### SHEET', ws.title)\n    for r in range(1, ws.max_row+1):\n        vals=[]\n        for c in range(1, ws.max_column+1):\n            v=ws.cell(r,c).value\n            if v is None:\n                vals.append('.')\n            elif isinstance(v,str) and v.startswith('='):\n                vals.append('=' + v[:20])\n            else:\n                s=str(v)\n                if len(s)>40: s=s[:37]+'...'\n                vals.append(s)\n        print(f'{r:03d}', '|'.join(vals))\nprint('\\nFORMULAS ONLY:')\nfor ws in wb.worksheets:\n    print('\\n### SHEET', ws.title)\n    for row in ws.iter_rows():\n        for c in row:\n            if c.value and isinstance(c.value,str) and c.value.startswith('='):\n                print(c.coordinate, c.value)\nPY\nwc -l /tmp/report.txt\ncat /tmp/report.txt\n"]

[187.223557, "o", "    put(lpc, f'E{r}', f'=G{r}-F{r}')\r\n\u001b[?2004l\r\u001b[?2004h>     put(lpc, f'F{r}', f'=-$C$6*D{r}')\r\n\u001b[?2004l\r"]

[8.004141, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p, data_only=False, keep_vba=False)\nprint('Sheets:', wb.sheetnames)\nfor ws in wb.worksheets:\n    print('\\n=== SHEET:', ws.title, 'dims', ws.dimensions, 'max', ws.max_row, ws.max_column, 'state', ws.sheet_state)\n    print('Formulas:')\n    for row in ws.iter_rows():\n        for c in row:\n            if isinstance(c.value, str) and c.value.startswith('='):\n                print(c.coordinate, repr(c.value))\nPY\n"]

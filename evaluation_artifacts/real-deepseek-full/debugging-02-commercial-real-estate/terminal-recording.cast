[66.912281, "o", "            vals.append(f'{ws.cell(r,col).coordinate}={v:,.4f}' if isinstance(v,(int,float)) else f'{ws.cell(r,col).coordinate}={v!r}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.912307, "o", "    print('R',r, ' '.join(vals))\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.912315, "o", "> "]

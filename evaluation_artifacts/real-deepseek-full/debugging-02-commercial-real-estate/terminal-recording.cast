[23.4607, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nws=wb['Model']\nfor r in range(40, 91):\n    parts=[]\n    for c in range(1, 16):\n        v=ws.cell(r,c).value\n        if v is not None:\n            parts.append(f'{ws.cell(r,c).coordinate}={v!r}')\n    print(f'R{r}:', ' | '.join(parts))\nprint('\\nRows>90 nonempty cells count per row')\nfor r in range(91, 402):\n    vals=[]\n    for c in range(1, 32):\n        v=ws.cell(r,c).value\n        if v is not None:\n            vals.append((c, v))\n    if vals:\n        print('R',r, vals[:6], 'count', len(vals), 'last', vals[-1][1])\nPY\n"]

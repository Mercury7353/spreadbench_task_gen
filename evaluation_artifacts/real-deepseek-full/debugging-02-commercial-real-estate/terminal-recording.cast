[76.949382, "i", "python3 - <<'PY'\nimport openpyxl\norig=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)['Model']\nout=openpyxl.load_workbook('/workspace/output.xlsx', data_only=False)['Model']\nprint('Changed cells:')\nfor row in orig.iter_rows():\n    for c in row:\n        if c.value != out[c.coordinate].value:\n            print(c.coordinate, 'from', repr(c.value), 'to', repr(out[c.coordinate].value))\nprint('\\nRemaining suspicious formulas in output:')\nfor row in out.iter_rows():\n    for c in row:\n        v = c.value\n        if isinstance(v,str) and v.startswith('='):\n            if '1+(' in v or 'H77' in v or 'N35' in v or '+N35' in v or 'N35+' in v or '=1+' in v or '=N35' in v or 'N35/((1+$C$14)^N33)' in v and c.coordinate!='N35':\n                print('SUSP', c.coordinate, v)\nprint('\\nHard-coded numbers in rows 42-89 formulas region:')\nfor r in range(42, 90):\n    for col in range(1, 16):\n        c=out.cell(r,col)\n        if isinstance(c.value,(int,float)):\n            print(c.coordinate, c.value)\nprint('\\nOutp"]

[66.490381, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('/workspace/output.xlsx', data_only=False)\nws=wb['Model']\n# Fix debt service all years to negative annual payment\nfor coord in [f'{c}61' for c in 'EFGHIJKLMN']:\n    ws[coord] = f'=-{coord[0]}73'\n# O61 is after sale? keep na (already na)\nprint([(f'{c}61', ws[f'{c}61'].value) for c in 'EFGHIJKLMN'])\nwb.save('/workspace/output.xlsx')\nPY\nsoffice --headless --convert-to xlsx --outdir /workspace/recalc_out /workspace/output.xlsx >/tmp/lo_out.txt 2>&1 || true\npython3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/recalc_out/output.xlsx', data_only=True)\nws=wb['Model']\nfor r in range(60,68):\n    vals=[]\n    for col in range(1,16):\n        v=ws.cell(r,col).value\n        if v is not None:\n            vals.append(f'{ws.cell(r,col).coordinate}={v:,.4f}' if isinstance(v,(int,float)) else f'{ws.cell(r,col).coordinate}={v!r}')\n    print('R',r, ' '.join(vals))\nfor c in ['C24','C37','C38','E89','N34','N35','N65','N67']:\n    print(c, ws[c].val"]

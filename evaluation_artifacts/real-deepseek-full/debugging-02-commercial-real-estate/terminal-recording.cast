[81.478363, "i", "python3 - <<'PY'\nimport openpyxl, os\nout=openpyxl.load_workbook('/workspace/output.xlsx', data_only=False)['Model']\nprint('size', os.path.getsize('/workspace/output.xlsx'))\nprint('sheets same', openpyxl.load_workbook('/workspace/output.xlsx', data_only=False).sheetnames)\nprint('formulas count', sum(1 for row in out.iter_rows() for c in row if isinstance(c.value,str) and c.value.startswith('=')))\nprint('hardcoded nums rows42-89:')\nfor r in range(42,90):\n    for col in range(1,16):\n        c=out.cell(r,col)\n        if isinstance(c.value,(int,float)):\n            print(c.coordinate, c.value)\nPY\n"]

[66.491111, "o", "from openpyxl import load_workbook\r\n\u001b[?2004l\r"]
[66.492504, "o", "\u001b[?2004h> wb=load_workbook('/workspace/output.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> ws=wb['Model']\r\n\u001b[?2004l\r\u001b[?2004h> # Fix debt service all years to negative annual payment\r\n\u001b[?2004l\r\u001b[?2004h> for coord in [f'{c}61' for c in 'EFGHIJKLMN']:\r\n\u001b[?2004l\r\u001b[?2004h>     ws[coord] = f'=-{coord[0]}73'\r\n\u001b[?2004l\r\u001b[?2004h> # O61 is after sale? keep na (already na)\r\n\u001b[?2004l\r\u001b[?2004h> print([(f'{c}61', ws[f'{c}61'].value) for c in 'EFGHIJKLMN'])\r\n\u001b[?2004l\r\u001b[?2004h> wb.save('/workspace/output.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\rue)\r\nPY\r\n"]
[66.579734, "o", "[('E61', '=-E73'), ('F61', '=-F73'), ('G61', '=-G73'), ('H61', '=-H73'), ('I61', '=-I73'), ('J61', '=-J73'), ('K61', '=-K73'), ('L61', '=-L73'), ('M61', '=-M73'), ('N61', '=-N73')]\r\n"]

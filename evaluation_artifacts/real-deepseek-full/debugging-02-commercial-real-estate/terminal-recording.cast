[66.911933, "o", "ws=wb['Model']\r\n\u001b[?2004l\r"]
[66.912047, "o", "\u001b[?2004h> for r in range(60,68):\r\n\u001b[?2004l\r\u001b[?2004h>     vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for col in range(1,16):\r\n\u001b[?2004l\r\u001b[?2004h> "]

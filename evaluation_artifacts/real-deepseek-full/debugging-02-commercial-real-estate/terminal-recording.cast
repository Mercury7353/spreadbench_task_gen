[27.724165, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx', data_only=False)\nws=wb['Model']\nlines=[]\nfor r in range(1, ws.max_row+1):\n    for c in range(1, ws.max_column+1):\n        v=ws.cell(r,c).value\n        if v is not None:\n            lines.append(f'{ws.cell(r,c).coordinate}: {repr(v)}')\nopen('/workspace/inspect.txt','w').write('\\n'.join(lines)+'\\n')\nprint('written', len(lines), 'nonempty cells')\nPY\ncat /workspace/inspect.txt | sed -n '1,220p'\nwhich soffice || which libreoffice || echo no-libreoffice\n"]

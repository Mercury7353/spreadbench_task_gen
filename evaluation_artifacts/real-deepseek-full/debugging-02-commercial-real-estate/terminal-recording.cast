[52.094367, "i", "mkdir -p /workspace/recalc_out\nsoffice --headless --convert-to xlsx --outdir /workspace/recalc_out /workspace/output.xlsx >/tmp/lo_out.txt 2>&1 || true\ncat /tmp/lo_out.txt\npython3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/recalc_out/output.xlsx', data_only=True)\nws=wb['Model']\ncoords=['C24','C27','C28','C29','C37','C38','E42','E44','E46','E49','F60','E63','N65','E67','E72','E73','E74','E75','E76','N76','E80','E82','E83','E84','E85','E86','E87','E88','E89','N34','N35','N65','N67']\nfor c in coords:\n    print(c, ws[c].value)\nprint('\\nRows 42-89 compact values')\nfor r in range(42,90):\n    vals=[]\n    for col in range(1,16):\n        v=ws.cell(r,col).value\n        if v is not None:\n            vals.append(f'{ws.cell(r,col).coordinate}={v:,.4f}' if isinstance(v,(int,float)) else f'{ws.cell(r,col).coordinate}={v!r}')\n    if vals:\n        print('R',r, ' '.join(vals))\nPY\n"]

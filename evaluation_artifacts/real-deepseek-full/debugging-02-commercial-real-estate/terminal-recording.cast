[14.699877, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwbf=openpyxl.load_workbook(p, data_only=False)\nwbv=openpyxl.load_workbook(p, data_only=True)\nwsf=wbf['Model']; wsv=wbv['Model']\nprint('DESCRIPTION:')\nprint(wbv['Description']['A1'].value)\nprint('\\nMODEL first 100 rows selected columns')\nfor r in range(1,101):\n    vals=[]\n    for col in range(1,16): # A-O\n        c=wsf.cell(row=r,column=col); v=wsv.cell(row=r,column=col).value\n        if c.value is not None or v is not None:\n            vals.append(f'{c.coordinate}={c.value!r} val={v!r}')\n    if vals:\n        print(f'R{r}:', ' | '.join(vals))\nprint('\\nRows 100-401 selected formulas/values (nonempty cols incl AE)')\nfor r in range(100, min(wsf.max_row,401)+1):\n    vals=[]\n    for col in range(1, 32):\n        c=wsf.cell(row=r,column=col); v=wsv.cell(row=r,column=col).value\n        if c.value is not None or v is not None:\n            vals.append(f'{c.coordinate} f={c.value!r} v={v!r}')\n    if vals:\n        print(f'R{r}:', ' | '.join(vals))\nPY\n"]

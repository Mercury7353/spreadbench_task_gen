[329.838418, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('/tmp/recalc/output.xlsx', data_only=True)\nbad=[]\nfor ws in wb.worksheets:\n    for row in ws.iter_rows():\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('#') and c.value[:2] in ('#R','#V','#D','#N','#N','#U','#N'):\n                bad.append((ws.title,c.coordinate,c.value))\nprint('errors', len(bad))\nfor x in bad[:30]: print(x)\nprint('\\nkey values')\nchecks=[('Construction','L33'),('Construction','S33'),('Construction','X34'),('Construction','Q39'),('Construction','AN39'),('Construction','AC43'),('P&L','G11'),('P&L','I11'),('P&L','AH13'),('P&L','W15'),('P&L','AJ15'),('P&L','AO15'),('P&L','M21'),('CFS','X12'),('CFS','AP12'),('CFS','AJ12'),('CFS','Y14'),('CFS','P19'),('CFS','S19'),('Ratios','U8'),('Ratios','AD10'),('Ratios','AE11'),('Ratios','AO24'),('Ratios','H27')]\nfor sh,coord in checks:\n    print(sh,coord, wb[sh][coord].value)\nPY\n"]

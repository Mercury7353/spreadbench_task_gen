[261.825512, "i", "python3 - <<'PY'\nimport openpyxl\nwb = openpyxl.load_workbook('/workspace/input.xlsx')\nfixes = {\n ('Construction','L33'): '=K35',\n ('Construction','S33'): '=R35',\n ('Construction','X34'): '=X27',\n ('Construction','Q39'): \"=(('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*Q33*TBA!P14)\",\n ('Construction','AN39'): \"=('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*AN33*TBA!AM14\",\n ('Construction','AC43'): '=AC16-AC28<0.01',\n ('P&L','G11'): '=-Operation!F21',\n ('P&L','I11'): '=-Operation!H21',\n ('P&L','AH13'): '=SUM(AH9:AH12)',\n ('P&L','W15'): '=Amortization!V13',\n ('P&L','AJ15'): '=Amortization!AI13',\n ('P&L','AO15'): '=Amortization!AN13',\n ('P&L','M21'): '=SUM(M17:M20)',\n ('CFS','X12'): \"='P&L'!X23\",\n ('CFS','AP12'): \"='P&L'!AP23\",\n ('CFS','AJ12'): \"='P&L'!AJ23\",\n ('CFS','Y14'): '=SUM(Y8:Y13)',\n ('CFS','P19'): '=P14+P16+P17',\n ('CFS','S19'): '=S14+S16+S17',\n ('Ratios','U8'): '=-Construction!T12',\n ('Ratios','AD10'): '=-Construction!AC14',\n ('Ratios','AE11'): '=-Construction!AD15',\n ('Ratios','AO24'): "]
[261.826074, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> wb = openpyxl.load_workbook('/workspace/input.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> fixes = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[261.826126, "i", "'=-Construction!AN26',\n ('Ratios','H27'): '=SUM(H24:H26)',\n}\nfor (sheet, coord), formula in fixes.items():\n    ws = wb[sheet]\n    old = ws[coord].value\n    ws[coord] = formula\n    print(sheet, coord, repr(old), '->', repr(formula))\nwb.save('/workspace/output.xlsx')\nprint('saved')\nPY\n"]
[261.826135, "o", " ('Construction','L33'): '=K35',\r\n\u001b[?2004l\r\u001b[?2004h>  ('Construction','S33'): '=R35',"]
[261.827162, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>  ('Construction','X34'): '=X27',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[261.828665, "o", " ('Construction','Q39'): \"=(('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*Q33*TBA!P14)\",\r\n\u001b[?2004l\r\u001b[?2004h>  ('Construction','AN39'): \"=('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*AN33*TBA!AM14\",\r\n\u001b[?2004l\r\u001b[?2004h>  ('Construction','AC43'): '=AC16-AC28<0.01',\r\n\u001b[?2004l\r\u001b[?2004h>  ('P&L','G11'): '=-Operation!F21',\r\n\u001b[?2004l\r\u001b[?2004h>  ('P&L','I11'): '=-Operation!H21',\r\n\u001b[?2004l\r\u001b[?2004h>  ('P&L','AH13'): '=SUM(AH9:AH12)',\r\n\u001b[?2004l\r\u001b[?2004h>  ('P&L','W15'): '=Amortization!V13',\r\n\u001b[?2004l\r\u001b[?2004h>  ('P&L','AJ15'): '=Amortization!AI13',\r\n\u001b[?2004l\r\u001b[?2004h>  ('P&L','AO15'): '=Amortization!AN13',\r\n\u001b[?2004l\r\u001b[?2004h>  ('P&L','M21'): '=SUM(M17:M20)',\r\n\u001b[?2004l\r\u001b[?2004h>  ('CFS','X12'): \"='P&L'!X23\",\r\n\u001b[?2004l\r\u001b[?2004h>  ('CFS','AP12'): \"='P&L'!AP23\",\r\n\u001b[?2004l\r\u001b[?2004h>  ('CFS','AJ12'): \"='P&L'!AJ23\",\r\n\u001b[?2004l\r\u001b[?2004h>  ('CFS','Y14'): '=SUM(Y8:Y13)',\r\n\u001b[?2004l\r\u001b[?2004h>  ('CFS','P19'): '=P14+P16+P17',\r\n\u001b[?2004l\r\u001b[?2004h>  ('CFS','S19'): '=S14+S16+S17',\r\n\u001b[?2004l\r\u001b[?2004h>  ('Ratios','U8'): '=-"]
[261.828688, "o", "Construction!T12',\r\n\u001b[?2004l\r\u001b[?2004h>  ('Ratios','AD10'): '=-Construction!AC14',\r\n\u001b[?2004l\r\u001b[?2004h>  ('Ratios','AE11'): '=-Construction!AD15',\r\n\u001b[?2004l\r\u001b[?2004h>  ('Ratios','AO24'): '=-Construction!AN26',\r\n\u001b[?2004l\r\u001b[?2004h>  ('Ratios','H27'): '=SUM(H24:H26)',\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> for (sheet, coord), formula in fixes.items():\r\n\u001b[?2004l\r\u001b[?2004h>     ws = wb[sheet]\r\n\u001b[?2004l\r\u001b[?2004h>     old = ws[coord].value\r\n\u001b[?2004l\r\u001b[?2004h>     ws[coord] = formula\r\n\u001b[?2004l\r\u001b[?2004h>     print(sheet, coord, repr(old), '->', repr(formula))\r\n\u001b[?2004l\r\u001b[?2004h> wb.save('/workspace/output.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> print('saved')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[261.828889, "o", "PY\r\n\u001b[?2004l\r"]
[261.921915, "o", "Construction L33 '=1+(K35)' -> '=K35'\r\nConstruction S33 '=-1*(R35)' -> '=R35'\r\n"]
[261.922025, "o", "Construction X34 '=-1*(X27)' -> '=X27'\r\nConstruction Q39 \"=1+(('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*Q33*TBA!P14)\" -> \"=(('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*Q33*TBA!P14)\"\r\nConstruction AN39 \"=('Input Assumptions'!$D$36+'Input Assumptions'!$D$36)*AN33*TBA!AM14\" -> \"=('Input Assumptions'!$D$35+'Input Assumptions'!$D$36)*AN33*TBA!AM14\"\r\nConstruction AC43 '=1+(AC16-AC28<0.01)' -> '=AC16-AC28<0.01'\r\nP&L G11 '=-1*(-Operation!F21)' -> '=-Operation!F21'\r\nP&L I11 '=-Operation!H22' -> '=-Operation!H21'\r\nP&L AH13 '=1+(SUM(AH9:AH12))' -> '=SUM(AH9:AH12)'\r\nP&L W15 '=-1*(Amortization!V13)' -> '=Amortization!V13'\r\nP&L AJ15 '=1+(Amortization!AI13)' -> '=Amortization!AI13'\r\n"]
[261.922052, "o", "P&L AO15 '=1+(Amortization!AN13)' -> '=Amortization!AN13'\r\nP&L M21 '=-1*(SUM(M17:M20))' -> '=SUM(M17:M20)'\r\n"]
[261.922064, "o", "CFS X12 \"=-1*('P&L'!X23)\" -> \"='P&L'!X23\"\r\nCFS AP12 \"=-1*('P&L'!AP23)\" -> \"='P&L'!AP23\"\r\n"]
[261.922118, "o", "CFS AJ12 \"='P&L'!AJ24\" -> \"='P&L'!AJ23\"\r\nCFS Y14 '=1+(SUM(Y8:Y13))' -> '=SUM(Y8:Y13)'\r\nCFS P19 '=1+(P14+P16+P17)' -> '=P14+P16+P17'\r\nCFS S19 '=1+(S14+S16+S17)' -> '=S14+S16+S17'\r\n"]
[261.922187, "o", "Ratios U8 '=1+(-Construction!T12)' -> '=-Construction!T12'\r\nRatios AD10 '=-1*(-Construction!AC14)' -> '=-Construction!AC14'\r\nRatios AE11 '=-1*(-Construction!AD15)' -> '=-Construction!AD15'\r\nRatios AO24 '=1+(-Construction!AN26)' -> '=-Construction!AN26'\r\nRatios H27 '=-1*(SUM(H24:H26))' -> '=SUM(H24:H26)'\r\n"]
[261.957402, "o", "saved\r\n"]

[175.462573, "o", "\r\n  last AS14 =SUM(AS8:AS13)\r\n  Y14 =1+(SUM(Y8:Y13))\r\nR 19 n 40\r\n  F19 =F14+F16+F17\r\n  last AS19 =AS14+AS16+AS17\r\n  P19 =1+(P14+P16+P17)\r\n  last S19 =1+(S14+S16+S17)\r\n"]

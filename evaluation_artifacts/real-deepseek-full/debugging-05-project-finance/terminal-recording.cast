[8.232314, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p, data_only=False)\nprint('Sheets:', wb.sheetnames)\nfor ws in wb.worksheets:\n    print('\\n### Sheet:', ws.title, 'dims', ws.dimensions, 'max', ws.max_row, ws.max_column)\n    for row in ws.iter_rows():\n        for c in row:\n            if c.value is not None:\n                print(f'{c.coordinate}: type={c.data_type} value={c.value!r}')\nPY\n"]

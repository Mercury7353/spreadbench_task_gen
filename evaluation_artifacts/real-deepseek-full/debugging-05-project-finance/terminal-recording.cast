[17.955297, "i", "python3 - <<'PY'\nimport openpyxl, os\np='/workspace/input.xlsx'\nwbF=openpyxl.load_workbook(p, data_only=False)\nwbV=openpyxl.load_workbook(p, data_only=True)\nos.makedirs('/tmp/dump', exist_ok=True)\nfor wb in (wbF, wbV):\n    for ws in wb.worksheets:\n        lines=[]\n        for row in ws.iter_rows():\n            for c in row:\n                if c.value is not None:\n                    lines.append(f'{c.coordinate}: {c.value!r}')\n        fn='/tmp/dump/'+('formulas' if wb is wbF else 'values')+'_'+ws.title.replace('/','_')+'.txt'\n        open(fn,'w').write('\\n'.join(lines)+'\\n')\nprint('Wrote dumps')\nprint('Sheet sizes formulas')\nfor ws in wbF.worksheets:\n    print(ws.title, ws.max_row, ws.max_column)\nprint('Formulas count by sheet:')\nfor ws in wbF.worksheets:\n    n=sum(c.data_type=='f' for row in ws.iter_rows() for c in row if c.value is not None)\n    print(ws.title, n)\nPY\n"]

[303.207243, "i", "python3 - <<'PY'\nimport openpyxl,re\nwb=openpyxl.load_workbook('/workspace/output.xlsx')\n\ndef colnum(ref):\n    nums=0\n    for ch in ref:\n        if ch.isalpha(): nums=nums*26+ord(ch)-64\n    return nums\n\nsheetmap = wb.sheetnames\nfor ws in wb.worksheets:\n    byrow={}\n    for row in ws.iter_rows():\n        cells=[]\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('='):\n                cells.append((c.coordinate,c.value))\n        if cells: byrow[c.row]=cells\n    for r,cells in sorted(byrow.items()):\n        recs=[]\n        for coord,v in cells:\n            # skip pure SUM ranges\n            if v.upper().startswith('=SUM('): continue\n            # parse sheet name and first external reference token after optional = at beginning, avoid SUM text\n            body=v[1:]\n            # look for patterns like 'Sheet'!E12 or E12, input assumptions absolute maybe input assumptions no external trow matters less\n            mm=re.findall(r\"'(?:[^']+)'!\\$?([A-Z]{1,3})\\$?(\\d+)|(?:^|[^A-Z])\\$?("]
[303.208752, "i", "[A-Z]{1,3})\\$?(\\d+)\", body)\n            if not mm: continue\n            # choose first candidate not inside function? good enough\n            tc, tr = mm[0][0] or mm[0][2], mm[0][1] or mm[0][3]\n            if not tc: continue\n            coord_col=re.match(r'([A-Z]+)',coord).group(1)\n            if len(coord_col)!=len(tc): continue\n            off=colnum(coord_col)-colnum(tc)\n            recs.append((coord, off, int(tr), tc, v))\n        if len(recs)>=3:\n            offs={}\n            for coord,off,tr,tc,v in recs:\n                offs.setdefault(off,[]).append((coord,tr,tc,v))\n            if len(offs)>1:\n                main=max(offs.items(), key=lambda kv: len(kv[1]))[0]\n                others=[(off,lst) for off,lst in offs.items() if off!=main]\n                # rows with total col offsets should not be flagged if only one cell at total\n                for off,lst in others:\n                    if len(lst)<=3:\n                        print(ws.title,'R',r,'mainoff',main,'off',off,'cells',[(x[0],x[1],x[2]) f"]

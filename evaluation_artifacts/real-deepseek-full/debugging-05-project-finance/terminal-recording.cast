[303.212102, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl,re\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook('/workspace/output.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def colnum(ref):\r\n\u001b[?2004l\r\u001b[?2004h>     nums=0\r\n\u001b[?2004l\r\u001b[?2004h>     for ch in ref:\r\n\u001b[?2004l\r\u001b[?2004h>         if ch.isalpha(): nums=nums*26+ord(ch)-64\r\n\u001b[?2004l\r\u001b[?2004h>     return nums\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> sheetmap = wb.sheetnames\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     byrow={}\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h>         cells=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for c in row:\r\n\u001b[?2004l\r\u001b[?2004h>             if isinstance(c.value,str) and c.value.startswith('='):\r\n\u001b[?2004l\r\u001b[?2004h>                 cells.append((c.coordinate,c.value))\r\n\u001b[?2004l\r\u001b[?2004h>         if cells: byrow[c.row]=cells\r\n\u001b[?2004l\r\u001b[?2004h>     for r,cells in sorted(byrow.items()):\r\n\u001b[?2004l\r\u001b[?2004h>         recs=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for coord,v in cells:\r\n\u001b[?2004l\r\u001b[?2004h>    "]
[303.212171, "o", "         # skip pure SUM ranges\r\n\u001b[?2004l\r\u001b[?2004h>             if v.upper().startswith('=SUM('): continue\r\n\u001b[?2004l\r\u001b[?2004h>             # parse sheet name and first external reference token after optional = at beginning, avoid SUM text\r\n\u001b[?2004l\r\u001b[?2004h>             body=v[1:]\r\n\u001b[?2004l\r\u001b[?2004h>             # look for patterns like 'Sheet'!E12 or E12, input assumptions absolute maybe input assumptions no external trow matters less\r\n\u001b[?2004l\r\u001b[?2004h>             mm=re.findall(r\"'(?:[^']+)'!\\$?([A-Z]{1,3})\\$?(\\d+)|(?:^|[^A-Z])\\$?([A-Z]{1,3})\\$?(\\d+)\", body)\r\n\u001b[?2004l\r\u001b[?2004h>             if not mm: continue\r\n\u001b[?2004l\r\u001b[?2004h>             # choose first candidate not inside function? good enough\r\n\u001b[?2004l\r\u001b[?2004h>             tc, tr = mm[0][0] or mm[0][2], mm[0][1] or mm[0][3]\r\n\u001b[?2004l\r\u001b[?2004h>             if not tc: continue\r\n\u001b[?2004l\r\u001b[?2004h>             coord_col=re.match(r'([A-Z]+)',coord).group(1)\r\n\u001b[?2004l\r\u001b[?2004h>             if len(coord_col)!=len(tc): continue\r\n\u001b[?2004l\r\u001b[?2004h>           "]
[303.21219, "o", "  off=colnum(coord_col)-colnum(tc)\r\n\u001b[?2004l\r\u001b[?2004h>             recs.append((coord, off, int(tr), tc, v))\r\n\u001b[?2004l\r\u001b[?2004h>         if len(recs)>=3:\r\n\u001b[?2004l\r\u001b[?2004h>             offs={}\r\n\u001b[?2004l\r\u001b[?2004h>             for coord,off,tr,tc,v in recs:\r\n\u001b[?2004l\r\u001b[?2004h>                 offs.setdefault(off,[]).append((coord,tr,tc,v))\r\n\u001b[?2004l\r\u001b[?2004h>             if len(offs)>1:\r\n\u001b[?2004l\r\u001b[?2004h>                 main=max(offs.items(), key=lambda kv: len(kv[1]))[0]\r\n\u001b[?2004l\r\u001b[?2004h>                 others=[(off,lst) for off,lst in offs.items() if off!=main]\r\n\u001b[?2004l\r\u001b[?2004h>                 # rows with total col offsets should not be flagged if only one cell at total\r\n\u001b[?2004l\r\u001b[?2004h>                 for off,lst in others:\r\n\u001b[?2004l\r\u001b[?2004h>                     if len(lst)<=3:\r\n\u001b[?2004l\r\u001b[?2004h>                         print(ws.title,'R',r,'mainoff',main,'off',off,'cells',[(x[0],x[1],x[2]) for x in lst[:5]])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

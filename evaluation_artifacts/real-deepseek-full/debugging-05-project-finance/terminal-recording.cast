[181.157642, "i", "python3 - <<'PY'\nimport openpyxl,re\nwb=openpyxl.load_workbook('/workspace/input.xlsx')\nlines=[]\nfor ws in wb.worksheets:\n    byrow={}\n    for row in ws.iter_rows():\n        cells=[]\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('='):\n                cells.append((c.coordinate,c.value))\n        if cells: byrow[c.row]=cells\n    inhom=[]\n    for r,cells in sorted(byrow.items()):\n        patts={}\n        for co,v in cells:\n            p=re.sub(r'[A-Z]{1,3}\\d+','@',v)\n            patts.setdefault(p,[]).append((co,v))\n        if len(patts)>1:\n            inhom.append((r,len(cells),patts))\n    if inhom:\n        lines.append('=== '+ws.title+' inhom rows '+str(len(inhom)))\n        for r,n,patts in inhom:\n            lines.append('R '+str(r)+' n '+str(n))\n            for p,lst in list(patts.items())[:6]:\n                lines.append('  '+lst[0][0]+' '+lst[0][1])\n                if len(lst)>1:\n                    lines.append('  last '+lst[-1][0]+' '+lst[-1][1])\nopen('/tmp/inhomogen"]
[181.159422, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl,re\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook('/workspace/input.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> lines=[]\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     byrow={}\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h>         cells=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for c in row:\r\n\u001b[?2004l\r\u001b[?2004h>             if isinstance(c.value,str) and c.value.startswith('='):\r\n\u001b[?2004l\r\u001b[?2004h>                 cells.append((c.coordinate,c.value))\r\n\u001b[?2004l\r\u001b[?2004h>         if cells: byrow[c.row]=cells\r\n\u001b[?2004l\r\u001b[?2004h>     inhom=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for r,cells in sorted(byrow.items()):\r\n\u001b[?2004l\r\u001b[?2004h>         patts={}\r\n\u001b[?2004l\r\u001b[?2004h>         for co,v in cells:\r\n\u001b[?2004l\r\u001b[?2004h>             p=re.sub(r'[A-Z]{1,3}\\d+','@',v)\r\n\u001b[?2004l\r\u001b[?2004h>             patts.setdefault(p,[]).append((co,v))\r\n\u001b[?2004l\r\u001b[?2004h>         if len(patts)>1:\r\n\u001b[?2004l\r\u001b[?2004h>             inhom.append((r,len(cells),patts))\r\n\u001b[?2004l\r\u001b[?200"]
[181.159774, "i", "eities.txt','w').write('\\n'.join(lines)+'\\n')\nprint('wrote',len(lines))\nPY\n"]

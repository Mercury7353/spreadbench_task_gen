[293.709539, "i", "python3 - <<'PY'\nimport openpyxl,re\nwb=openpyxl.load_workbook('/workspace/output.xlsx')\n\ndef colnum(ref):\n    letters=''.join(ch for ch in ref if ch.isalpha())\n    n=0\n    for ch in letters: n=n*26+ord(ch)-64\n    return n\n\ndef rowref(ref):\n    m=re.search(r'(\\d+)', ref)\n    return int(m.group(1)) if m else None\n\n# Specific external references in rows; report if offset from coordinate col differs from most cells.\nfor ws in wb.worksheets:\n    byrow={}\n    for row in ws.iter_rows():\n        cells=[]\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('='):\n                cells.append((c.coordinate,c.value))\n        if cells: byrow[c.row]=cells\n    for r,cells in sorted(byrow.items()):\n        # skip rows with C / D sum cells, but include all\n        recs=[]\n        for coord,v in cells:\n            # first external column reference with sheet! or plain at start\n            m=re.search(r\"(?:'?\\w+'?!)?([A-Z]+)(\\d+)\", v)\n            if not m: continue\n            tcol=m.group(1); tr"]
[293.710537, "i", "ow=int(m.group(2))\n            coord_col=re.match(r'([A-Z]+)',coord).group(1)\n            if len(coord_col)!=len(tcol): continue\n            recs.append((coord, coord_col, tcol, trow, v))\n        if len(recs)>2:\n            expected={}\n            for coord,cc,tc,tr,v in recs:\n                expected.setdefault(colnum(cc)-colnum(tc),[]).append((coord,tr,v))\n            if len(expected)>1:\n                # show rows where most have one offsets but some different\n                maxkey=max(expected.items(), key=lambda kv: len(kv[1]))\n                for off, lst in expected.items():\n                    if off!=maxkey[0] and len(lst)<=2:\n                        print(ws.title,'R',r,'offset',off,'vs main',maxkey[0],'cells',lst)\nPY\n"]

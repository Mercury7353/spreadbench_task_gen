[280.171264, "i", "python3 - <<'PY'\nimport openpyxl,re\nwb=openpyxl.load_workbook('/workspace/output.xlsx')\npatterns=['1+(','-1*(','D36+D36']\nprint('SUSPICIOUS REAL STRINGS')\nfor ws in wb.worksheets:\n    for row in ws.iter_rows():\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('='):\n                if any(p in c.value for p in patterns):\n                    print(ws.title, c.coordinate, c.value)\nprint('\\nROW DIFFS likely off-by-one sample')\nfor ws in wb.worksheets:\n    byrow={}\n    for row in ws.iter_rows():\n        cells=[]\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('='):\n                cells.append((c.coordinate,c.value))\n        if cells: byrow[c.row]=cells\n    for r,cells in sorted(byrow.items()):\n        # for simple translated formulas, show if not all formulas have same suffix target shift\n        norm=[]\n        for coord, v in cells:\n            # just report if pattern is ...!X## where X matches coord letter or -1/+1\n            pass\nPY\n"]

[175.455382, "o", "  E12 =E8\r\n  last AR12 =AR8\r\nR 13 n 41\r\n  C13 =SUM(E13:AR13)\r\n  E13 =E37\r\n  last AR13 =AR37\r\nR 14 n 41\r\n  C14 =SUM(E14:AR14)\r\n  E14 =E38\r\n  last AR14 =AR38\r\nR 15 n 41\r\n  C15 =SUM(E15:AR15)\r\n  E15 =E39\r\n  last AR15 =AR39\r\nR 26 n 41\r\n  C26 =SUM(E26:AR26)\r\n  E26 =IF(MAX($C$22-SUM($D$26:D26),0)>E19,E19,MAX($C$22-SUM($D$26:D26),0))\r\n  last AR26 =IF(MAX($C$22-SUM($D$26:AQ26),0)>AR19,AR19,MAX($C$22-SUM($D$26:AQ26),0))\r\nR 27 n 41\r\n  C27 =SUM(E27:AR27)\r\n  E27 =IF(E19-E26>0,E19-E26,0)\r\n  last AR27 =IF(AR19-AR26>0,AR19-AR26,0)\r\nR 28 n 41\r\n  C28 =SUM(E28:AR28)\r\n  last AR28 =SUM(AR26:AR27)\r\n  AA28 =-1*(SUM(AA26:AA27))\r\n"]

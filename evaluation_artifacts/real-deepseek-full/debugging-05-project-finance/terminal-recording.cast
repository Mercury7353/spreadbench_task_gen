[175.457909, "o", "=== Amortization inhom rows 1\r\nR 13 n 41\r\n  D13 =SUM(E13:AR13)\r\n  E13 =-Construction!$C$20/('Input Assumptions'!$D$8-'Input Assumptions'!$D$9)*TBA!D10\r\n  last AR13 =-Construction!$C$20/('Input Assumptions'!$D$8-'Input Assumptions'!$D$9)*TBA!AQ10\r\n"]
[175.461444, "o", "=== P&L inhom rows 4\r\nR 11 n 40\r\n  F11 =-Operation!E21\r\n  last AS11 =-Operation!AR21\r\n  G11 =-1*(-Operation!F21)\r\nR 13 n 40\r\n  F13 =SUM(F9:F12)\r\n  last AS13 =SUM(AS9:AS12)"]
[175.461673, "o", "\r\n  AH13 =1+(SUM(AH9:AH12))\r\nR 15 n 40\r\n  F15 =Amortization!E13\r\n  last AS15 =Amortization!AR13\r\n  W15 =-1*(Amortization!V13)\r\n  AJ15 =1+(Amortization!AI13)\r\n  last AO15 =1+(Amortization!AN13)\r\nR 21 n 40\r\n  F21 =SUM(F17:F20)\r\n  last AS21 =SUM(AS17:AS20)\r\n  M21 =-1*(SUM(M17:M20))\r\n"]

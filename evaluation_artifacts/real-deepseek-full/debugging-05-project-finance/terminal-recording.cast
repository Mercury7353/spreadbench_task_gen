[130.834672, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('/workspace/input.xlsx')\nlines=[]\nfor ws in wb.worksheets:\n    lines.append('=== '+ws.title)\n    byrow={}\n    for row in ws.iter_rows():\n        cells=[(c.coordinate,c.value) for c in row if isinstance(c.value,str) and c.value.startswith('=')]\n        if cells: byrow[c.row]=cells\n    for r in sorted(byrow):\n        cells=byrow[r]\n        uniq=[]; seen=set()\n        for co,v in cells:\n            if v not in seen:\n                seen.add(v); uniq.append((co,v))\n        lines.append(f'R{r}: {cells[0][0]}-{cells[-1][0]} n={len(cells)}')\n        for co,v in uniq[:5]:\n            lines.append('  '+co+' '+v)\n        lines.append('')\nopen('/tmp/summary.txt','w').write('\\n'.join(lines)+'\\n')\nprint('written', len(lines))\nPY\n"]

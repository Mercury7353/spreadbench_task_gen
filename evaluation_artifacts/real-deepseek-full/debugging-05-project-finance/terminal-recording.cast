[175.455719, "o", "  AN39 =('Input Assumptions'!$D$36+'Input Assumptions'!$D$36)*AN33*TBA!AM14\r\nR 43 n 40\r\n  E43 =E16-E28<0.01\r\n  last AR43 =AR16-AR28<0.01\r\n  AC43 =1+(AC16-AC28<0.01)\r\n"]
[175.45727, "o", "=== Operation inhom rows 3\r\nR 10 n 41\r\n  D10 =SUM(E10:AR10)\r\n  E10 =E7*'Input Assumptions'!$D$20/1000\r\n  last AR10 =AR7*'Input Assumptions'!$D$20/1000\r\nR 11 n 41\r\n  D11 =SUM(E11:AR11)\r\n  E11 =E8*'Input Assumptions'!$D$21/1000"]

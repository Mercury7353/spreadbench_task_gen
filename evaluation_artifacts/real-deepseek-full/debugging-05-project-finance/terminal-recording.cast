[310.313069, "o", "\u001b[?2004l\r\u001b[?2004h> bad=[]\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h>         for c in row:\r\n\u001b[?2004l\r\u001b[?2004h>             if isinstance(c.value,str) and c.value.startswith('='):\r\n\u001b[?2004l\r\u001b[?2004h>                 if any(x in c.value for x in ['1+(','-1*(','D36+D36']):\r\n\u001b[?2004l\r\u001b[?2004h>                     bad.append((ws.title,c.coordinate,c.value))\r\n\u001b[?2004l\r\u001b[?2004h> print('suspicious remaining:', len(bad))\r\n\u001b[?2004l\r\u001b[?2004h> for x in bad[:20]: print(x)\r\n\u001b[?2004l\r\u001b[?2004h> print('sheets', wb.sheetnames)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

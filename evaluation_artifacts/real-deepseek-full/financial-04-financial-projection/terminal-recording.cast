[121.462516, "o", "\r\n== 21. Financial Diagnostics ==\r\nR13 label=\"Owner's Cash Injection into the Business\" pres=['G', 'I'] miss=['H', 'J', 'K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R'] ex=[\"G13:=IF('1. Required Start-Up Funds'!G42=0,0,'1. Required Start-Up Funds'!G37/'1. Required Start-Up Funds'!G42)\", 'I13:=IF(G13>0.2,\"Owner\\'s injection is reasonable\",\"Owner\\'s injection might be too low in relation to the amount of money needed\")']\r\nR14 label='Cash Request as percent of Total Required Funds' pres=['G', 'I'] miss=['H', 'J', 'K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R'] ex=[\"G14:=IF('1. Required Start-Up Funds'!G31=0,0,'1. Required Start-Up Funds'!E28/'1. Required Start-Up Funds'!G31)\", 'I14:=IF(G14<0.2,\"Cash request seems reasonable with respect to total request\",\"Cash request exceeds 20% which might be high\")']\r\nR17 label='Commercial Loan Interest rate' pres=['G', 'I'] miss=['H', 'J', 'K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R'] ex=[\"G17:='1. Required Start-Up Funds'!H40\", 'I17:=IF(G17<0.06,\"Interest rate may be too low for the type of loan "]

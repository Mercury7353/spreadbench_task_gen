[32.650231, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p, data_only=False)\nout=[]\nfor ws in wb.worksheets:\n    out.append(f'\\n== {ws.title} ==')\n    for row in range(1, ws.max_row+1):\n        nonempty=[]\n        blank=[]\n        for col in range(1, ws.max_column+1):\n            c=ws.cell(row=row, column=col)\n            if c.value is not None:\n                nonempty.append((col,openpyxl.utils.get_column_letter(col),repr(c.value)))\n            else:\n                blank.append(openpyxl.utils.get_column_letter(col))\n        if 7 <= len(nonempty) <= ws.max_column-1 and len(blank)>=1 and any(col>=7 for col,_ in nonempty):\n            out.append(f'row {row}: nonempty_months={[co for co,v in nonempty if col>=7]} blank_months={[letter for letter in blank if ord(letter[0])-64>=7]}')\nopen('/workspace/missing_candidates.txt','w').write('\\n'.join(out)+'\\n')\nprint('written')\nPY\nhead -n 120 /workspace/missing_candidates.txt\n"]

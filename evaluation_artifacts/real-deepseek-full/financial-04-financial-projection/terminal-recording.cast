[106.504973, "i", "python3 - <<'PY' > /workspace/formula_candidates.txt\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\ndollar=openpyxl.styles.numbers.FORMAT_CURRENCY_USD_SIMPLE\n\ndef fmtname(f):\n    if not f: return ''\n    f=str(f)\n    if f.startswith('_'): return 'num'\n    if f in ('0%','0.0%'): return 'pct'\n    if f=='General': return 'gen'\n    return f[:20]\nfor ws in wb.worksheets:\n    print('\\n==',ws.title,'==')\n    for row in range(1, ws.max_row+1):\n        label=''\n        for col in range(1,4):\n            v=ws.cell(row=row,column=col).value\n            if isinstance(v,str) and len(v)>1:\n                label=v\n                break\n        if not label:\n            label=' '.join(str(ws.cell(row=row,column=c).value) for c in range(1,4) if ws.cell(row=row,column=c).value is not None)\n        blanks=[]\n        for col in range(7, ws.max_column+1):\n            c=ws.cell(row=row,column=col)\n            if c.value is None and c.has_style:\n                f=c"]

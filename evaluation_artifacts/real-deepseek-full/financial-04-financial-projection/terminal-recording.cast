[311.63148, "o", "== 21. Financial Diagnostics ==\r\n1 MISS Q1 FORMS A1 LABEL ='1. Required Start-Up Funds'!A1\r\n13 MISS J13,K13 FORMS G13,I13 LABEL Owner's Cash Injection into the Business\r\n14 MISS J14,K14 FORMS G14,I14 LABEL Cash Request as percent of Total Required Funds\r\n20 MISS H20,J20,K20 FORMS G20,I20 LABEL Commercial Mortgage Interest rate\r\n21 MISS H21,J21,K21 FORMS G21,I21 LABEL Commercial Mortgage Term in Months\r\n23 MISS H23,J23,K23 FORMS G23,I23 LABEL Loan Payments as a Percent of Projected Sales\r\n26 MISS H26,J26,K26 FORMS G26,I26 LABEL Gross Margin as a Percent of Sales\r\n27 MISS H27,J27,K27 FORMS G27,I27 LABEL Owner's Compensation Lower Limit Check\r\n28 MISS H28,J28,K28 FORMS G28,I28 LABEL Owner's Compensation Upper Limit Check\r\n29 MISS H29,J29,K29 FORMS G29,I29 LABEL Advertising Expense Levels as a Percent of Sales\r\n30 MISS H30,J30,K30 FORMS G30,I30 LABEL Profitability Levels\r\n31 MISS F31,H31,J31,K31 FORMS G31,I31 LABEL Profitability as a Percent of Sales\r\n34 MISS H34,J34,K34 FORMS G34,I34 LABEL Desired Operating cash"]
[311.631664, "o", " Flow Levels\r\n35 MISS H35,J35,K35 FORMS G35,I35 LABEL Line of Credit Drawdowns\r\n36 MISS F36,H36,J36,K36 FORMS G36,I36 LABEL Accounts Receivable Ratio to Sales\r\n39 MISS H39,J39,K39 FORMS G39,I39 LABEL Does the Base Period Balance Sheet Balance?\r\n40 MISS H40,J40,K40 FORMS G40,I40 LABEL Does the Final Balance Sheet Balance\r\n41 MISS H41,J41,K41 FORMS G41,I41 LABEL Debt to Equity Ratio\r\n44 MISS H44,J44,K44 FORMS G44,I44 LABEL Breakeven Levels\r\n"]

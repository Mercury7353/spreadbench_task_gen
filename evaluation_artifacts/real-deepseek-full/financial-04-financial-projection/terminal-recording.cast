[272.480117, "o", "K50 FORMS F50,I50 LABEL \r\n\r\n== 18. Financial Ratios ==\r\n1 MISS Q1 FORMS A1 LABEL ='1. Required Start-Up Funds'!A1\r\n8 MISS H8,J8 FORMS G8,I8,K8 LABEL Current Ratio\r\n9 MISS H9,J9 FORMS G9,I9,K9 LABEL Quick Ratio\r\n11 MISS H11,J11 FORMS G11,I11,K11 LABEL Debt to Equity Ratio\r\n12 MISS H12,J12 FORMS G12,I12,K12 LABEL Debt to Coverage Ratio\r\n14 MISS H14,J14 FORMS I14,K14 LABEL Sales Growth \r\n15 MISS H15,J15 FORMS G15,I15,K15 LABEL COGS to Sales\r\n16 MISS H16,J16 FORMS G16,I16,K16 LABEL Gross Profit Margin\r\n17 MISS H17,J17 FORMS G17,I17,K17 LABEL SG&A to Sales\r\n18 MISS H18,J18 FORMS G18,I18,K18 LABEL Net Profit Margin\r\n19 MISS H19,J19 FORMS G19,I19,K19 LABEL Return on Equity\r\n20 MISS H20,J20 FORMS G20,I20,K20 LABEL Return on Assets\r\n21 MISS H21,J21 FORMS G21,I21,K21 LABEL Owner's Compensation to Sales\r\n23 MISS H23,J23 FORMS G23,I23,K23 LABEL Days in Receivables\r\n24 MISS H24,J24 FORMS G24,I24,K24 LABEL Accounts Receivable Turnover\r\n25 MISS H25,J25 FORMS G25,I25,K25 LABEL Days in Inventory\r\n26 MISS F26,H26,J26 FORMS G26"]
[272.480121, "o", ",I26,K26 LABEL Inventory Turnover\r\n27 MISS F27,H27,J27 FORMS G27,I27,K27 LABEL Sales to Total Assets\r\n\r\n== 19. Breakeven Analysis ==\r\n1 MISS Q1 FORMS A1 LABEL ='1. Required Start-Up Funds'!A1\r\n8 MISS J8,K8 FORMS G8,I8 LABEL Cost of Sales\r\n9 MISS J9,K9 FORMS G9,I9 LABEL Gross Margin\r\n11 MISS I11,J11,K11 FORMS G11 LABEL Salaries and Wages\r\n15 MISS H15,I15,J15,K15 FORMS G15 LABEL Breakeven Sales Calculation\r\n16 MISS H16,I16,J16,K16 FORMS G16 LABEL \r\n18 MISS H18,I18,J18,K18 FORMS G18 LABEL Breakeven Sales in Dollars\r\n\r\n== 20. Amoritization Schedule ==\r\n1 MISS S1 FORMS A1 LABEL ='1. Required Start-Up Funds'!A1\r\n16 MISS G16,P16 FORMS H16,I16,J16,K16,L16,M16,N16,O16,Q16,R16 LABEL Principal\r\n17 MISS S17 FORMS G17,H17,I17,J17,K17,L17,M17,N17,O17,P17 LABEL Loan Balance\r\n19 MISS H19,I19,P19 FORMS G19,J19,K19,L19,M19,N19,O19,Q19,R19,S19 LABEL Interest\r\n21 MISS O21,P21,R21,S21 FORMS G21,H21,I21,J21,K21,L21,M21,N21,Q21 LABEL Loan Balance\r\n23 MISS K23 FORMS G23,H23,I23,J23,L23,M23,N23,O23,P23,Q23 LABEL Interest\r\n24 MISS H2"]

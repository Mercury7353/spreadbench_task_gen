[93.858152, "o", "\r\n=== 1. Required Start-Up Funds ===\r\n"]
[93.858247, "o", "\r\nROW 1 : A1='=Introduction!B19' | M1='=NOW()'\r\n\r\nROW 2 : A2='Required Start-Up Funds'\r\n"]
[93.858519, "o", "\r\nROW 6 : A6='Required Start-Up Funds' | E6='Amount' | G6='Totals' | H6='Depreciation' | J6='Notes'\r\n\r\nROW 7 : B7='Fixed Assets'\r\n\r\nROW 8 : C8='Real Estate' | E8=0\r\n\r\nROW 9 : C9='Buildings' | E9=0 | H9=20 | I9=' years'\r\n"]
[93.858562, "o", "\r\nROW 10 : C10='Leasehold Improvements' | E10=0 | H10=7 | I10=' years'"]
[93.858617, "o", "\r\n\r\nROW 11 : C11='Equipment' | E11=0 | H11=7 | I11=' years'\r\n"]
[93.858672, "o", "\r\nROW 12 : C12='Furniture and Fixtures' | E12=0 | H12=5 | I12=' years'\r\n"]
[93.858734, "o", "\r\nROW 13 : C13='Vehicles' | E13=0 | H13=5 | I13=' years'\r\n\r\nROW 14 : C14='Other Fixed Assets' | E14=0 | H14=5 | I14=' years'\r\n"]
[93.858772, "o", "\r\nROW 15 : B15='Total Fixed Assets' | G15='=SUM(E8:E14)'\r\n"]
[93.858812, "o", "\r\nROW 17 : B17='Operating Capital'\r\n"]
[93.858871, "o", "\r\nROW 18 : C18='Pre-Opening Salaries and Wages' | E18=0\r\n"]
[93.85889, "o", "\r\nROW 19 : C19='Prepaid Insurance Premiums' | E19=0\r\n"]
[93.858893, "o", "\r\nROW"]
[93.858923, "o", " 20 : C20='Beginning Inventory' | E20=0\r\n"]
[93.859008, "o", "\r\nROW 21 : C21='Legal and Accounting Fees' | E21=0\r\n\r\nROW 22 : C22='Rent Deposits' | E22=0\r\n\r\nROW 23 : C23='Utility Deposits' | E23=0\r\n"]
[93.859057, "o", "\r\nROW 24 : C24='Supplies' | E24=0\r\n\r\nROW 25 : C25='Advertising and Promotions' | E25=0\r\n"]
[93.859102, "o", "\r\nROW 26 : C26='Licenses' | E26=0\r\n"]
[93.859151, "o", "\r\nROW 27 : C27='Other Initial Start-Up Costs' | E27=0\r\n"]
[93.859169, "o", "\r\nROW 28 : C28='Working Capital (Cash On Hand)' | E28=0\r\n"]
[93.859215, "o", "\r\nROW 29 : B29='Total Operating Capital' | G29='=SUM(E18:E28)'\r\n"]
[93.859283, "o", "\r\nROW 31 : A31='Total Required Funds' | G31='=G15+G29'\r\n"]
[93.859443, "o", "\r\nROW 36 : A36='Sources of Funding' | E36='Amount' | G36='Totals' | H36='Loan Rate' | I36='Term in Months' | J36='Monthly Payments'\r\n"]
[93.859482, "o", "\r\nROW 37 : B37=\"Owner's Cash Injection\" | E37='=IF(G37=0,0,G37/G42)' | G37=0\r\n"]
[93.859555, "o", "\r\nROW 38 : B38='Outside Investors' | E38='=IF(G38=0,0,G38/G42)' | G38=0\r\n\r\nROW 39 : B39='Additional Loans or Debt'\r\n"]
[93.859633, "o", "\r\nROW 40 : C40='Commercial Loan' | E40='=IF(G40=0,0,G40/G42)' | G40='=(G31-E8-E9)-((G37+G38)-(E8+E9-G41))' | H40=0.09 | I40='=7*12' | J40='=ABS(PMT(H40/12,I40,G40))'\r\n\r\nROW 41 : C41='Commercial Mortgage' | E41='=IF(G41=0,0,G41/G42)' | G41='=IF((G31-G37+G38)<(E8+E9)*0.8,G31-G37+G38,(E8+E9)*0.8)' | H41=0.09 | I41='=20*12' | J41='=ABS(PMT(H41/12,I41,G41))'\r\n"]
[93.859661, "o", "\r\nROW 42 : A42='Total Sources of Funding' | E42='=SUM(E37:E41)' | G42='=SUM(G37:G41)' | J42='=J40+J41'\r\n"]
[93.859739, "o", "\r\nROW 44 : A44='=IF(\\'9. Cash Flow Statement\\'!Q35>0,\"A line of credit is also required in the amount of\",\"\")' | G44='=IF(\\'9. Cash Flow Statement\\'!Q35>0,\\'9. Cash Flow Statement\\'!Q35,\"\")'\r\n"]

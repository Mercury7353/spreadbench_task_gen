[449.794377, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(p)\ndef setf(sheet, cell, f): wb[sheet][cell]=f\n# Remaining obvious holes\nsetf('8. Income Statement','N36','=M36')\nfor cell,f in [('E29','=SUM(E17:E28)'),('F29','=SUM(F17:F28)'),('I33','=I8+I31'),('O33','=O8+O31'),('P33','=P8+P31'),('K35',\"=IF((K33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!K33,0)\"),('L35',\"=IF((L33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!L33,0)\"),('Q37','=SUM(E37:P37)'),('K40','=J40+K35-K27')]:\n    setf('13. Cash Flow Statement (2)',cell,f)\nfor cell,f in [('H6',\"='4. Projected Sales Forecast'!K6\"),('O6',\"='4. Projected Sales Forecast'!R6\")]:\n    setf('16. Cash Flow Statement (3)',cell,f)\nsetf('20. Amoritization Schedule','G6',\"='4. Projected Sales Forecast'!H6\")\nsetf('20. Amoritization Schedule','S45','=SUM(G45:R45)')\nwb.save('/workspace/output.xlsx')\nprint('saved remaini"]
[449.794439, "i", "ng')\nPY\n"]

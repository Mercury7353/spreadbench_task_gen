[434.691721, "o", "\r\n== 8. Income Statement ==\r\nR 36 MISS N FORMS E,F,G,H,I,J,K,L,M,O,P,Q\r\n\r\n== 9. Cash Flow Statement ==\r\n\r\n== 12. Income Statement (2) ==\r\n\r\n== 13. Cash Flow Statement (2) ==\r\nR 28 MISS Q FORMS E,F,G,H,I,J,K,L,M,N,O,P\r\nR 29 MISS E,F FORMS G,H,I,J,K,L,M,N,O,P,Q\r\nR 33 MISS I,O,P,Q FORMS E,F,G,H,J,K,L,M,N\r\nR 35 MISS K,L FORMS E,F,G,H,I,J,M,N,O,P,Q\r\nR 37 MISS Q FORMS E,F,G,H,I,J,K,L,M,N,O,P\r\nR 40 MISS K,Q FORMS E,F,G,H,I,J,L,M,N,O,P\r\n\r\n== 15. Income Statement (3) ==\r\n\r\n== 16. Cash Flow Statement (3) ==\r\nR 6 MISS H,O FORMS E,F,G,I,J,K,L,M,N,P,Q\r\n\r\n== 20. Amoritization Schedule ==\r\nR 6 MISS G FORMS H,I,J,K,L,M,N,O,P,Q,R,S\r\nR 45 MISS S FORMS G,H,I,J,K,L,M,N,O,P,Q,R\r\n"]
[434.691854, "o", "\u001b[?2004hroot@ec36e9e3f29d:/workspace# "]
[442.390661, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(p)\nfor sheet, rows in [('13. Cash Flow Statement (2)',[28,29,33,35,37,40]),('16. Cash Flow Statement (3)',[6]),('8. Income Statement',[36]),('20. Amoritization Schedule',[6,45])]:\n    ws=wb[sheet]\n    print('\\n===',sheet,'===')\n    for r in rows:\n        vals=[]\n        for col in range(1, ws.max_column+1):\n            v=ws.cell(row=r,column=col).value\n            if v is not None:\n                vals.append(f'{ws.cell(row=r,column=col).coordinate}={v!r}')\n        print('R',r, ' | '.join(vals))\nPY\n"]
[442.392335, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> p='/workspace/output.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(p)\r\n\u001b[?2004l\r\u001b[?2004h> for sheet, rows in [('13. Cash Flow Statement (2)',[28,29,33,35,37,40]),('16. Cash Flow Statement (3)',[6]),('8. Income Statement',[36]),('20. Amoritization Schedule',[6,45])]:\r\n\u001b[?2004l\r\u001b[?2004h>     ws=wb[sheet]\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n===',sheet,'===')\r\n\u001b[?2004l\r\u001b[?2004h>     for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>         vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for col in range(1, ws.max_column+1):\r\n\u001b[?2004l\r\u001b[?2004h>             v=ws.cell(row=r,column=col).value\r\n\u001b[?2004l\r\u001b[?2004h>             if v is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 vals.append(f'{ws.cell(row=r,column=col).coordinate}={v!r}')\r\n\u001b[?2004l\r\u001b[?2004h>         print('R',r, ' | '.join(vals))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[442.546171, "o", "\r\n=== 13. Cash Flow Statement (2) ===\r\nR 28 C28='Dividends Paid' | E28=0 | F28=0 | G28=0 | H28=0 | I28=0 | J28=0 | K28=0 | L28=0 | M28=0 | N28=0 | O28=0 | P28=0\r\n"]
[442.546687, "o", "R 29 A29='Total Cash Outflows' | G29='=SUM(G17:G28)' | H29='=SUM(H17:H28)' | I29='=SUM(I17:I28)' | J29='=SUM(J17:J28)' | K29='=SUM(K17:K28)' | L29='=SUM(L17:L28)' | M29='=SUM(M17:M28)' | N29='=SUM(N17:N28)' | O29='=SUM(O17:O28)' | P29='=SUM(P17:P28)' | Q29='=SUM(Q17:Q28)'\r\nR 33 A33='Operating Cash Balance' | E33='=E8+E31' | F33='=F8+F31' | G33='=G8+G31' | H33='=H8+H31' | J33='=J8+J31' | K33='=K8+K31' | L33='=L8+L31' | M33='=M8+M31' | N33='=N8+N31'\r\nR 35 A35='Line of Credit Drawdowns' | E35=\"=IF((E33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!E33,0)\" | F35=\"=IF((F33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!F33,0)\" | G35=\"=IF((G33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!G33,0)\" | H35=\"=IF((H33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!H33"]
[442.546729, "o", ",0)\" | I35=\"=IF((I33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!I33,0)\" | J35=\"=IF((J33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!J33,0)\" | M35=\"=IF((M33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!M33,0)\" | N35=\"=IF((N33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!N33,0)\" | O35=\"=IF((O33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!O33,0)\" | P35=\"=IF((P33-'6. Cash Receipts-Disbursements'!$G$21)<0,'6. Cash Receipts-Disbursements'!$G$21-'13. Cash Flow Statement (2)'!P33,0)\" | Q35='=SUM(E35:P35)'\r\nR 37 A37='Ending Cash Balance' | E37='=E33+E35' | F37='=F33+F35' | G37='=G33+G35' | H37='=H33+H35' | I37='=I33+I35' | J37='=J33+J35' | K37='=K33+K35' | L37='=L33+L35' | M37='=M33+M35' | "]
[442.546758, "o", "N37='=N33+N35' | O37='=O33+O35' | P37='=P33+P35'\r\nR 40 A40='Line of Credit Balance' | E40=\"=E35+'9. Cash Flow Statement'!P40-'13. Cash Flow Statement (2)'!E27\" | F40='=E40+F35-F27' | G40='=F40+G35-G27' | H40='=G40+H35-H27' | I40='=H40+I35-I27' | J40='=I40+J35-J27' | L40='=K40+L35-L27' | M40='=L40+M35-M27' | N40='=M40+N35-N27' | O40='=N40+O35-O27' | P40='=O40+P35-P27'\r\n\r\n=== 16. Cash Flow Statement (3) ===\r\nR 6 E6=\"='4. Projected Sales Forecast'!H6\" | F6=\"='4. Projected Sales Forecast'!I6\" | G6=\"='4. Projected Sales Forecast'!J6\" | I6=\"='4. Projected Sales Forecast'!L6\" | J6=\"='4. Projected Sales Forecast'!M6\" | K6=\"='4. Projected Sales Forecast'!N6\" | L6=\"='4. Projected Sales Forecast'!O6\" | M6=\"='4. Projected Sales Forecast'!P6\" | N6=\"='4. Projected Sales Forecast'!Q6\" | P6=\"='4. Projected Sales Forecast'!S6\" | Q6='Totals'\r\n\r\n=== 8. Income Statement ===\r\n"]

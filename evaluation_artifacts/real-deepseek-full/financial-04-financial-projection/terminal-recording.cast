[149.771756, "o", "\r\n==== Introduction ====\r\n\r\n==== 1. Required Start-Up Funds ====\r\n\r\n==== 2. Salaries and Wages ====\r\n\r\n==== 3. Fixed Operating Expenses ====\r\n\r\n==== 4. Projected Sales Forecast ====\r\n\r\n==== 5. Projected Sales Forecast (2) ====\r\n\r\n==== 6. Cash Receipts-Disbursements ====\r\n\r\n==== 7. Beginning Balance Sheet ====\r\n\r\n==== 8. Income Statement ====\r\nR09 cells=E9,F9,G9,I9,J9,K9,L9,M9,N9,O9,P9,Q9 missing=H9 label=\"='4. Projected Sales Forecast'!A8\"\r\nR12 cells=E12,F12,G12,H12,I12,J12,K12,L12,M12,N12,O12,Q12 missing=P12 label='=IF(\\'5. Projected Sales Forecast (2)\\'!E31>0,\\'5. Projected Sales Forecast (2)\\'!A30,\"\")'\r\nR16 cells=F16,G16,H16,I16,J16,K16,L16,M16,O16,P16,Q16 missing=E16,N16 label='=B9'\r\nR18 cells=E18,F18,G18,H18,J18,K18,L18,M18,N18,O18,P18,Q18 missing=I18 label='=B11'\r\nR27 cells=E27,F27,G27,H27,I27,J27,K27,L27,M27,O27,P27,Q27 missing=N27 label=\"='2. Salaries and Wages'!C14\"\r\nR28 cells=F28,G28,H28,I28,J28,K28,L28,M28,N28,O28,P28,Q28 missing=E28 label=\"='2. Salaries and Wages'!C17\"\r\nR30 cells=F30,G30,H30,I30,J"]

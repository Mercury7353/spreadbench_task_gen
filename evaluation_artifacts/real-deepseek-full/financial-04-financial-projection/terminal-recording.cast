[9.125974, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nfor ws in wb.worksheets:\n    print('SHEET', ws.title, 'dims', ws.calculate_dimension(), 'max', ws.max_row, ws.max_column)\n    print('formulas:')\n    count=0\n    for row in ws.iter_rows():\n        for c in row:\n            if isinstance(c.value, str) and c.value.startswith('='):\n                print(c.coordinate, repr(c.value))\n                count+=1\n    print('formula_count', count)\n    print('empty or non-contiguous? first empty cells near used range')\nPY\n"]

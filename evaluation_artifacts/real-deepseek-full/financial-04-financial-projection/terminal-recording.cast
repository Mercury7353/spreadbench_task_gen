[337.374419, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nfor sheet, rows in [('1. Required Start-Up Funds',[6,7]),('2. Salaries and Wages',[6,7]),('3. Fixed Operating Expenses',[6,7,8]),('4. Projected Sales Forecast',[6,7,8]),('6. Cash Receipts-Disbursements',[6,7])]:\n    ws=wb[sheet]\n    print('\\n===',sheet,'===')\n    for r in rows:\n        vals=[]\n        for col in range(1, ws.max_column+1):\n            v=ws.cell(row=r,column=col).value\n            if v is not None:\n                vals.append(f'{ws.cell(row=r,column=col).coordinate}={v!r}')\n        print('R',r, ' | '.join(vals))\nPY\n"]

[133.873776, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nfor sheet, rows in [('8. Income Statement',[9,12,16,18,27,34,36,40]),('12. Income Statement (2)',[9,11,12,16,18,20,22,25,27,29,34,36,40]),('15. Income Statement (3)',[9,11,12,16,18,20,22,25,27,29,34,36,40]),('9. Cash Flow Statement',[8,12,13,19,21,25,26,29,33,35,40]),('13. Cash Flow Statement (2)',[8,11,12,13,19,21,25,29,33,35,40]),('16. Cash Flow Statement (3)',[8,11,12,13,19,21,25,29,33,35,40])]:\n    ws=wb[sheet]\n    print('\\n===', sheet, '===')\n    for r in rows:\n        print('ROW', r)\n        for c in range(1, ws.max_column+1):\n            v=ws.cell(row=r,column=c).value\n            if v is not None:\n                print(f'  {ws.cell(row=r,column=c).coordinate}: {v!r}')\nPY\n"]
[133.879024, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> p='/workspace/input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(p)\r\n\u001b[?2004l\r\u001b[?2004h> for sheet, rows in [('8. Income Statement',[9,12,16,18,27,34,36,40]),('12. Income Statement (2)',[9,11,12,16,18,20,22,25,27,29,34,36,40]),('15. Income Statement (3)',[9,11,12,16,18,20,22,25,27,29,34,36,40]),('9. Cash Flow Statement',[8,12,13,19,21,25,26,29,33,35,40]),('13. Cash Flow Statement (2)',[8,11,12,13,19,21,25,29,33,35,40]),('16. Cash Flow Statement (3)',[8,11,12,13,19,21,25,29,33,35,40])]:\r\n\u001b[?2004l\r\u001b[?2004h>     ws=wb[sheet]\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n===', sheet, '===')\r\n\u001b[?2004l\r\u001b[?2004h>     for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>         print('ROW', r)\r\n\u001b[?2004l\r\u001b[?2004h>         for c in range(1, ws.max_column+1):\r\n\u001b[?2004l\r\u001b[?2004h>             v=ws.cell(row=r,column=c).value\r\n\u001b[?2004l\r\u001b[?2004h>             if v is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 print(f'  {ws.cell(row=r,column=c).coordinate}: {v!r}')\r\n\u001b[?2004l\r\u001b"]

[55.445769, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\n\ndef formula_map(ws):\n    d={}\n    for row in ws.iter_rows():\n        for c in row:\n            if isinstance(c.value,str) and c.value.startswith('='):\n                d[c.coordinate]=c.value\n    return d\npairs = [('8. Income Statement','12. Income Statement (2)'),('8. Income Statement','15. Income Statement (3)'),('9. Cash Flow Statement','13. Cash Flow Statement (2)'),('9. Cash Flow Statement','16. Cash Flow Statement (3)'),('10. Balance Sheet','14. Balance Sheet (2)'),('10. Balance Sheet','17. Balance Sheet (3)'),('4. Projected Sales Forecast','5. Projected Sales Forecast (2)')]\nfor a,b in pairs:\n    A=formula_map(wb[a]); B=formula_map(wb[b])\n    onlyA=[c for c in A if c not in B]\n    onlyB=[c for c in B if c not in A]\n    diff=[c for c in A if c in B and A[c]!=B[c]][:100]\n    print(f'\\n{a} vs {b}: formula_count {len(A)} vs {len(B)}, onlyA={onlyA[:40]}, onlyB={onlyB[:40]}, diffs={diff[:40]}')\nPY\n"]

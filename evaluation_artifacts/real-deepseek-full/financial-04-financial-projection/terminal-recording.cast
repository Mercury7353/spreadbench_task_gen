[93.692949, "i", "python3 - <<'PY'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nfor sheet in ['1. Required Start-Up Funds','3. Fixed Operating Expenses','4. Projected Sales Forecast','5. Projected Sales Forecast (2)','11. Year End Summary']:\n    ws=wb[sheet]\n    print('\\n===', sheet, '===')\n    for row in range(1, ws.max_row+1):\n        cells=[]\n        for col in range(1, ws.max_column+1):\n            c=ws.cell(row=row,column=col)\n            if c.value is not None:\n                cells.append(f'{c.coordinate}={c.value!r}')\n        if cells:\n            print('\\nROW', row, ':', ' | '.join(cells))\nPY\n"]
[93.693337, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> "]

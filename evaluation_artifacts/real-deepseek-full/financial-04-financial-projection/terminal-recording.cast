[9.334966, "o", "A1 \"='1. Required Start-Up Funds'!A1\"\r\n"]
[9.335177, "o", "G13 \"=IF('1. Required Start-Up Funds'!G42=0,0,'1. Required Start-Up Funds'!G37/'1. Required Start-Up Funds'!G42)\"\r\nI13 '=IF(G13>0.2,\"Owner\\'s injection is reasonable\",\"Owner\\'s injection might be too low in relation to the amount of money needed\")'\r\nG14 \"=IF('1. Required Start-Up Funds'!G31=0,0,'1. Required Start-Up Funds'!E28/'1. Required Start-Up Funds'!G31)\"\r\nI14 '=IF(G14<0.2,\"Cash request seems reasonable with respect to total request\",\"Cash request exceeds 20% which might be high\")'\r\nG17 \"='1. Required Start-Up Funds'!H40\"\r\nI17 '=IF(G17<0.06,\"Interest rate may be too low for the type of loan requested\",\"Interest rate seems reasonable\")'\r\nG18 \"='1. Required Start-Up Funds'!I40\"\r\nI18 '=IF(G18>120,\"Loan term may be too high for this type of loan\",\"Loan term seems within range for this type of loan\")'\r\nG20 \"='1. Required Start-Up Funds'!H41\"\r\nI20 '=IF(G20<0.06,\"Interest rate may be too low for type of loan requested\",\"Interest rate seems reasonable\")'\r\n"]
[9.335201, "o", "G21 \"='1. Required Start-Up Funds'!I41\"\r\nI21 '=IF(G21>240,\"Loan term may be too high for this type of loan\",\"Loan term seems within range for this type of loan\")'\r\n"]
[9.335222, "o", "G23 \"=IF('8. Income Statement'!Q13=0,0,'1. Required Start-Up Funds'!J42/'8. Income Statement'!Q13)\"\r\nI23 '=IF(G23>10,\"Calculated loan payments as a percent of sales may be too high\",\"Calculated loan payments as a percent of sales seem resonable\")'\r\nG26 \"='11. Year End Summary'!G22\"\r\n"]
[9.335229, "o", "I26 '=IF(G26<0.2,\"Gross margin percentage seems very low\",\"Gross margin percentage seems reasonable\")'\r\n"]
[9.33525, "o", "G27 \"='2. Salaries and Wages'!M11\"\r\nI27 '=IF(G27>0,\"An owner\\'s compensation amount has been established\",\"An owner\\'s compensation amount has not been established\")'\r\nG28 \"=IF('8. Income Statement'!Q66=0,0,G27/'8. Income Statement'!Q66)\"\r\nI28 '=IF(G28>1,\"Owner\\'s compensation may be too high relative to profitability of business\",\"Owner\\'s compensation seems reasonable\")'\r\n"]
[9.335256, "o", "G29 \"=IF('8. Income Statement'!Q13=0,0,'8. Income Statement'!Q34/'8. Income Statement'!Q13)\"\r\nI29 '=IF(G29<0.2,\"Advertising as a percent of sales may be too low\",\"Advertising as a percent of sales seems reasonable\")'\r\n"]
[9.335264, "o", "G30 \"='8. Income Statement'!Q66\"\r\nI30 '=IF(G30<0,\"The business is not showing a profit\",\"The business is showing a profit\")'\r\n"]
[9.335299, "o", "G31 \"='11. Year End Summary'!G66\"\r\nI31 '=IF(G31>0.2,\"The projection may be too aggressive in stating profitability\",\"The projection does not seem highly unreasonable\")'\r\n"]
[9.335353, "o", "G34 \"='9. Cash Flow Statement'!Q35\"\r\nI34 '=IF(G34>0,\"The financial projection does not provide the desired level of cash flow\",\"The financial projection provides the desired level of cash flow\")'\r\nG35 '=G34'\r\nI35 '=IF(G35>0,\"The business will need at least this level of a line of credit\",\"The business doesn\\'t seem to require a line of credit\")'\r\nG36 \"=IF('8. Income Statement'!Q13=0,0,'10. Balance Sheet'!I11/'8. Income Statement'!Q13)\"\r\nI36 '=IF(G36>0.3,\"Accounts receivable amounts seem high\",\"Accounts receivable amount as a percent of sales seems reasonable\")'\r\nG39 \"='10. Balance Sheet'!F29-'10. Balance Sheet'!F47\"\r\n"]
[9.33536, "o", "I39 '=IF(G39<>0,\"The balance sheet is not in balance\",\"The balance sheet does balance\")'\r\n"]
[9.335379, "o", "G40 \"='10. Balance Sheet'!I29-'10. Balance Sheet'!I47\"\r\nI40 '=IF(G40<>0,\"The balance sheet is not in balance\",\"The balance sheet does balance\")'\r\nG41 \"=IF('10. Balance Sheet'!I45=0,0,'10. Balance Sheet'!I39/'10. Balance Sheet'!I45)\"\r\nI41 '=IF(G41>5,\"Most banks would consider there to be too much debt for the overall amount of equity or ownership\",\"The debt to equity ratio seems reasonable\")'\r\n"]

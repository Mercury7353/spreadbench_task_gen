[121.449168, "o", "\r\n== 1. Required Start-Up Funds ==\r\nR01 label='=Introduction!B19' pres=['M'] miss=['G', 'H', 'I', 'J', 'K', 'L', 'N', 'O', 'P', 'Q', 'R'] ex=['M1:=NOW()']\r\nR15 label='Total Fixed Assets' pres=['G'] miss=['H', 'I', 'J', 'K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R'] ex=['G15:=SUM(E8:E14)']\r\nR29 label='Total Operating Capital' pres=['G'] miss=['H', 'I', 'J', 'K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R'] ex=['G29:=SUM(E18:E28)']\r\nR31 label='Total Required Funds' pres=['G'] miss=['H', 'I', 'J', 'K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R'] ex=['G31:=G15+G29']\r\nR40 label='Commercial Loan' pres=['G', 'H', 'I', 'J'] miss=['K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R'] ex=['G40:=(G31-E8-E9)-((G37+G38)-(E8+E9-G41))', 'I40:=7*12']\r\nR41 label='Commercial Mortgage' pres=['G', 'H', 'I', 'J'] miss=['K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R'] ex=['G41:=IF((G31-G37+G38)<(E8+E9)*0.8,G31-G37+G38,(E8+E9)*0.8)', 'I41:=20*12']\r\nR42 label='Total Sources of Funding' pres=['G', 'J'] miss=['H', 'I', 'K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R'] ex=['G42:=SUM(G37:G41)',"]

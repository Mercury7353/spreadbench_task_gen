[93.860038, "o", "\r\nROW 2 : A2='Fixed Operating Expenses'\r\n"]
[93.860194, "o", "\r\nROW 6 : A6='Fixed Operating Expenses' | G6='Monthly' | I6='Year One' | J6='Year Two' | K6='Year Three' | M6='Notes'\r\n"]
[93.860244, "o", "\r\nROW 8 : A8='Percent Change' | J8=0.03 | K8=0.03\r\n"]
[93.860337, "o", "\r\nROW 10 : A10='Expenses'\r\n"]
[93.860385, "o", "\r\nROW 11 : B11='Advertising' | G11=0 | I11='=G11*12' | J11='=I11*(1+$J$8)' | K11='=J11*(1+$K$8)'\r\n"]
[93.860428, "o", "\r\nROW 12 : B12='Car and Truck Expenses' | G12=0 | I12='=G12*12' | J12='=I12*(1+$J$8)' | K12='=J12*(1+$K$8)'\r\n\r\nROW 13 : B13='Commissions and Fees' | G13=0 | I13='=G13*12' | J13='=I13*(1+$J$8)' | K13='=J13*(1+$K$8)'\r\n"]
[93.860501, "o", "\r\nROW 14 : B14='Contract Labor' | G14=0 | I14='=G14*12' | J14='=I14*(1+$J$8)' | K14='=J14*(1+$K$8)'\r\n\r\nROW 15 : B15='Credit Card and Bank Charges' | G15=0 | I15='=G15*12' | J15='=I15*(1+$J$8)' | K15='=J15*(1+$K$8)'\r\n"]
[93.860553, "o", "\r\nROW 16 : B16='Customer Discounts and Refunds' | G16=0 | I16='=G16*12' | J16='=I16*(1+$J$8)' | K16='=J16*(1+$K$8)'\r\n\r\nROW 17 : B17='Dues and Subscriptions' | G17=0 | I17='=G17*12' | J17='=I17*(1+$J$8)' | K17='=J17*(1+$K$8)'\r\n"]
[93.860646, "o", "\r\nROW 18 : B18='Entertainment' | G18=0 | I18='=G18*12' | J18='=I18*(1+$J$8)' | K18='=J18*(1+$K$8)'\r\n"]
[93.860696, "o", "\r\nROW 19 : B19='Insurance (Liability and Property)' | G19=0 | I19='=G19*12' | J19='=I19*(1+$J$8)' | K19='=J19*(1+$K$8)'\r\n"]
[93.860797, "o", "\r\nROW 20 : B20='Internet' | G20=0 | I20='=G20*12' | J20='=I20*(1+$J$8)' | K20='=J20*(1+$K$8)'\r\n\r\nROW 21 : B21='Legal and Professional Fees' | G21=0 | I21='=G21*12' | J21='=I21*(1+$J$8)' | K21='=J21*(1+$K$8)'\r\n"]
[93.860868, "o", "\r\nROW 22 : B22='Office Expenses' | G22=0 | I22='=G22*12' | J22='=I22*(1+$J$8)' | K22='=J22*(1+$K$8)'\r\n"]
[93.860934, "o", "\r\nROW 23 : B23='Postage and Delivery' | G23=0 | I23='=G23*12' | J23='=I23*(1+$J$8)' | K23='=J23*(1+$K$8)'\r\n\r\nROW 24 : B24='Rent (on business property)' | G24=0 | I24='=G24*12' | J24='=I24*(1+$J$8)' | K24='=J24*(1+$K$8)'\r\n"]
[93.861019, "o", "\r\nROW 25 : B25='Rent of Vehicles and Equipment' | G25=0 | I25='=G25*12' | J25='=I25*(1+$J$8)' | K25='=J25*(1+$K$8)'\r\n\r\nROW 26 : B26='Repairs and Maintenance' | G26=0 | I26='=G26*12' | J26='=I26*(1+$J$8)' | K26='=J26*(1+$K$8)'\r\n"]
[93.861074, "o", "\r\nROW 27 : B27='Supplies' | G27=0 | I27='=G27*12' | J27='=I27*(1+$J$8)' | K27='=J27*(1+$K$8)'\r\n"]
[93.861087, "o", "\r\nROW 28 : B28='Telephone and Communications' | G28=0 | I28='=G28*12' | J28='=I28*(1+$J$8)' | K28='=J28*(1+$K$8)'\r\n"]
[93.861149, "o", "\r\nROW 29 : B29='Travel' | G29=0 | I29='=G29*12' | J29='=I29*(1+$J$8)' | K29='=J29*(1+$K$8)'\r\n"]
[93.861217, "o", "\r\nROW 30 : B30='Utilities' | G30=0 | I30='=G30*12' | J30='=I30*(1+$J$8)' | K30='=J30*(1+$K$8)'\r\n\r\nROW 31 : A31='Total Expenses' | G31='=SUM(G11:G30)' | I31='=SUM(I11:I30)' | J31='=SUM(J11:J30)' | K31='=SUM(K11:K30)'\r\n"]
[93.861253, "o", "\r\nROW 33 : A33='Other Expenses'\r\n"]
[93.861294, "o", "\r\nROW 34 : B34='Depreciation' | G34=\"=('1. Required Start-Up Funds'!E9/'1. Required Start-Up Funds'!H9)/12+('1. Required Start-Up Funds'!E10/'1. Required Start-Up Funds'!H10)/12+('1. Required Start-Up Funds'!E11/'1. Required Start-Up Funds'!H11)/12+('1. Required Start-Up Funds'!E12/'1. Required Start-Up Funds'!H12)/12+('1. Required Start-Up Funds'!E13/'1. Required Start-Up Funds'!H13)/12+('1. Required Start-Up Funds'!E14/'1. Required Start-Up Funds'!H14)/12\" | I34='=G34*12' | J34='=I34' | K34='=J34'\r\n"]
[93.861335, "o", "\r\nROW 35 : B35='Interest'\r\n"]
[93.861409, "o", "\r\nROW 36 : C36='Commercial Loan' | G36=\"='20. Amoritization Schedule'!S15/12\" | I36=\"='20. Amoritization Schedule'!S15\" | J36=\"='20. Amoritization Schedule'!S19\" | K36=\"='20. Amoritization Schedule'!S23\"\r\n"]
[93.861464, "o", "\r\nROW 37 : C37='Commercial Mortgage' | G37=\"='20. Amoritization Schedule'!S35/12\" | I37=\"='20. Amoritization Schedule'!S35\" | J37=\"='20. Amoritization Schedule'!S39\" | K37=\"='20. Amoritization Schedule'!S43\"\r\n"]
[93.861519, "o", "\r\nROW 38 : C38='Line of Credit' | G38=\"='8. Income Statement'!Q62/12\" | I38=\"='8. Income Statement'!Q62\" | J38=0 | K38=0\r\n"]
[93.861565, "o", "\r\nROW 39 : A39='Total Other Expenses' | G39='=SUM(G34:G38)' | I39='=SUM(I34:I38)' | J39='=SUM(J34:J38)' | K39='=SUM(K34:K38)'\r\n"]
[93.861634, "o", "\r\nROW 41 : A41='Total Fixed Operating Expenses' | G41='=G31+G39' | I41='=I31+I39' | J41='=J31+J39' | K41='=K31+K39'\r\n"]
[93.861982, "o", "\r\n=== 4. Projected Sales Forecast ===\r\n"]
[93.862094, "o", "\r\nROW 1 : A1=\"='1. Required Start-Up Funds'!A1\" | T1='=NOW()'\r\n"]
[93.862146, "o", "\r\nROW 2 : A2='Projected Sales Forecast'\r\n"]
[93.862315, "o", "\r\nROW 6 : A6='Products and Services' | E6='Assumptions' | F6='          %' | H6='Month 1' | I6='Month 2' | J6='Month 3' | K6='Month 4' | L6='Month 5' | M6='Month 6' | N6='Month 7' | O6='Month 8' | P6='Month 9' | Q6='Month 10' | R6='Month 11' | S6='Month 12' | T6='Totals'\r\n"]
[93.8624, "o", "\r\nROW 8 : A8='Product/Service A'\r\n"]
[93.862453, "o", "\r\nROW 9 : B9='Price Per Unit' | E9=0 | F9=1\r\n"]
[93.862467, "o", "\r\nROW 10 : B10='Variable Cost Per Unit' | E10=0 | F10='=IF(E9>0,E10/E9,0)'\r\n"]
[93.86252, "o", "\r\nROW 11 : B11='Gross Margin Per Unit' | E11='=E9-E10' | F11='=IF(E9>0,E11/E9,0)'\r\n"]

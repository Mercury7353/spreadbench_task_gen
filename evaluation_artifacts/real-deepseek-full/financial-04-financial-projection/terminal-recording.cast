[25.936568, "o", "\r\n=== SHEET: Introduction === dims=B1:C32 max=32x3\r\nB1='Financial Projection Model'\r\nB3='This spreadsheet walks you through the process of developing an integrated set of financial projections.'\r\nB5='To use this model, simply complete any information asked for found in the color yellow.'\r\nB6='Example:  Fill in boxes that look like this' | C6=0\r\nB8='A number found in the color green is optional information that you can complete.'\r\nB9='Example:  Check these assumptions' | C9=0\r\nB11='Otherwise, any information found in black type is automatically calculated for you.'\r\nB12='Although the cells that are calculated are locked (or protected), you can turn off this protection to modify the sheets.'\r\nB13='To do this, select \"Tools\" from the menu bar at the top of the screen.  Then select, \"Protection.\"'\r\nB14='Finally, select \"Unprotect Sheet\" and you will be able to edit any labels or formulas.'\r\nB16='Before you begin, we need some information about your business to best customize your financial statements.'\r\nB17='Plea"]
[25.93667, "o", "se enter the name of your business in the box below:'\r\nB19='Enter Your Business Name Here'\r\nB22='The first six worksheets in this workbook are steps you will need to complete.  They are titled:'\r\nB23='1.  Required Start-Up Funds'\r\nB24='2.  Salaries and Wages'\r\nB25='3.  Fixed Operating Expenses'\r\nB26='4.  Projected Sales Forecast (2 sheets)'\r\nB27='5.  Cash Receipts and Disbursements'\r\nB28='The sixth step titled, \"Beginning Balance Sheet\" is for existing businesses only.'\r\nB31='Begin by clicking on the tabs below'\r\nB32='q'\r\n\r\n=== SHEET: 1. Required Start-Up Funds === dims=A1:O50 max=50x15\r\nA1='=Introduction!B19' | M1='=NOW()'\r\nA2='Required Start-Up Funds'\r\nA6='Required Start-Up Funds' | E6='Amount' | G6='Totals' | H6='Depreciation' | J6='Notes'\r\nB7='Fixed Assets'\r\nC8='Real Estate' | E8=0\r\nC9='Buildings' | E9=0 | H9=20 | I9=' years'\r\nC10='Leasehold Improvements' | E10=0 | H10=7 | I10=' years'\r\nC11='Equipment' | E11=0 | H11=7 | I11=' years'\r\nC12='Furniture and Fixtures' | E12=0 | H12=5 | I12=' years'\r\nC13='Vehicl"]
[25.936734, "o", "es' | E13=0 | H13=5 | I13=' years'\r\nC14='Other Fixed Assets' | E14=0 | H14=5 | I14=' years'\r\nB15='Total Fixed Assets' | G15='=SUM(E8:E14)'\r\nB17='Operating Capital'\r\nC18='Pre-Opening Salaries and Wages' | E18=0\r\nC19='Prepaid Insurance Premiums' | E19=0\r\nC20='Beginning Inventory' | E20=0\r\nC21='Legal and Accounting Fees' | E21=0\r\nC22='Rent Deposits' | E22=0\r\nC23='Utility Deposits' | E23=0\r\nC24='Supplies' | E24=0\r\nC25='Advertising and Promotions' | E25=0\r\nC26='Licenses' | E26=0\r\nC27='Other Initial Start-Up Costs' | E27=0\r\nC28='Working Capital (Cash On Hand)' | E28=0\r\nB29='Total Operating Capital' | G29='=SUM(E18:E28)'\r\nA31='Total Required Funds' | G31='=G15+G29'\r\nA36='Sources of Funding' | E36='Amount' | G36='Totals' | H36='Loan Rate' | I36='Term in Months' | J36='Monthly Payments'\r\nB37=\"Owner's Cash Injection\" | E37='=IF(G37=0,0,G37/G42)' | G37=0\r\nB38='Outside Investors' | E38='=IF(G38=0,0,G38/G42)' | G38=0\r\nB39='Additional Loans or Debt'\r\nC40='Commercial Loan' | E40='=IF(G40=0,0,G40/G42)' | G40='=(G31-E8-E9)-(("]
[25.936872, "o", "G37+G38)-(E8+E9-G41))' | H40=0.09 | I40='=7*12' | J40='=ABS(PMT(H40/12,I40,G40))'\r\nC41='Commercial Mortgage' | E41='=IF(G41=0,0,G41/G42)' | G41='=IF((G31-G37+G38)<(E8+E9)*0.8,G31-G37+G38,(E8+E9)*0.8)' | H41=0.09 | I41='=20*12' | J41='=ABS(PMT(H41/12,I41,G41))'\r\nA42='Total Sources of Funding' | E42='=SUM(E37:E41)' | G42='=SUM(G37:G41)' | J42='=J40+J41'\r\nA44='=IF(\\'9. Cash Flow Statement\\'!Q35>0,\"A line of credit is also required in the amount of\",\"\")' | G44='=IF(\\'9. Cash Flow Statement\\'!Q35>0,\\'9. Cash Flow Statement\\'!Q35,\"\")'\r\n\r\n=== SHEET: 2. Salaries and Wages === dims=A1:R50 max=50x18\r\nA1=\"='1. Required Start-Up Funds'!A1\" | R1='=NOW()'\r\nA2='Salaries and Wages'\r\nA6='Salaries and Related Expenses' | F6='#' | G6='Assumptions' | I6='Wage Base' | K6='Monthly' | M6='Year One' | N6='Year Two' | O6='Year Three'\r\nA8='Percent Change' | N8=0.03 | O8=0.03\r\nA10='Salaries and Wages'\r\nB11=\"Owner's Compensation\" | F11=0 | K11=0 | M11='=K11*12' | N11='=M11*(1+$N$8)' | O11='=N11*(1+$O$8)'\r\nB12='Salaries' | F12=0 | K12=0 "]
[25.937065, "o", "| M12='=K12*12' | N12='=M12*(1+$N$8)' | O12='=N12*(1+$O$8)'\r\nB13='Wages'\r\nC14='Full-Time Employees' | F14=0 | K14='=M14/12' | M14='=G15*G16*52*F14' | N14='=M14*(1+$N$8)' | O14='=N14*(1+$O$8)'\r\nD15='Estimated Hours Per Week' | G15=40\r\nD16='Estimated Rate Per Hour' | G16=9\r\nC17='Part-Time Employees' | F17=0 | K17='=M17/12' | M17='=G18*G19*52*F17' | N17='=M17*(1+$N$8)' | O17='=N17*(1+$O$8)'\r\nD18='Estimated Hours Per Week' | G18=20\r\nD19='Estimated Rate Per Hour' | G19=9\r\nB20='Independent Contractors' | K20=0 | M20='=K20*12' | N20='=M20*(1+$N$8)' | O20='=N20*(1+$O$8)'\r\nA21='Total Salaries and Wages' | F21='=SUM(F11:F20)' | K21='=SUM(K11:K20)' | M21='=SUM(M11:M20)' | N21='=SUM(N11:N20)' | O21='=SUM(O11:O20)'\r\nA23='Payroll Taxes and Benefits'\r\nB24='Social Security' | G24=0.062 | I24=102000 | K24='=K21*$G$24' | M24='=M21*$G$24' | N24='=N21*$G$24' | O24='=O21*$G$24'\r\n\u001b[?2004hroot@ec36e9e3f29d:/workspace# "]
[26.017319, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nfor ws in wb.worksheets:\n    print('\\n##', ws.title)\n    # Dump by rows in chunks to terminal? just list blank cells in max dimension with empty but style\n    for row in range(1, ws.max_row+1):\n        nonempty=[]\n        blank=[]\n        for col in range(1, ws.max_column+1):\n            c=ws.cell(row=row, column=col)\n            if c.value is not None:\n                nonempty.append(c.coordinate)\n            elif c.has_style:\n                # don't print style blank\n                pass\n        if nonempty:\n            print(row, 'nonempty', len(nonempty), 'firstlast', nonempty[0], nonempty[-1], 'cols', nonempty[:5], '...' if len(nonempty)>5 else '')\nPY\n"]

[149.594436, "i", "cat > /tmp/holes.py <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nfor ws in wb.worksheets:\n    print('\\n====', ws.title, '====')\n    title=ws.title\n    if title in ('8. Income Statement','9. Cash Flow Statement','11. Year End Summary','12. Income Statement (2)','13. Cash Flow Statement (2)','15. Income Statement (3)','16. Cash Flow Statement (3)'):\n        start_col, end_col = 5, 17\n    elif title in ('10. Balance Sheet','14. Balance Sheet (2)','17. Balance Sheet (3)','7. Beginning Balance Sheet'):\n        start_col, end_col = 6, 10\n    elif title in ('18. Financial Ratios','19. Breakeven Analysis','20. Amoritization Schedule'):\n        start_col, end_col = 7, 19\n    else:\n        continue\n    for row in range(1, ws.max_row+1):\n        cells=[]\n        missing=[]\n        for col in range(start_col, end_col+1):\n            c=ws.cell(row=row, column=col)\n            if c.value is not None:\n                cells.append(c.coordinate)\n            else:\n                missing.append"]
[149.595506, "o", "cat > /tmp/holes.py <<'PY'\r\n\u001b[?2004l\r"]
[149.596639, "i", "(c.coordinate)\n        if not cells or not missing or len(cells) < 4:\n            continue\n        labels=[]\n        for c in range(1,5):\n            v=ws.cell(row=row, column=c).value\n            if v is not None:\n                labels.append(str(v))\n        label=' | '.join(labels)[:100]\n        print('R{:02d} cells={} missing={} label={!r}'.format(row, ','.join(cells), ','.join(missing), label))\nPY\npython3 /tmp/holes.py > /workspace/hole_report.txt\nhead -n 220 /workspace/hole_report.txt\n"]

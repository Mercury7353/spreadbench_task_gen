[163.07606, "i", "python3 - <<'PY' > /workspace/inspect_rows.txt\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\ndef dump(sheet, rows):\n    ws=wb[sheet]\n    print('\\n===', sheet, '===')\n    for r in rows:\n        print('ROW', r)\n        for col in range(1, ws.max_column+1):\n            v=ws.cell(row=r,column=col).value\n            if v is not None:\n                print(' ', ws.cell(row=r,column=col).coordinate, '=' , repr(v))\ndump('8. Income Statement',[9,12,16,18,27,28,30,34,36,39,40,45,46,48,49,54,66,70,71])\ndump('9. Cash Flow Statement',[6,8,33,37,40])\ndump('20. Amoritization Schedule',[6,16,17,19,21,23,24,25,36,37,39,41,43,45])\nPY\nsed -n '1,260p' /workspace/inspect_rows.txt\n"]
[163.080143, "o", "python3 - <<'PY' > /workspace/inspect_rows.txt\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> p='/workspace/input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(p)\r\n\u001b[?2004l\r\u001b[?2004h> def dump(sheet, rows):\r\n\u001b[?2004l\r\u001b[?2004h>     ws=wb[sheet]\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n===', sheet, '===')\r\n\u001b[?2004l\r\u001b[?2004h>     for r in rows:\r\n\u001b[?2004l\r\u001b[?2004h>         print('ROW', r)\r\n\u001b[?2004l\r\u001b[?2004h>         for col in range(1, ws.max_column+1):\r\n\u001b[?2004l\r\u001b[?2004h>             v=ws.cell(row=r,column=col).value\r\n\u001b[?2004l\r\u001b[?2004h>             if v is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 print(' ', ws.cell(row=r,column=col).coordinate, '=' , repr(v))\r\n\u001b[?2004l\r\u001b[?2004h> dump('8. Income Statement',[9,12,16,18,27,28,30,34,36,39,40,45,46,48,49,54,66,70,71])\r\n\u001b[?2004l\r\u001b[?2004h> dump('9. Cash Flow Statement',[6,8,33,37,40])\r\n\u001b[?2004l\r\u001b[?2004h> dump('20. Amoritization Schedule',[6,16,17,19,21,23,24,25,36,37,39,41,43,45])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

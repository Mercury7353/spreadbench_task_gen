[121.449986, "o", "\r\n== 2. Salaries and Wages ==\r\nR01 label=\"='1. Required Start-Up Funds'!A1\" pres=['R'] miss=['G', 'H', 'I', 'J', 'K', 'L', 'M', 'N', 'O', 'P', 'Q'] ex=['R1:=NOW()']\r\nR11 label=\"Owner's Compensation\" pres=['K', 'M', 'N', 'O'] miss=['G', 'H', 'I', 'J', 'L', 'P', 'Q', 'R'] ex=['M11:=K11*12', 'N11:=M11*(1+$N$8)']\r\nR12 label='Salaries' pres=['K', 'M', 'N', 'O'] miss=['G', 'H', 'I', 'J', 'L', 'P', 'Q', 'R'] ex=['M12:=K12*12', 'N12:=M12*(1+$N$8)']\r\nR14 label='Full-Time Employees' pres=['K', 'M', 'N', 'O'] miss=['G', 'H', 'I', 'J', 'L', 'P', 'Q', 'R'] ex=['K14:=M14/12', 'M14:=G15*G16*52*F14']\r\nR17 label='Part-Time Employees' pres=['K', 'M', 'N', 'O'] miss=['G', 'H', 'I', 'J', 'L', 'P', 'Q', 'R'] ex=['K17:=M17/12', 'M17:=G18*G19*52*F17']\r\nR20 label='Independent Contractors' pres=['K', 'M', 'N', 'O'] miss=['G', 'H', 'I', 'J', 'L', 'P', 'Q', 'R'] ex=['M20:=K20*12', 'N20:=M20*(1+$N$8)']\r\nR21 label='Total Salaries and Wages' pres=['K', 'M', 'N', 'O'] miss=['G', 'H', 'I', 'J', 'L', 'P', 'Q', 'R'] ex=['K21:=SUM(K11:K20)', '"]

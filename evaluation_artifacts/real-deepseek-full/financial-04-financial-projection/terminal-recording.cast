[106.505545, "i", ".number_format\n                if f and (str(f)=='General' or str(f).startswith('_')):\n                    blanks.append(f'{c.coordinate}({fmtname(f)})')\n        if blanks:\n            print(f'R{row:02d} label={label[:80]!r} blanks={blanks[:40]}')\nPY\nhead -n 200 /workspace/formula_candidates.txt\n"]
[106.506454, "o", "\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl.utils import get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h> p='/workspace/input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(p)\r\n\u001b[?2004l\r\u001b[?2004h> dollar=openpyxl.styles.numbers.FORMAT_CURRENCY_USD_SIMPLE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def fmtname(f):\r\n\u001b[?2004l\r\u001b[?2004h>     if not f: return ''\r\n\u001b[?2004l\r\u001b[?2004h>     f=str(f)\r\n\u001b[?2004l\r\u001b[?2004h>     if f.startswith('_'): return 'num'\r\n\u001b[?2004l\r\u001b[?2004h>     if f in ('0%','0.0%'): return 'pct'\r\n\u001b[?2004l\r\u001b[?2004h>     if f=='General': return 'gen'\r\n\u001b[?2004l\r\u001b[?2004h>     return f[:20]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.506651, "o", "for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.506805, "o", "    print('\\n==',ws.title,'==')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.506875, "o", "    for row in range(1, ws.max_row+1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[106.507149, "o", "        label=''\r\n\u001b[?2004l\r\u001b[?2004h>         for col in range(1,4):\r\n\u001b[?2004l\r\u001b[?2004h>             v=ws.cell(row=row,column=col).value\r\n\u001b[?2004l\r"]
[106.508258, "o", "\u001b[?2004h>             if isinstance(v,str) and len(v)>1:\r\n\u001b[?2004l\r\u001b[?2004h>                 label=v\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>         if not label:\r\n\u001b[?2004l\r\u001b[?2004h>             label=' '.join(str(ws.cell(row=row,column=c).value) for c in range(1,4) if ws.cell(row=row,column=c).value is not None)\r\n\u001b[?2004l\r\u001b[?2004h>         blanks=[]\r\n\u001b[?2004l\r\u001b[?2004h>         for col in range(7, ws.max_column+1):\r\n\u001b[?2004l\r\u001b[?2004h>             c=ws.cell(row=row,column=col)\r\n\u001b[?2004l\r\u001b[?2004h>             if c.value is None and c.has_style:\r\n\u001b[?2004l\r\u001b[?2004h>                 f=c.number_format\r\n\u001b[?2004l\r\u001b[?2004h>                 if f and (str(f)=='General' or str(f).startswith('_')):\r\n\u001b[?2004l\r\u001b[?2004h>                     blanks.append(f'{c.coordinate}({fmtname(f)})')\r\n\u001b[?2004l\r\u001b[?2004h>         if blanks:\r\n\u001b[?2004l\r\u001b[?2004h>             print(f'R{row:02d} label={label[:80]!r} blanks={blanks[:40]}')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

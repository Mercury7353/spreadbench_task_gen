[70.674232, "i", "python3 - <<'PY'\nimport openpyxl, time\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p, data_only=False)\nprint('loaded')\nwbf=openpyxl.load_workbook(p, data_only=True)\nprint('loaded values')\nfor wsf,w in zip(wbf.worksheets, wb.worksheets):\n    none_f=0; both=0; noformula=[]\n    for row in range(1,wsf.max_row+1):\n        for col in range(1,wsf.max_column+1):\n            v=wsf.cell(row,col).value\n            f=w.cell(row,col).value\n            if f is None and v is not None:\n                noformula.append(w.cell(row,col).coordinate)\n            if isinstance(f,str) and f.startswith('='):\n                if v is None: none_f+=1\n                else: both+=1\n    print(w.title, 'formula cells no cached:', none_f, 'with cached:', both, 'nonempty no formula count:', len(noformula), 'first noformula', noformula[:20], flush=True)\nPY\n"]

[13.796465, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nprint('Sheets order:')\nfor i,ws in enumerate(wb.worksheets,1): print(i, ws.title, ws.max_row, ws.max_column, ws.calculate_dimension())\nprint()\nfor ws in wb.worksheets:\n    print('\\n=== SHEET:', ws.title, '===')\n    for row in ws.iter_rows():\n        vals=[]\n        for c in row:\n            if c.value is not None:\n                v=c.value\n                if isinstance(v,str) and len(v)>40:\n                    v=v[:40]+'...'\n                vals.append(f'{c.coordinate}={v!r}')\n        if vals:\n            print(' | '.join(vals))\nPY\n"]

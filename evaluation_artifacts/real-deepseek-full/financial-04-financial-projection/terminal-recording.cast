[410.052165, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(p)\nfor sheet, rows in [('18. Financial Ratios',list(range(1,28))),('19. Breakeven Analysis',list(range(1,19))),('21. Financial Diagnostics',[1,6,11])]:\n    ws=wb[sheet]\n    print('\\n===',sheet,'===')\n    for r in rows:\n        vals=[]\n        for col in range(1, ws.max_column+1):\n            v=ws.cell(row=r,column=col).value\n            if v is not None:\n                vals.append(f'{ws.cell(row=r,column=col).coordinate}={v!r}')\n        if vals:\n            print('R',r, ' | '.join(vals))\nPY\n"]
[410.052992, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl"]

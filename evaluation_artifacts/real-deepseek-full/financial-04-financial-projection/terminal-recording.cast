[77.552492, "i", "python3 - <<'PY'\nimport openpyxl, os\nfrom openpyxl.utils import get_column_letter\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p, data_only=False)\nlines=[]\nfor ws in wb.worksheets:\n    blank_with_style=[]\n    for row in ws.iter_rows():\n        for c in row:\n            if c.value is None and c.has_style:\n                s=c.style_id if hasattr(c,'style_id') else None\n                fill=c.fill\n                font=c.font\n                fmt=c.number_format\n                if (fill and fill.patternType) or (fmt != 'General') or (font and font.bold):\n                    blank_with_style.append((c.coordinate, fmt, fill.patternType if fill else None, fill.fgColor.rgb if fill and fill.fgColor else None, font.bold))\n    lines.append(f'{ws.title}: {len(blank_with_style)} styled blanks')\n    for item in blank_with_style[:80]:\n        lines.append('  '+', '.join(map(str,item)))\nopen('/workspace/styled_blanks.txt','w').write('\\n'.join(lines)+'\\n')\nprint('written')\nPY\nwc -l /workspace/styled_blanks.txt\nhead -n 1"]

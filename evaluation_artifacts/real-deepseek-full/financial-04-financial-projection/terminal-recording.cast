[233.741595, "i", "python3 - <<'PY' > /workspace/missing_bbox.txt\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nsheets=['8. Income Statement','9. Cash Flow Statement','12. Income Statement (2)','13. Cash Flow Statement (2)','15. Income Statement (3)','16. Cash Flow Statement (3)','20. Amoritization Schedule']\nfor ws in wb.worksheets:\n    if ws.title not in sheets: continue\n    for row in range(1, ws.max_row+1):\n        miss=[]\n        has_nonempty_formula=False\n        forms=[]\n        labels=[]\n        for col in range(1, ws.max_column+1):\n            c=ws.cell(row=row,column=col)\n            if c.value is None:\n                if col>=5 and c.has_style and c.number_format not in (None,'General','0'):\n                    miss.append(c.coordinate)\n            else:\n                if isinstance(c.value,str) and c.value.startswith('='):\n                    has_nonempty_formula=True\n                    forms.append(c.coordinate)\n                if col<=4:\n                    labels.append(str(c.value))\n  "]
[233.742174, "i", "      if miss and has_nonempty_formula:\n            print(ws.title, 'ROW', row, 'MISS', ','.join(miss), 'FORMS', ','.join(forms[:8]), 'LABEL', '|'.join(labels)[:90])\nPY\ncat /workspace/missing_bbox.txt\n"]

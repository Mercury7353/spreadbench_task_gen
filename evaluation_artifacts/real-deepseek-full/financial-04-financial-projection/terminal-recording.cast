[98.917353, "i", "python3 - <<'PY' > /workspace/sections1.txt\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nfor sheet in ['1. Required Start-Up Funds','3. Fixed Operating Expenses','4. Projected Sales Forecast','5. Projected Sales Forecast (2)']:\n    ws=wb[sheet]\n    print('\\n===', sheet, '===')\n    for row in range(1, ws.max_row+1):\n        cells=[]\n        for col in range(1, ws.max_column+1):\n            c=ws.cell(row=row,column=col)\n            if c.value is not None:\n                cells.append(f'{c.coordinate}={c.value!r}')\n        if cells:\n            print('ROW', row, ':', ' | '.join(cells))\nPY\nhead -n 220 /workspace/sections1.txt\n"]
[98.917536, "o", "python3 - <<'PY' > /workspace/sections1.txt\r\n\u001b[?2004l\r\u001b[?2004h> "]

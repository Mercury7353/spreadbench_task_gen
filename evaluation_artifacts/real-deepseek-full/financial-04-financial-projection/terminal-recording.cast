[37.013683, "i", "python3 - <<'PY'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p, data_only=False)\nout=[]\nfor ws in wb.worksheets:\n    out.append(f'\\n== {ws.title} ==')\n    for row in range(1, ws.max_row+1):\n        vals=[]\n        missing=[]\n        for col in range(7, 19):  # G-R\n            letter=get_column_letter(col)\n            c=ws.cell(row=row, column=col)\n            if c.value is not None:\n                vals.append(letter)\n            else:\n                missing.append(letter)\n        if vals and missing:\n            out.append(f'row {row}: existing_months={vals} missing_months={missing}')\nopen('/workspace/missing_candidates.txt','w').write('\\n'.join(out)+'\\n')\nprint('written')\nPY\nhead -n 120 /workspace/missing_candidates.txt\n"]

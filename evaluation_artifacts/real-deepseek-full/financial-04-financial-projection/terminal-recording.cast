[203.906022, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\n# Print compact summary of exact formulas per sheet and row for holes only\nfor ws in wb.worksheets:\n    if ws.title not in ('8. Income Statement','9. Cash Flow Statement','12. Income Statement (2)','13. Cash Flow Statement (2)','15. Income Statement (3)','16. Cash Flow Statement (3)','20. Amoritization Schedule'):\n        continue\n    print('\\n===', ws.title, '===')\n    for row in range(1, ws.max_row+1):\n        cells=[]\n        for col in range(1, ws.max_column+1):\n            v=ws.cell(row=row,column=col).value\n            if v is not None:\n                cells.append(ws.cell(row=row,column=col).coordinate + '=' + repr(v))\n        if cells:\n            # only rows that look relevant by mention of formulas/currencies? print all compact with only E-P, Q and A-D\n            line=' | '.join(cells)\n            print('R',row,line[:800])\nPY\n"]
[203.907353, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> p='/workspace/input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(p)\r\n\u001b[?2004l\r\u001b[?2004h> # Print compact summary of exact formulas per sheet and row for holes only\r\n\u001b[?2004l\r\u001b[?2004h> for ws in wb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h> "]

[319.132974, "i", "python3 - <<'PY'\nimport openpyxl\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\nws=wb['1. Required Start-Up Funds']\nfor r in [15,29,31]:\n    print('ROW',r)\n    for c in range(1,20):\n        v=ws.cell(row=r,column=c).value\n        if v is not None:\n            print(ws.cell(row=r,column=c).coordinate, repr(v))\nws=wb['3. Fixed Operating Expenses']\nfor r in [11,12,16,31,34,36,37,38,39,41]:\n    print('FIXROW',r)\n    for c in range(1,18):\n        v=ws.cell(row=r,column=c).value\n        if v is not None:\n            print(ws.cell(row=r,column=c).coordinate, repr(v))\nPY\n"]

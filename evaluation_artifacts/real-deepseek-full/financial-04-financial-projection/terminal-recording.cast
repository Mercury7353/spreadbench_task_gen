[121.260248, "i", "python3 - <<'PY'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\n# For each sheet print rows in G-R where some cells formulas and some blanks, with label and formulas in first existing\nfor ws in wb.worksheets:\n    out=[]\n    for row in range(1, ws.max_row+1):\n        label=''\n        for col in range(1,5):\n            v=ws.cell(row=row,column=col).value\n            if isinstance(v,str) and len(v)>1:\n                label=v\n                break\n        present=[]; missing=[]; formulas=[]\n        for col in range(7,19):\n            c=ws.cell(row=row,column=col)\n            letter=get_column_letter(col)\n            if c.value is not None:\n                present.append(letter)\n                if isinstance(c.value,str) and c.value.startswith('='):\n                    formulas.append(c.coordinate+':'+c.value)\n            else:\n                missing.append(letter)\n        if present and missing and formulas:\n            out.append(f'R{row:02d} "]

[434.517934, "i", "python3 - <<'PY' > /workspace/all_select_holes.txt\nimport openpyxl\np='/workspace/output.xlsx'\nwb=openpyxl.load_workbook(p)\nfor sheet in ['8. Income Statement','9. Cash Flow Statement','12. Income Statement (2)','13. Cash Flow Statement (2)','15. Income Statement (3)','16. Cash Flow Statement (3)','20. Amoritization Schedule']:\n    ws=wb[sheet]\n    print('\\n==',sheet,'==')\n    for row in range(1, ws.max_row+1):\n        forms=[]; missing=[]\n        cols = range(5,18) if ('Cash' in sheet) or ('Income' in sheet) else range(7,20)\n        for col in cols:\n            c=ws.cell(row=row,column=col)\n            letter=openpyxl.utils.get_column_letter(col)\n            if c.value is not None:\n                forms.append(letter)\n            else:\n                missing.append(letter)\n        if forms and missing and len(forms)>=6:\n            print('R',row,'MISS',','.join(missing),'FORMS',','.join(forms))\nPY\ncat /workspace/all_select_holes.txt\n"]
[434.518198, "o", "python3 - <<'PY' > /workspace/all_select_holes.txt\r\n"]

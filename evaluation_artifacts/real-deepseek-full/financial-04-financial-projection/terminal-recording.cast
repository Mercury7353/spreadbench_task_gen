[212.409781, "i", "python3 - <<'PY' > /workspace/allmissing.txt\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\np='/workspace/input.xlsx'\nwb=openpyxl.load_workbook(p)\n# all rows with holes in selected sheets, include exact label and existing nonempty formulas\nsheets=['8. Income Statement','9. Cash Flow Statement','12. Income Statement (2)','13. Cash Flow Statement (2)','15. Income Statement (3)','16. Cash Flow Statement (3)','20. Amoritization Schedule']\nfor ws in wb.worksheets:\n    if ws.title not in sheets: continue\n    for row in range(1, ws.max_row+1):\n        cells=[]\n        miss=[]\n        for col in range(1, ws.max_column+1):\n            c=ws.cell(row=row,column=col)\n            if c.value is not None:\n                cells.append(c.coordinate+'='+repr(c.value))\n            elif col>=5 and ws.cell(row=row,column=col).has_style and ws.cell(row=row,column=col).number_format not in (None,'General'):\n                miss.append(c.coordinate)\n        if not cells: continue\n        labels=[c for c in cells if '='"]
[212.410247, "o", "python3 - <<'PY' > /workspace/allmissing.txt\r\n\u001b[?2004l\r"]
[212.410346, "i", " not in c.split('=',1)[0]][:2]\n        print('\\n###', ws.title, 'ROW', row, 'styled_missing', miss)\n        print(' | '.join(cells))\nPY\ngrep -c '###' /workspace/allmissing.txt; head -n 200 /workspace/allmissing.txt\n"]

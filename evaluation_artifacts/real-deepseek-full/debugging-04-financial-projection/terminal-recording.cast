[170.673225, "i", "python3 - <<'PY' > /workspace/all_obvious.txt\nfrom openpyxl import load_workbook\nfor wbname in ['input.xlsx']:\n    wb=load_workbook(wbname, data_only=False)\n    for ws in wb.worksheets:\n        for row in ws.iter_rows():\n            for c in row:\n                v=c.value\n                if isinstance(v,str) and v.startswith('='):\n                    s=v.replace(' ','')\n                    # skip growth formulas with (1+$E$num)* etc\n                    if any(p in s for p in [f'(1+$E$',f'(1+E$',f'(1+$E$', '1+($E$']):\n                        continue\n                    if '=1+(F' in s or '=1+(' in s or '=-1*(' in s or '=+1*' in s:\n                        print(ws.title, c.coordinate, v)\n# Print known direct refs outputs for balance variants\nEOF"]

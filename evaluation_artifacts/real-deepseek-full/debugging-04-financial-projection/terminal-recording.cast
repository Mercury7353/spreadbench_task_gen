[34.317659, "i", "mkdir -p /workspace/dumps\npython3 - <<'PY'\nfrom openpyxl import load_workbook\nimport os\nwbf=load_workbook('input.xlsx', data_only=False)\nwbv=load_workbook('input.xlsx', data_only=True)\nfor ws, vs in zip(wbf.worksheets, wbv.worksheets):\n    safe=''.join(ch if ch not in '/\\:*?\"<>|' else '_' for ch in ws.title)\n    with open(f'/workspace/dumps/{safe}.txt','w') as f:\n        f.write('SHEET: '+ws.title+' dims '+ws.dimensions+' max '+str(ws.max_row)+','+str(ws.max_column)+' state '+str(ws.sheet_state)+'\\n')\n        for row in ws.iter_rows():\n            non=[]\n            for c in row:\n                v=c.value\n                if v is not None:\n                    ev=vs[c.coordinate].value\n                    if ev is not None:\n                        non.append(f'{c.coordinate}={v!r} @ {ev!r}')\n                    else:\n                        non.append(f'{c.coordinate}={v!r}')\n            if non:\n                f.write(str(row[0].row)+': '+' ; '.join(non)+'\\n')\nprint(os.listdir('/workspace/dumps'))\nPY\nls -la /w"]

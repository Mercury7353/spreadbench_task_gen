[262.459428, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False)\n# Print rows 21-35 of sheet 8 labels and Q formulas only\nws=wb['8. Income Statement']\nfor r in range(21,35):\n    vals=[]\n    for col in ['A','B','C','E','F','Q']:\n        v=ws[f'{col}{r}'].value\n        if v is not None: vals.append(f'{col}={v}')\n    print(r, vals)\nprint('\\nSheet2 payroll rows')\nws2=wb['2. Salaries and Wages']\nfor r in range(11,36):\n    vals=[]\n    for col in ['B','C','F','G','I','K','M']:\n        v=ws2[f'{col}{r}'].value\n        if v is not None: vals.append(f'{col}={v}')\n    if vals: print(r, vals)\nprint('\\nFunding rows')\nws1=wb['1. Required Start-Up Funds']\nfor r in range(36,45):\n  vals=[]\n  for col in ['A','B','C','E','G','H','I','J']:\n    v=ws1[f'{col}{r}'].value\n    if v is not None: vals.append(f'{col}={v}')\n  print(r, vals)\nPY\n"]

[175.883061, "o", "8. Income Statement J6 =-1*('4. Projected Sales Forecast'!M6)\r\n8. Income Statement M16 =1+('4. Projected Sales Forecast'!$E$10*'4. Projected Sales Forecast'!P14)\r\n8. Income Statement J17 =-1*('4. Projected Sales Forecast'!$E$32*'4. Projected Sales Forecast'!M36)\r\n8. Income Statement P18 =-1*(IF('5. Projected Sales Forecast (2)'!$E$10>0,'5. Projected Sales Forecast (2)'!$E$10*'5. Projected Sales Forecast (2)'!S14,\"\"))\r\n8. Income Statement E40 =1+('3. Fixed Operating Expenses'!G17)\r\n8. Income Statement G41 =1+(F41)\r\n12. Income Statement (2) O11 =-1*(IF('5. Projected Sales Forecast (2)'!$E$9>0,'5. Projected Sales Forecast (2)'!$E$9*'5. Projected Sales Forecast (2)'!R15,\"\"))\r\n12. Income Statement (2) P26 =-1*(O26)\r\n12. Income Statement (2) I35 =1+(H35)\r\n12. Income Statement (2) L48 =-1*(K48)\r\n12. Income Statement (2) O54 =1+(SUM(O34:O53))\r\n15. Income Statement (3) J22 =-1*(J13-J20)\r\n15. Income Statement (3) P44 =1+(O44)\r\n15. Income Statement (3) B49 =1+('3. Fixed Operating Expenses'!B26)\r\n15. Income Statement (3)"]

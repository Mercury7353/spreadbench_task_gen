[16.786443, "o", "\r\n==== SHEET: Introduction dims B1:C32 max 32,3 visible visible\r\n\r\n==== SHEET: 1. Required Start-Up Funds dims A1:O50 max 50,15 visible visible\r\nA1: =Introduction!B19\r\nM1: =NOW()\r\nG15: =SUM(E8:E14)\r\nG29: =SUM(E18:E28)\r\nG31: =G15+G29\r\nE37: =IF(G37=0,0,G37/G42)\r\nE38: =IF(G38=0,0,G38/G42)\r\nE40: =IF(G40=0,0,G40/G42)\r\nG40: =(G31-E8-E9)-((G37+G38)-(E8+E9-G41))\r\nI40: =7*12\r\nJ40: =ABS(PMT(H40/12,I40,G40))\r\nE41: =IF(G41=0,0,G41/G42)\r\nG41: =IF((G31-G37+G38)<(E8+E9)*0.8,G31-G37+G38,(E8+E9)*0.8)\r\nI41: =20*12\r\nJ41: =ABS(PMT(H41/12,I41,G41))\r\nE42: =SUM(E37:E41)\r\nG42: =SUM(G37:G41)\r\nJ42: =J40+J41\r\nA44: =IF('9. Cash Flow Statement'!Q35>0,\"A line of credit is also required in the amount of\",\"\")\r\nG44: =IF('9. Cash Flow Statement'!Q35>0,'9. Cash Flow Statement'!Q35,\"\")\r\n\r\n==== SHEET: 2. Salaries and Wages dims A1:R50 max 50,18 visible visible\r\nA1: ='1. Required Start-Up Funds'!A1\r\nR1: =NOW()\r\nM11: =K11*12\r\nN11: =M11*(1+$N$8)\r\nO11: =N11*(1+$O$8)\r\nM12: =K12*12\r\nN12: =M12*(1+$N$8)\r\n"]
[16.786468, "o", "O12: =N12*(1+$O$8)\r\nK14: =M14/12\r\nM14: =G15*G16*52*F14\r\nN14: =M14*(1+$N$8)\r\nO14: =N14*(1+$O$8)\r\nK17: =M17/12\r\nM17: =G18*G19*52*F17\r\nN17: =M17*(1+$N$8)\r\nO17: =N17*(1+$O$8)\r\nM20: =K20*12\r\nN20: =M20*(1+$N$8)\r\nO20: =N20*(1+$O$8)\r\nF21: =SUM(F11:F20)\r\nK21: =SUM(K11:K20)\r\nM21: =SUM(M11:M20)\r\nN21: =SUM(N11:N20)\r\nO21: =SUM(O11:O20)\r\nK24: =K21*$G$24\r\nM24: =M21*$G$24\r\nN24: =N21*$G$24\r\nO24: =O21*$G$24\r\nK25: =K21*$G$25\r\nM25: =M21*$G$25\r\nN25: =N21*$G$25\r\nO25: =O21*$G$25\r\nK26: =F21*I26*G26/12\r\nM26: =K26*12\r\nN26: =M26\r\nO26: =N26\r\n"]
[16.786474, "o", "K27: =F21*I27*G27/12\r\nM27: =K27*12\r\nN27: =M27\r\nO27: =N27\r\nK28: =G28*K21\r\nM28: =K28*12\r\n"]
[16.786478, "o", "N28: =M28\r\nO28: =N28\r\n"]
[16.786498, "o", "K29: =G29*$K$21\r\nM29: =K29*12\r\nN29: =M29*(1+N8)\r\nO29: =N29*(1+O8)\r\nK30: =G30*$K$21\r\nM30: =K30*12\r\nN30: =M30*(1+N8)\r\nO30: =N30*(1+O8)\r\nK31: =G31*$K$21\r\nM31: =K31*12\r\nN31: =M31*(1+N8)\r\nO31: =N31*(1+O8)\r\nK32: =SUM(K24:K31)\r\nM32: =SUM(M24:M31)\r\nN32: =SUM(N24:N31)\r\nO32: =SUM(O24:O31)\r\nK35: =K21+K32\r\nM35: =M21+M32\r\nN35: =N21+N32\r\nO35: =O21+O32\r\n\r\n==== SHEET: 3. Fixed Operating Expenses dims A1:Q50 max 50,17 visible visible\r\nA1: ='1. Required Start-Up Funds'!A1\r\nQ1: =NOW()\r\nI11: =G11*12\r\n"]
[16.786503, "o", "J11: =I11*(1+$J$8)\r\nK11: =J11*(1+$K$8)\r\nI12: =G12*12\r\nJ12: =I12*(1+$J$8)\r\nK12: =J12*(1+$K$8)\r\nI13: =G13*12\r\nJ13: =I13*(1+$J$8)\r\nK13: =J13*(1+$K$8)\r\nI14: =G14*12\r\nJ14: =I14*(1+$J$8)\r\nK14: =J14*(1+$K$8)\r\nI15: =G15*12\r\nJ15: =I15*(1+$J$8)\r\nK15: =J15*(1+$K$8)\r\nI16: =G16*12\r\nJ16: =I16*(1+$J$8)\r\nK16: =J16*(1+$K$8)\r\nI17: =G17*12\r\nJ17: =I17*(1+$J$8)\r\nK17: =J17*(1+$K$8)\r\nI18: =G18*12\r\nJ18: =I18*(1+$J$8)\r\n"]
[16.786541, "o", "K18: =J18*(1+$K$8)\r\nI19: =G19*12\r\nJ19: =I19*(1+$J$8)\r\nK19: =J19*(1+$K$8)\r\nI20: =G20*12\r\nJ20: =I20*(1+$J$8)\r\nK20: =J20*(1+$K$8)\r\nI21: =G21*12\r\nJ21: =I21*(1+$J$8)\r\nK21: =J21*(1+$K$8)\r\nI22: =G22*12\r\nJ22: =I22*(1+$J$8)\r\nK22: =J22*(1+$K$8)\r\nI23: =G23*12\r\nJ23: =I23*(1+$J$8)\r\nK23: =J23*(1+$K$8)\r\nI24: =G24*12\r\nJ24: =I24*(1+$J$8)\r\nK24: =J24*(1+$K$8)\r\nI25: =G25*12\r\nJ25: =I25*(1+$J$8)\r\nK25: =J25*(1+$K$8)\r\nI26: =G26*12\r\nJ26: =I26*(1+$J$8)\r\nK26: =J26*(1+$K$8)\r\nI27: =G27*12\r\nJ27: =I27*(1+$J$8)\r\nK27: =J27*(1+$K$8)\r\nI28: =G28*12\r\nJ28: =I28*(1+$J$8)\r\nK28: =J28*(1+$K$8)\r\nI29: =G29*12\r\nJ29: =I29*(1+$J$8)\r\nK29: =J29*(1+$K$8)\r\nI30: =G30*12\r\nJ30: =I30*(1+$J$8)\r\nK30: =J30*(1+$K$8)\r\nG31: =SUM(G11:G30)\r\nI31: =SUM(I11:I30)\r\nJ31: =SUM(J11:J30)\r\nK31: =SUM(K11:K30)\r\n"]
[16.786571, "o", "G34: =('1. Required Start-Up Funds'!E9/'1. Required Start-Up Funds'!H9)/12+('1. Required Start-Up Funds'!E10/'1. Required Start-Up Funds'!H10)/12+('1. Required Start-Up Funds'!E11/'1. Required Start-Up Funds'!H11)/12+('1. Required Start-Up Funds'!E12/'1. Required Start-Up Funds'!H12)/12+('1. Required Start-Up Funds'!E13/'1. Required Start-Up Funds'!H13)/12+('1. Required Start-Up Funds'!E14/'1. Required Start-Up Funds'!H14)/12\r\nI34: =G34*12\r\nJ34: =I34\r\nK34: =J34\r\nG36: ='20. Amoritization Schedule'!S15/12\r\nI36: ='20. Amoritization Schedule'!S15\r\nJ36: ='20. Amoritization Schedule'!S19\r\nK36: ='20. Amoritization Schedule'!S23\r\nG37: ='20. Amoritization Schedule'!S35/12\r\nI37: ='20. Amoritization Schedule'!S35\r\nJ37: ='20. Amoritization Schedule'!S39\r\nK37: ='20. Amoritization Schedule'!S43\r\nG38: ='8. Income Statement'!Q62/12\r\nI38: ='8. Income Statement'!Q62\r\nG39: =SUM(G34:G38)\r\nI39: =SUM(I34:I38)\r\nJ39: =SUM(J34:J38)\r\nK39: =SUM(K34:K38)\r\nG41: =G31+G39\r\nI41: =I31+I39\r\nJ41: =J31+J39\r\nK41: =K31+K39\r\n\r\n==== SHEET: 4. Proje"]
[16.786583, "o", "cted Sales Forecast dims A1:T54 max 54,20 visible visible\r\nA1: ='1. Required Start-Up Funds'!A1\r\nT1: =NOW()\r\nF10: =IF(E9>0,E10/E9,0)\r\nE11: =E9-E10\r\nF11: =IF(E9>0,E11/E9,0)\r\nH13: =IF(H14=0,0,H14/$T$14)\r\nI13: =IF(I14=0,0,I14/$T$14)\r\nJ13: =IF(J14=0,0,J14/$T$14)\r\nK13: =IF(K14=0,0,K14/$T$14)\r\nL13: =IF(L14=0,0,L14/$T$14)\r\nM13: =IF(M14=0,0,M14/$T$14)\r\nN13: =IF(N14=0,0,N14/$T$14)\r\nO13: =IF(O14=0,0,O14/$T$14)\r\nP13: =IF(P14=0,0,P14/$T$14)\r\nQ13: =IF(Q14=0,0,Q14/$T$14)\r\nR13: =IF(R14=0,0,R14/$T$14)\r\nS13: =IF(S14=0,0,S14/$T$14)\r\nT13: =SUM(H13:S13)\r\nT14: =SUM(H14:S14)\r\nH15: =IF($E$15=0,H14,(1+$E$15)*H14)\r\nI15: =IF($E$15=0,I14,(1+$E$15)*I14)\r\nJ15: =IF($E$15=0,J14,(1+$E$15)*J14)\r\nK15: =IF($E$15=0,K14,(1+$E$15)*K14)\r\nL15: =IF($E$15=0,L14,(1+$E$15)*L14)\r\nM15: =IF($E$15=0,M14,(1+$E$15)*M14)\r\nN15: =IF($E$15=0,N14,(1+$E$15)*N14)\r\nO15: =IF($E$15=0,O14,(1+$E$15)*O14)\r\nP15: =IF($E$15=0,P14,(1+$E$15)*P14)\r\nQ15: =IF($E$15=0,Q14,(1+$E$15)*Q14)\r\nR15: =IF($E$15=0,R14,(1+$E$15)*R14)\r\nS15: =IF($E$15=0,S14,(1+$E$15)*S14)\r\nT15: =SUM(H15:S15)\r"]
[16.786588, "o", "\nH16: =IF($E$16=0,H15,(1+$E$16)*H15)\r\nI16: =IF($E$16=0,I15,(1+$E$16)*I15)\r\nJ16: =IF($E$16=0,J15,(1+$E$16)*J15)\r\nK16: =IF($E$16=0,K15,(1+$E$16)*K15)\r\nL16: =IF($E$16=0,L15,(1+$E$16)*L15)\r\nM16: =IF($E$16=0,M15,(1+$E$16)*M15)\r\nN16: =IF($E$16=0,N15,(1+$E$16)*N15)\r\nO16: =IF($E$16=0,O15,(1+$E$16)*O15)\r\nP16: =IF($E$16=0,P15,(1+$E$16)*P15)\r\nQ16: =IF($E$16=0,Q15,(1+$E$16)*Q15)\r\nR16: =IF($E$16=0,R15,(1+$E$16)*R15)\r\nS16: =IF($E$16=0,S15,(1+$E$16)*S15)\r\nT16: =SUM(H16:S16)\r\nE19: =T14*E9\r\nE20: =E10*T14\r\nE21: =E19-E20\r\nE22: =E17*'3. Fixed Operating Expenses'!I41\r\nE23: =E21-E22\r\n"]
[16.786606, "o", "F23: =IF(E9>0,E23/E19,0)\r\nE25: =IF(E9>0,E22/F11,0)\r\nE26: =IF(E9>0,E25/E9,0)\r\nF32: =IF(E31>0,E32/E31,0)\r\nE33: =E31-E32\r\nF33: =IF(E31>0,E33/E31,0)\r\nH35: =IF(H36=0,0,H36/$T$36)\r\nI35: =IF(I36=0,0,I36/$T$36)\r\nJ35: =IF(J36=0,0,J36/$T$36)\r\nK35: =IF(K36=0,0,K36/$T$36)\r\nL35: =IF(L36=0,0,L36/$T$36)\r\nM35: =IF(M36=0,0,M36/$T$36)\r\nN35: =IF(N36=0,0,N36/$T$36)\r\nO35: =IF(O36=0,0,O36/$T$36)\r\nP35: =IF(P36=0,0,P36/$T$36)\r\nQ35: =IF(Q36=0,0,Q36/$T$36)\r\nR35: =IF(R36=0,0,R36/$T$36)\r\nS35: =IF(S36=0,0,S36/$T$36)\r\nT35: =SUM(H35:S35)\r\nT36: =SUM(H36:S36)\r\nH37: =IF($E$15=0,H36,(1+$E$37)*H36)\r\nI37: =IF($E$15=0,I36,(1+$E$37)*I36)\r\nJ37: =IF($E$15=0,J36,(1+$E$37)*J36)\r\nK37: =IF($E$15=0,K36,(1+$E$37)*K36)\r\nL37: =IF($E$15=0,L36,(1+$E$37)*L36)\r\n"]

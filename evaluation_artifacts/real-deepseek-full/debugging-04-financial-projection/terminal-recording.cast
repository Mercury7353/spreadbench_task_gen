[154.306835, "i", "python3 - <<'PY' > /workspace/all_anomalies.txt\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\nwb=load_workbook('input.xlsx', data_only=False)\npatterns=['1+','-1*','+1*','*1']\n# broad: print formula cells containing suspicious constant arithmetic or missing = sign? and all unique formulas maybe no.\nfor ws in wb.worksheets:\n    an=[]\n    for row in ws.iter_rows():\n        for c in row:\n            v=c.value\n            if isinstance(v,str) and v.startswith('='):\n                if any(p in v for p in patterns):\n                    an.append((c.coordinate,v))\n    if an:\n        print('SHEET', ws.title)\n        for a in an:\n            print(a[0], ':', a[1])\nPY\nwc -l /workspace/all_anomalies.txt\ncat /workspace/all_anomalies.txt\n"]

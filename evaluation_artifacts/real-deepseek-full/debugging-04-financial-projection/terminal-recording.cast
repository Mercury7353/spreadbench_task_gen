[381.444566, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\ninwb=load_workbook('input.xlsx', data_only=False)\noutwb=load_workbook('/workspace/output.xlsx', data_only=False)\nchanged=0\nfor a in inwb.worksheets:\n    for row in a.iter_rows():\n      for c in row:\n        if c.value is None: continue\n        d=outwb[a.title][c.coordinate]\n        if d.value != c.value:\n          changed+=1\n          print(a.title, c.coordinate, 'OLD', c.value, 'NEW', d.value)\nprint('total changes', changed)\nprint('T37/T38:', outwb['4. Projected Sales Forecast']['T37'].value, outwb['4. Projected Sales Forecast']['T38'].value, outwb['5. Projected Sales Forecast (2)']['T37'].value, outwb['5. Projected Sales Forecast (2)']['T38'].value)\nPY\n"]
[381.446336, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> inwb=load_workbook('input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> outwb=load_workbook('/workspace/output.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> changed=0\r\n\u001b[?2004l\r\u001b[?2004h> for a in inwb.worksheets:\r\n\u001b[?2004l\r\u001b[?2004h>     for row in a.iter_rows():\r\n\u001b[?2004l\r\u001b[?2004h>       for c in row:\r\n\u001b[?2004l\r\u001b[?2004h>         if c.value is None: continue\r\n\u001b[?2004l\r\u001b[?2004h>         d=outwb[a.title][c.coordinate]\r\n\u001b[?2004l\r\u001b[?2004h>         if d.value != c.value:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[381.447751, "o", "          changed+=1\r\n\u001b[?2004l\r\u001b[?2004h>           print(a.title, c.coordinate, 'OLD', c.value, 'NEW', d.value)\r\n\u001b[?2004l\r\u001b[?2004h> print('total changes', changed)\r\n\u001b[?2004l\r\u001b[?2004h> print('T37/T38:', outwb['4. Projected Sales Forecast']['T37'].value, outwb['4. Projected Sales Forecast']['T38'].value, outwb['5. Projected Sales Forecast (2)']['T37'].value, outwb['5. Projected Sales Forecast (2)']['T38'].value)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

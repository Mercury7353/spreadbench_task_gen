[238.561465, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False)\nws=wb['20. Amoritization Schedule']\n# balance rows for loans\nfor prec, mon, y in [('Interest',15),('Principal',16),('Balance',17),('Interest',19),('Principal',20),('Balance',21),('Interest',23),('Principal',24),('Balance',25),('Interest',35),('Principal',36),('Balance',37),('Interest',39),('Principal',40),('Balance',41),('Interest',43),('Principal',44),('Balance',45)]:\n    print('loans row', prec, y)\n    for r in [y]:\n        for col in 'GHIJKLMNOPQR':\n            cell=f'{col}{r}'; v=ws[cell].value\n            if isinstance(v,str) and v.startswith('=') and 'BAL' not in cell.upper():\n                # print for balance rows only\n                if 'Balance' in (str(prec)):\n                    print(cell, v)\nPY\n"]

[28.370995, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\npath='input.xlsx'\nwb=load_workbook(path, data_only=False)\nwv=load_workbook(path, data_only=True)\n# list sheets and target chunks\nfor idx, (ws, vs) in enumerate(zip(wb.worksheets, wv.worksheets), 1):\n    if ws.title in ['1. Required Start-Up Funds','2. Salaries and Wages','3. Fixed Operating Expenses','4. Projected Sales Forecast','5. Projected Sales Forecast (2)','6. Cash Receipts-Disbursements','7. Beginning Balance Sheet','8. Income Statement','9. Cash Flow Statement','10. Balance Sheet']:\n        print('\\n==== SHEET', ws.title, '====')\n        for row in ws.iter_rows():\n            non=[]\n            for c in row:\n                v=c.value\n                if v is not None:\n                    evalue=vs[c.coordinate].value\n                    if evalue is not None:\n                        non.append(f'{c.coordinate}={v!r} @ {evalue!r}')\n                    else:\n                        non.append(f'{c.coordinate}={v!r}')\n            if non:\n               "]
[28.372642, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> path='input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook(path, data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> wv=load_workbook(path, data_only=True)\r\n\u001b[?2004l\r\u001b[?2004h> # list sheets and target chunks\r\n\u001b[?2004l\r\u001b[?2004h> for idx, (ws, vs) in enumerate(zip(wb.worksheets, wv.worksheets), 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]

[363.891723, "o", "\r\nSheet 8. Income Statement changed cells count 7\r\n('J6', \"=-1*('4. Projected Sales Forecast'!M6)\", \"='4. Projected Sales Forecast'!M6\")\r\n('M16', \"=1+('4. Projected Sales Forecast'!$E$10*'4. Projected Sales Forecast'!P14)\", \"='4. Projected Sales Forecast'!$E$10*'4. Projected Sales Forecast'!P14\")\r\n('J17', \"=-1*('4. Projected Sales Forecast'!$E$32*'4. Projected Sales Forecast'!M36)\", \"='4. Projected Sales Forecast'!$E$32*'4. Projected Sales Forecast'!M36\")\r\n"]
[363.891783, "o", "('P18', '=-1*(IF(\\'5. Projected Sales Forecast (2)\\'!$E$10>0,\\'5. Projected Sales Forecast (2)\\'!$E$10*\\'5. Projected Sales Forecast (2)\\'!S14,\"\"))', '=IF(\\'5. Projected Sales Forecast (2)\\'!$E$10>0,\\'5. Projected Sales Forecast (2)\\'!$E$10*\\'5. Projected Sales Forecast (2)\\'!S14,\"\")')\r\n('E40', \"=1+('3. Fixed Operating Expenses'!G17)\", \"='3. Fixed Operating Expenses'!G17\")\r\n('G41', '=1+(F41)', '=F41')\r\n('F47', '=E48', '=E47')\r\n"]
[363.898644, "o", "\r\nSheet 12. Income Statement (2) changed cells count 5\r\n('O11', '=-1*(IF(\\'5. Projected Sales Forecast (2)\\'!$E$9>0,\\'5. Projected Sales Forecast (2)\\'!$E$9*\\'5. Projected Sales Forecast (2)\\'!R15,\"\"))', '=IF(\\'5. Projected Sales Forecast (2)\\'!$E$9>0,\\'5. Projected Sales Forecast (2)\\'!$E$9*\\'5. Projected Sales Forecast (2)\\'!R15,\"\")')\r\n('P26', '=-1*(O26)', '=O26')\r\n('I35', '=1+(H35)', '=H35')\r\n('L48', '=-1*(K48)', '=K48')\r\n('O54', '=1+(SUM(O34:O53))', '=SUM(O34:O53)')\r\n"]
[363.904355, "o", "\r\nSheet 15. Income Statement (3) changed cells count 5\r\n('J22', '=-1*(J13-J20)', '=J13-J20')\r\n('P44', '=1+(O44)', '=O44')\r\n('B49', \"=1+('3. Fixed Operating Expenses'!B26)\", \"='3. Fixed Operating Expenses'!B26\")\r\n('K53', '=1+(J53)', '=J53')\r\n('O66', '=-1*(O22-O31-O54-O64)', '=O22-O31-O54-O64')\r\n"]
[363.906983, "o", "\r\nSheet 17. Balance Sheet (3) changed cells count 1\r\n('I13', \"=IF(F13='7. Beginning Balance Sheet'!F14,'7. Beginning Balance Sheet'!F14,'17. Balance Sheet (3)'!F13-'6. Cash Receipts-Disbursements'!J26)\", \"=IF(F13='7. Beginning Balance Sheet'!F13,'7. Beginning Balance Sheet'!F13,'17. Balance Sheet (3)'!F13-'6. Cash Receipts-Disbursements'!J26)\")\r\n"]
[363.909965, "o", "\r\nSheet 20. Amoritization Schedule changed cells count 8\r\n('O15', '=-1*(ABS(IPMT($E$10/12,9,$E$11,$E$9)))', '=ABS(IPMT($E$10/12,9,$E$11,$E$9))')\r\n('K19', '=-1*(ABS(IPMT($E$10/12,17,$E$11,$E$9)))', '=ABS(IPMT($E$10/12,17,$E$11,$E$9))')\r\n('S19', '=1+(SUM(G19:R19))', '=SUM(G19:R19)')\r\n('J23', '=1+(ABS(IPMT($E$10/12,28,$E$11,$E$9)))', '=ABS(IPMT($E$10/12,28,$E$11,$E$9))')\r\n('H25', '=G26-H24', '=G25-H24')\r\n('N25', '=-1*(M25-N24)', '=M25-N24')\r\n('I36', '=1+(ABS(PPMT($E$30/12,3,$E$31,$E$29)))', '=ABS(PPMT($E$30/12,3,$E$31,$E$29))')\r\n('R45', '=Q46-R44', '=Q45-R44')\r\n"]

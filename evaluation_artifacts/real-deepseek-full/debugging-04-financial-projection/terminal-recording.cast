[10.740026, "o", "7 A7='Remember, no computer can tell whether your projections are truly well-constructed, only a human can do that.'\r\n8 A8='But these tests can at least look for values that are critically out of range.'\r\n"]
[10.740142, "o", "11 A11='Financial Diagnostics', G11='Value', I11='Findings'\r\n12 B12='General Financing Assumptions'\r\n"]
[10.740159, "o", "13 C13=\"Owner's Cash Injection into the Business\", G13=\"=IF('1. Required Start-Up Funds'!G42=0,0,'1. Required Start-Up Funds'!G37/'1. Required Start-Up Funds'!G42)\", I13='=IF(G13>0.2,\"Owner\\'s injection is reasonable\",\"Owner\\'s injection might be too low in relation to the amount of money needed\")'\r\n14 C14='Cash Request as percent of Total Required Funds', G14=\"=IF('1. Required Start-Up Funds'!G31=0,0,'1. Required Start-Up Funds'!E28/'1. Required Start-Up Funds'!G31)\", I14='=IF(G14<0.2,\"Cash request seems reasonable with respect to total request\",\"Cash request exceeds 20% which might be high\")'\r\n16 B16='Loan Assumptions'\r\n"]
[10.740168, "o", "17 C17='Commercial Loan Interest rate', G17=\"='1. Required Start-Up Funds'!H40\", I17='=IF(G17<0.06,\"Interest rate may be too low for the type of loan requested\",\"Interest rate seems reasonable\")'\r\n"]
[10.740185, "o", "18 C18='Commercial Loan Term in Months', G18=\"='1. Required Start-Up Funds'!I40\", I18='=IF(G18>120,\"Loan term may be too high for this type of loan\",\"Loan term seems within range for this type of loan\")'\r\n"]
[10.740214, "o", "20 C20='Commercial Mortgage Interest rate', G20=\"='1. Required Start-Up Funds'!H41\", I20='=IF(G20<0.06,\"Interest rate may be too low for type of loan requested\",\"Interest rate seems reasonable\")'\r\n21 C21='Commercial Mortgage Term in Months', G21=\"='1. Required Start-Up Funds'!I41\", I21='=IF(G21>240,\"Loan term may be too high for this type of loan\",\"Loan term seems within range for this type of loan\")'\r\n"]
[10.740265, "o", "23 C23='Loan Payments as a Percent of Projected Sales', G23=\"=IF('8. Income Statement'!Q13=0,0,'1. Required Start-Up Funds'!J42/'8. Income Statement'!Q13)\", I23='=IF(G23>10,\"Calculated loan payments as a percent of sales may be too high\",\"Calculated loan payments as a percent of sales seem resonable\")'\r\n"]
[10.740275, "o", "25 B25='Income Statement'\r\n"]
[10.74034, "o", "26 C26='Gross Margin as a Percent of Sales', G26=\"='11. Year End Summary'!G22\", I26='=IF(G26<0.2,\"Gross margin percentage seems very low\",\"Gross margin percentage seems reasonable\")'\r\n27 C27=\"Owner's Compensation Lower Limit Check\", G27=\"='2. Salaries and Wages'!M11\", I27='=IF(G27>0,\"An owner\\'s compensation amount has been established\",\"An owner\\'s compensation amount has not been established\")'\r\n"]
[10.740391, "o", "28 C28=\"Owner's Compensation Upper Limit Check\", G28=\"=IF('8. Income Statement'!Q66=0,0,G27/'8. Income Statement'!Q66)\", I28='=IF(G28>1,\"Owner\\'s compensation may be too high relative to profitability of business\",\"Owner\\'s compensation seems reasonable\")'\r\n29 C29='Advertising Expense Levels as a Percent of Sales', G29=\"=IF('8. Income Statement'!Q13=0,0,'8. Income Statement'!Q34/'8. Income Statement'!Q13)\", I29='=IF(G29<0.2,\"Advertising as a percent of sales may be too low\",\"Advertising as a percent of sales seems reasonable\")'\r\n30 C30='Profitability Levels', G30=\"='8. Income Statement'!Q66\", I30='=IF(G30<0,\"The business is not showing a profit\",\"The business is showing a profit\")'\r\n"]
[10.740445, "o", "31 C31='Profitability as a Percent of Sales', G31=\"='11. Year End Summary'!G66\", I31='=IF(G31>0.2,\"The projection may be too aggressive in stating profitability\",\"The projection does not seem highly unreasonable\")'\r\n33 B33='Cash Flow Statement'\r\n"]
[10.740472, "o", "34 C34='Desired Operating cash Flow Levels', G34=\"='9. Cash Flow Statement'!Q35\", I34='=IF(G34>0,\"The financial projection does not provide the desired level of cash flow\",\"The financial projection provides the desired level of cash flow\")'\r\n35 C35='Line of Credit Drawdowns', G35='=G34', I35='=IF(G35>0,\"The business will need at least this level of a line of credit\",\"The business doesn\\'t seem to require a line of credit\")'\r\n"]
[10.740489, "o", "36 C36='Accounts Receivable Ratio to Sales', G36=\"=IF('8. Income Statement'!Q13=0,0,'10. Balance Sheet'!I11/'8. Income Statement'!Q13)\", I36='=IF(G36>0.3,\"Accounts receivable amounts seem high\",\"Accounts receivable amount as a percent of sales seems reasonable\")'\r\n"]
[10.740513, "o", "38 B38='Balance Sheet'\r\n39 C39='Does the Base Period Balance Sheet Balance?', G39=\"='10. Balance Sheet'!F29-'10. Balance Sheet'!F47\", I39='=IF(G39<>0,\"The balance sheet is not in balance\",\"The balance sheet does balance\")'\r\n"]
[10.740558, "o", "40 C40='Does the Final Balance Sheet Balance', G40=\"='10. Balance Sheet'!I29-'10. Balance Sheet'!I47\", I40='=IF(G40<>0,\"The balance sheet is not in balance\",\"The balance sheet does balance\")'\r\n41 C41='Debt to Equity Ratio', G41=\"=IF('10. Balance Sheet'!I45=0,0,'10. Balance Sheet'!I39/'10. Balance Sheet'!I45)\", I41='=IF(G41>5,\"Most banks would consider there to be too much debt for the overall amount of equity or ownership\",\"The debt to equity ratio seems reasonable\")'\r\n"]
[10.740598, "o", "43 B43='Breakeven Analysis'\r\n44 C44='Breakeven Levels', G44=\"='8. Income Statement'!Q13-'19. Breakeven Analysis'!G18\", I44='=IF(G44>0,\"The sales projection exceeds the projected break-even sales level\",\"The sales projection is less than the break-even amount\")'\r\n"]

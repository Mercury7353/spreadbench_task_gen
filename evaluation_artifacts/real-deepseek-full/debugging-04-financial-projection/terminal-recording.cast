[370.153981, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\npath='/workspace/output.xlsx'\nwb=load_workbook(path, data_only=False)\nfor sheet in ['4. Projected Sales Forecast','5. Projected Sales Forecast (2)']:\n    wb[sheet]['T37'] = '=SUM(H37:S37)'\n    wb[sheet]['T38'] = '=SUM(H38:S38)'\nwb.save(path)\nprint('restored T37/T38 totals')\nPY\nmkdir -p /workspace/recalc2\nrm -rf /workspace/recalc2/*\nlibreoffice --headless --convert-to xlsx --outdir /workspace/recalc2 /workspace/output.xlsx >/dev/null\npython3 - <<'PY'\nfrom openpyxl import load_workbook\nwbv=load_workbook('/workspace/recalc2/output.xlsx', data_only=True)\nfor sh in ['10. Balance Sheet','14. Balance Sheet (2)','17. Balance Sheet (3)']:\n    ws=wbv[sh]\n    print(sh, ws['F50'].value, ws['I50'].value)\nprint('errors:', sum(1 for ws in wbv.worksheets for row in ws.iter_rows() for c in row if isinstance(c.value,str) and c.value.startswith('#') and c.value not in ['#','##']))\nPY\n"]

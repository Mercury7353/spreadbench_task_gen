[278.969821, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False)\n# Print formulas with growth conditions for product B in sheet4 and product D in sheet5\nfor sheet, rows in [('4. Projected Sales Forecast', [37,38]), ('5. Projected Sales Forecast (2)', [37,38])]:\n    ws=wb[sheet]\n    print('SHEET', sheet)\n    for r in rows:\n        for col in 'HIS':\n            print(f'{col}{r}', ws[f'{col}{r}'].value)\nPY\n"]

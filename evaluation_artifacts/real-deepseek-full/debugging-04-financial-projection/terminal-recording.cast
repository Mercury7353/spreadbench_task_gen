[125.708539, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nimport re\nwb=load_workbook('input.xlsx', data_only=False)\nws=wb['8. Income Statement']\nfor row in ws.iter_rows(min_row=1, max_row=ws.max_row):\n    form={}\n    for c in row:\n        if isinstance(c.value,str) and c.value.startswith('='):\n            form[c.column_letter]=c.value\n    if not form: continue\n    # For each cell in E-P, parse references to external sheet and row\n    # Simpler: flag if same 'operand expression' has a numeric constant 1 with sign multiply/add, and if source row in formula differs from E cell source row\n    def refs(v):\n        # return set of sheet:columnrow matches\n        out=set()\n        for m in re.findall(r\"(?:'[^']*'|\\w+)!(\\$?[A-Z]+)(\\$?\\d+)\", v):\n            out.add((m[0].replace('$',''), int(m[1].replace('$',''))))\n        # also local refs like F41\n        for m in re.findall(r\"(^|[^A-Z])(\\$?[A-Z]{1,2})(\\$?\\d+)\", v):\n            col=m[2]; ro=m[3]\n            if re.fullmatch(r'[A-Z]{1,2}', col) and m[2].isalpha() and m[3].i"]

[319.892721, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwbv=load_workbook('/workspace/recalc/output.xlsx', data_only=True)\nfor sh in ['10. Balance Sheet','14. Balance Sheet (2)','17. Balance Sheet (3)']:\n    ws=wbv[sh]\n    print(sh, 'F50=', ws['F50'].value, 'I50=', ws['I50'].value, 'F29=', ws['F29'].value, 'F47=', ws['F47'].value, 'I29=', ws['I29'].value, 'I47=', ws['I47'].value)\nws=wbv['21. Financial Diagnostics']\nfor r in range(13,45):\n    vals=[ws.cell(row=r,column=c).value for c in [7,9]]\n    if any(v is not None for v in vals): print('Diag',r, vals)\n# search for error values\ncnt=0\nfor ws in wbv.worksheets:\n  for row in ws.iter_rows():\n    for c in row:\n      if isinstance(c.value,str) and c.value.startswith('#') and c.value not in ['#','##']:\n        print('ERR', ws.title, c.coordinate, c.value)\n        cnt+=1\n        if cnt>50: break\n    if cnt>50: break\n  if cnt>50: break\nprint('errors', cnt)\nPY\n"]

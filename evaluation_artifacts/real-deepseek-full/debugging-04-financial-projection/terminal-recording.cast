[279.197965, "o", "SHEET 4. Projected Sales Forecast\r\nH37 =IF($E$15=0,H36,(1+$E$37)*H36)\r\nI37 =IF($E$15=0,I36,(1+$E$37)*I36)\r\nS37 =IF($E$15=0,S36,(1+$E$37)*S36)\r\nH38 =IF($E$16=0,H37,(1+$E$38)*H37)\r\nI38 =IF($E$16=0,I37,(1+$E$38)*I37)\r\nS38 =IF($E$16=0,S37,(1+$E$38)*S37)\r\nSHEET 5. Projected Sales Forecast (2)\r\nH37 =IF($E$15=0,H36,(1+$E$37)*H36)\r\nI37 =IF($E$15=0,I36,(1+$E$37)*I36)\r\nS37 =IF($E$15=0,S36,(1+$E$37)*S36)\r\nH38 =IF($E$16=0,H37,(1+$E$38)*H37)\r\nI38 =IF($E$16=0,I37,(1+$E$38)*I37)\r\nS38 =IF($E$16=0,S37,(1+$E$38)*S37)\r\n"]

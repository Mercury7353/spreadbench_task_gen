[10.541825, "i", "python3 - <<'PY'\nimport openpyxl\npath='input.xlsx'\nwb=openpyxl.load_workbook(path, data_only=False)\nprint('Sheets:', wb.sheetnames)\nfor ws in wb.worksheets:\n    print('\\n==== SHEET:', ws.title, 'dims', ws.dimensions, 'max', ws.max_row, ws.max_column, 'state', ws.sheet_state)\n    for row in ws.iter_rows():\n        vals=[]\n        for c in row:\n            if c.value is not None:\n                vals.append(f'{c.coordinate}={c.value!r}')\n        if vals:\n            print(row[0].row, ', '.join(vals))\nPY\n"]
[10.542376, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> path='input.xlsx'\r\n\u001b[?2004l\r\u001b[?2004h> wb=openpyxl.load_workbook(path, data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('Sheets:', wb.sheetnames)\r\n\u001b[?2004l\r"]

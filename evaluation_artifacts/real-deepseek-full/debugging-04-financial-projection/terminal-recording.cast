[113.869422, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\nwb=load_workbook('input.xlsx', data_only=False)\nws=wb['8. Income Statement']\n# Print row 1-40 abbreviated formula cells with missing S for readability, one row per line via list to temp\nfor r in range(1, 56):\n    cells=[]\n    for row in ws.iter_rows(min_row=r, max_row=r, min_col=1, max_col=18):\n        for c in row:\n            if c.value is not None:\n                cells.append(f'{c.coordinate}:{str(c.value)}')\n    print('\\nROW', r, '\\n', '\\n'.join(cells))\nPY\n"]
[113.871525, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl import load_workbook\r\n\u001b[?2004l\r\u001b[?2004h> from openpyxl.utils import get_column_letter\r\n\u001b[?2004l\r\u001b[?2004h> wb=load_workbook('input.xlsx', data_only=False)\r\n\u001b[?2004l\r\u001b[?2004h> ws=wb['8. Income Statement']\r\n\u001b[?2004l\r\u001b[?2004h> # Print row 1-40 abbreviated formula cells with missing S for readability, one row per line via list to temp\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(1, 56):\r\n\u001b[?2004l\r\u001b[?2004h>     cells=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for row in ws.iter_rows(min_row=r, max_row=r, min_col=1, max_col=18):\r\n\u001b[?2004l\r\u001b[?2004h>         for c in row:\r\n\u001b[?2004l\r\u001b[?2004h>             if c.value is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 cells.append(f'{c.coordinate}:{str(c.value)}')\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\nROW', r, '\\n', '\\n'.join(cells))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]

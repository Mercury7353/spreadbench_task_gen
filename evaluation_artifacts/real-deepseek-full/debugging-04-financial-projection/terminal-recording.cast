[16.601304, "i", "python3 - <<'PY'\nimport openpyxl, os\npath='input.xlsx'\nwb=openpyxl.load_workbook(path, data_only=False)\nwith open('/workspace/formulas.txt','w') as f:\n    for ws in wb.worksheets:\n        f.write('\\n==== SHEET: '+ws.title+' dims '+ws.dimensions+' max '+str(ws.max_row)+','+str(ws.max_column)+' visible '+str(ws.sheet_state)+'\\n')\n        for row in ws.iter_rows():\n            for c in row:\n                if isinstance(c.value, str) and c.value.startswith('='):\n                    f.write(f'{c.coordinate}: {c.value}\\n')\nprint('formulas count lines', sum(1 for _ in open('/workspace/formulas.txt')))\nPY\nwc -l /workspace/formulas.txt\nsed -n '1,260p' /workspace/formulas.txt\n"]

[101.386657, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\nwb=load_workbook('input.xlsx', data_only=False)\nws=wb['8. Income Statement']\nfor row in ws.iter_rows(min_row=1, max_row=100):\n    for c in row:\n        v=c.value\n        if isinstance(v,str) and v.startswith('='):\n            # print if hardcoded +/-1 or formulas outer refs maybe not simple shift\n            if '+1' in v or '-1' in v or '*1' in v or '1+' in v or '1-' in v:\n                print(c.coordinate, v)\nPY\ngrep -n '=1+\\|=1-\\|+1\\|-1\\|E48\\|E47\\|E49' /workspace/concise8.txt | head -100\n"]

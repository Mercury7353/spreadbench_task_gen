[355.597779, "i", "python3 - <<'PY' > /workspace/localrefs.txt\nfrom openpyxl import load_workbook\nimport re\nwb=load_workbook('/workspace/output.xlsx', data_only=False)\nfor title in ['8. Income Statement','12. Income Statement (2)','15. Income Statement (3)','9. Cash Flow Statement','13. Cash Flow Statement (2)','16. Cash Flow Statement (3)','10. Balance Sheet','14. Balance Sheet (2)','17. Balance Sheet (3)']:\n    ws=wb[title]\n    suspicious=[]\n    for row in ws.iter_rows(min_row=1, max_row=ws.max_row):\n        r=row[0].row\n        for c in row:\n            v=c.value\n            if not (isinstance(v,str) and v.startswith('=')): continue\n            refs=re.findall(r'(^|[^A-Z])([A-Z]{1,2})(\\d+)', v)\n            for pre, col, rr in refs:\n                if int(rr) != r:\n                    suspicious.append((c.coordinate, v, (col,rr)))\n    if suspicious:\n        print('\\nSHEET', title, 'count', len(suspicious))\n        for x in suspicious[:80]: print(x)\nPY\nsed -n '1,240p' /workspace/localrefs.txt\n"]

[175.662597, "i", "python3 - <<'PY' > /workspace/all_obvious.txt\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False)\nfor ws in wb.worksheets:\n    for row in ws.iter_rows():\n        for c in row:\n            v=c.value\n            if isinstance(v,str) and v.startswith('='):\n                s=v.replace(' ','').upper()\n                # Skip normal growth formulas with 1+$E$ or 1+E#\n                if '1+$E$' in s or '1+($E$' in s or '1+E$' in s:\n                    continue\n                if '=1+(F' in s or '=1+(' in s or '=-1*(' in s or '=+1*' in s:\n                    print(ws.title, c.coordinate, v)\nPY\ncat /workspace/all_obvious.txt\n"]

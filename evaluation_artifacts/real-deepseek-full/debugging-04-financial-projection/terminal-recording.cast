[363.634485, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\ninwb=load_workbook('input.xlsx', data_only=False)\noutwb=load_workbook('/workspace/output.xlsx', data_only=False)\nprint('Sheets same:', inwb.sheetnames == outwb.sheetnames)\nfor a,b in zip(inwb.worksheets, outwb.worksheets):\n    if a.title != b.title: continue\n    diffs=[]\n    for row in a.iter_rows():\n      for c in row:\n        if c.value is None: continue\n        d=outwb[a.title][c.coordinate]\n        if d.value != c.value:\n          diffs.append((c.coordinate,c.value,d.value))\n    if diffs:\n      print('\\nSheet', a.title, 'changed cells count', len(diffs))\n      for x in diffs[:200]: print(x)\nPY\n"]

[154.51273, "o", "SHEET 1. Required Start-Up Funds\r\nI40 : =7*12\r\nI41 : =20*12\r\nSHEET 2. Salaries and Wages\r\nM11 : =K11*12\r\nN11 : =M11*(1+$N$8)\r\nO11 : =N11*(1+$O$8)\r\nM12 : =K12*12\r\nN12 : =M12*(1+$N$8)\r\nO12 : =N12*(1+$O$8)\r\nN14 : =M14*(1+$N$8)\r\nO14 : =N14*(1+$O$8)\r\nN17 : =M17*(1+$N$8)\r\nO17 : =N17*(1+$O$8)\r\nM20 : =K20*12\r\nN20 : =M20*(1+$N$8)\r\nO20 : =N20*(1+$O$8)\r\nM26 : =K26*12\r\nM27 : =K27*12\r\nM28 : =K28*12\r\nM29 : =K29*12\r\nN29 : =M29*(1+N8)\r\nO29 : =N29*(1+O8)\r\nM30 : =K30*12\r\nN30 : =M30*(1+N8)\r\nO30 : =N30*(1+O8)\r\nM31 : =K31*12\r\nN31 : =M31*(1+N8)\r\nO31 : =N31*(1+O8)\r\nK35 : =K21+K32\r\nM35 : =M21+M32\r\nN35 : =N21+N32\r\nO35 : =O21+O32\r\nSHEET 3. Fixed Operating Expenses\r\nI11 : =G11*12\r\nJ11 : =I11*(1+$J$8)\r\nK11 : =J11*(1+$K$8)\r\nI12 : =G12*12\r\nJ12 : =I12*(1+$J$8)\r\nK12 : =J12*(1+$K$8)\r\nI13 : =G13*12\r\nJ13 : =I13*(1+$J$8)\r\nK13 : =J13*(1+$K$8)\r\nI14 : =G14*12\r\nJ14 : =I14*(1+$J$8)\r\nK14 : =J14*(1+$K$8)\r\nI15 : =G15*12\r\nJ15 : =I15*(1+$J$8)\r\nK15 : =J15*(1+$K$8)\r\nI16 : =G16*12\r\nJ16 : =I16*(1+$J$8)\r\nK16 : =J16*(1+$K$8)\r\nI17 : =G17*12\r\nJ17 : =I17*(1+$J$8)"]

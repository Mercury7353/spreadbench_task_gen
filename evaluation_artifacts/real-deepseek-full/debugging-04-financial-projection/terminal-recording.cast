[94.017474, "i", "python3 - <<'PY' > /workspace/concise8.txt\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False, read_only=True)\nws=wb['8. Income Statement']\nfor row in ws.iter_rows():\n    parts=[]\n    for c in row:\n        if c.value is not None:\n            parts.append(c.coordinate+'='+str(c.value))\n    if parts:\n        print('||'.join(parts))\nPY\nwc -l /workspace/concise8.txt\nsed -n '1,12p' /workspace/concise8.txt\n"]
[94.018047, "o", "python3 - <<'PY' > /workspace/concise8.txt\r\n\u001b[?2004l\r"]

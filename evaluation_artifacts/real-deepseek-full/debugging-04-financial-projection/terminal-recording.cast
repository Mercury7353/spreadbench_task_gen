[295.32374, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\npath='input.xlsx'\nwb=load_workbook(path, data_only=False)\n# Utility\n\ndef setf(sheet, cell, formula):\n    ws=wb[sheet]\n    ws[cell] = formula\n\n# Sheet 8 Income Statement: remove spurious 1 or -1 wrappers and repair F47\nrep8 = {\n    'J6': \"='4. Projected Sales Forecast'!M6\",\n    'M16': \"='4. Projected Sales Forecast'!$E$10*'4. Projected Sales Forecast'!P14\",\n    'J17': \"='4. Projected Sales Forecast'!$E$32*'4. Projected Sales Forecast'!M36\",\n    'P18': \"=IF('5. Projected Sales Forecast (2)'!$E$10>0,'5. Projected Sales Forecast (2)'!$E$10*'5. Projected Sales Forecast (2)'!S14,\\\"\\\")\",\n    'E40': \"='3. Fixed Operating Expenses'!G17\",\n    'G41': \"=F41\",\n    'F47': \"=E47\",\n}\nfor cell, f in rep8.items(): setf('8. Income Statement', cell, f)\n\n# Sheet 12 Income Statement (2)\nrep12 = {\n    'O11': \"=IF('5. Projected Sales Forecast (2)'!$E$9>0,'5. Projected Sales Forecast (2)'!$E$9*'5. Projected Sales Forecast (2)'!R15,\\\"\\\")\",\n    'P26': \"=O26\",\n    'I35': \"=H35\",\n    'L"]
[295.324646, "i", "48': \"=K48\",\n    'O54': \"=SUM(O34:O53)\",\n}\nfor cell, f in rep12.items(): setf('12. Income Statement (2)', cell, f)\n\n# Sheet 15 Income Statement (3)\nrep15 = {\n    'J22': \"=J13-J20\",\n    'P44': \"=O44\",\n    'B49': \"='3. Fixed Operating Expenses'!B26\",\n    'K53': \"=J53\",\n    'O66': \"=O22-O31-O54-O64\",\n}\nfor cell, f in rep15.items(): setf('15. Income Statement (3)', cell, f)\n\n# Sheet 4/5 growth condition refs for product B/D\nfor sheet in ['4. Projected Sales Forecast', '5. Projected Sales Forecast (2)']:\n    ws=wb[sheet]\n    for col in 'HIJKLMNOPQRST':\n        # Year Two product B/D row 37: condition should use E37\n        ws[f'{col}37'] = f'=IF($E$37=0,{col}36,(1+$E$37)*{col}36)'\n        # Year Three product B/D row 38: condition should use E38\n        ws[f'{col}38'] = f'=IF($E$38=0,{col}37,(1+$E$38)*{col}37)'\n\n# Sheet 20 Amortization schedule\nrep20 = {\n    'O15': \"=ABS(IPMT($E$10/12,9,$E$11,$E$9))\",\n    'K19': \"=ABS(IPMT($E$10/12,17,$E$11,$E$9))\",\n    'S19': \"=SUM(G19:R19)\",\n    'J23': \"=ABS(IPMT($E$10/12,28,$E$"]
[295.325551, "i", "11,$E$9))\",\n    'H25': \"=G25-H24\",\n    'N25': \"=M25-N24\",\n    'I36': \"=ABS(PPMT($E$30/12,3,$E$31,$E$29))\",\n    'R45': \"=Q45-R44\",\n}\nfor cell, f in rep20.items(): setf('20. Amoritization Schedule', cell, f)\n\n# Sheet 17 Balance Sheet (3): I13 should use Beginning F13 not F14\nsetf('17. Balance Sheet (3)', 'I13', \"=IF(F13='7. Beginning Balance Sheet'!F13,'7. Beginning Balance Sheet'!F13,'17. Balance Sheet (3)'!F13-'6. Cash Receipts-Disbursements'!J26)\")\n\nwb.save('/workspace/output.xlsx')\nprint('saved output.xlsx')\nPY\n"]

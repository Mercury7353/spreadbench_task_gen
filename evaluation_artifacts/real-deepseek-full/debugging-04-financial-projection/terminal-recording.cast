[132.812548, "i", "python3 - <<'PY' > /workspace/anom8.txt\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\nwb=load_workbook('input.xlsx', data_only=False)\nws=wb['8. Income Statement']\n# Print formula source row for rows 6-19 and 34-53\nfor r in list(range(6,20))+list(range(34,54)):\n    vals=[]\n    for col in 'EFGHIJKLMNOPQ':\n        v=ws[f'{col}{r}'].value\n        if isinstance(v,str) and v.startswith('='):\n            vals.append(f'{col}={v}')\n        elif v is not None:\n            vals.append(f'{col}={v}')\n    print(r, ' | '.join(vals)[:3000])\n# print all cells with 1+, -1*, F47 etc\nfor r in range(1, ws.max_row+1):\n  for col in ws.iter_cols(min_row=r,max_row=r,min_col=1,max_col=18):\n    for c in col:\n      v=c.value\n      if isinstance(v,str) and v.startswith('='):\n        if '+1' in v or '-1*' in v or '1+(' in v or c.coordinate in ['J6','M16','J17','P18','E40','G41','F47']:\n          print('ANOM', c.coordinate, v)\nPY\ncat /workspace/anom8.txt\n"]

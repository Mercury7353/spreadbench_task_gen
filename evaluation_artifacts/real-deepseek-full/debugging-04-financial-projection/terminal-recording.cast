[87.776151, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nfrom openpyxl.utils import get_column_letter\nwb=load_workbook('input.xlsx', data_only=False, read_only=True)\nws=wb['8. Income Statement']\nfor r in range(1,60):\n    vals=[]\n    for row in ws.iter_rows(min_row=r, max_row=r):\n        for c in row:\n            if c.value is not None:\n                vals.append(c.coordinate+':'+str(c.value)[:200])\n    if vals:\n        print(r, ' | '.join(vals))\nPY\n"]

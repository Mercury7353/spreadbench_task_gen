[337.5844, "i", "python3 - <<'PY'\nfrom openpyxl import load_workbook\nwb=load_workbook('/workspace/output.xlsx', data_only=False)\n# Flag cells in output with formula wrappers that look bad\nobv=[]\nfor ws in wb.worksheets:\n  for row in ws.iter_rows():\n    for c in row:\n      v=c.value\n      if isinstance(v,str) and v.startswith('='):\n        s=v.replace(' ','').upper()\n        if '1+$E$' not in s and '1+($E$' not in s and '1+E$' not in s:\n          if '=1+(F' in s or '=1+(' in s or '=-1*(' in s or '=+1*' in s:\n            obv.append((ws.title,c.coordinate,v))\nprint('bad wrappers after repair:', obv)\n# Print suspected row offset patterns in amortization and income statement: formulas where same-row cell references next row local/current row wrong\n# Amortization balance rows should reference same row previous col and principal row same col\nws20=wb['20. Amoritization Schedule']\nfor r in [17,21,25,37,41,45]:\n  errs=[]\n  for k,col in enumerate('GHIJKLMNOPQR', start=1):\n    v=ws20[f'{col}{r}'].value\n    if isinstance(v,str) and v.star"]

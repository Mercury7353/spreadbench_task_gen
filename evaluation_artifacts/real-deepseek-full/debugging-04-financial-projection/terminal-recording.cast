[186.20844, "i", "python3 - <<'PY' > /workspace/groups_diff.txt\nfrom openpyxl import load_workbook\nwb=load_workbook('input.xlsx', data_only=False)\n# map title base groups\npairs=[]\ngroups=[('8. Income Statement','12. Income Statement (2)','15. Income Statement (3)'),('9. Cash Flow Statement','13. Cash Flow Statement (2)','16. Cash Flow Statement (3)'),('10. Balance Sheet','14. Balance Sheet (2)','17. Balance Sheet (3)')]\ndef coord_loc(c):\n    import re\n    m=re.match(r'([A-Z]+)(\\d+)', c)\n    return (m.group(1), int(m.group(2)))\ndef formula_map(ws):\n    d={}\n    for row in ws.iter_rows():\n        for c in row:\n            if c.value is not None:\n                d[c.coordinate]=(c.value, c.data_type)\n    return d\nfor base, s2, s3 in groups:\n    ws=wb[base]; w2=wb[s2]; w3=wb[s3]\n    dm1=formula_map(ws); dm2=formula_map(w2); dm3=formula_map(w3)\n    for coord in sorted(set(dm1)|set(dm2)|set(dm3), key=lambda s: (__import__('re').match(r'([A-Z]+)(\\d+)',s).group(2), __import__('re').match(r'([A-Z]+)(\\d+)',s).group(1))):\n        vals={b"]
[186.208478, "i", "ase:dm1.get(coord), s2:dm2.get(coord), s3:dm3.get(coord)}\n        if vals[base]!=vals[s2] or vals[base]!=vals[s3] or vals[s2]!=vals[s3]:\n            # skip if non-formula/number changes perhaps only differences\n            print(coord, '|', base, '=', vals[base], '|', s2, '=', vals[s2], '|', s3, '=', vals[s3])\nPY\ncat /workspace/groups_diff.txt\n"]
